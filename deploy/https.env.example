# Copy these values into the repository's .env file on the production host.
SYZOJ_WEB_BIND=127.0.0.1
SYZOJ_WEB_PORT=8080
SYZOJ_SECURE_COOKIES=true
SYZOJ_PUBLIC_URL=https://oj.example.edu
# Required database credentials (generate independently and keep this file private).
SYZOJ_DB_PASSWORD=replace-with-a-long-random-password
SYZOJ_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
