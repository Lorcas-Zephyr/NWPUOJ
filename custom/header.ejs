<% include util %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta content="IE=edge" http-equiv="X-UA-Compatible">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <meta name="application-name" content="NWPUOJ">
    <meta property="og:site_name" content="NWPUOJ">
    <title><%= title %> - <%= syzoj.config.title %></title>
    <link rel="icon" type="image/png" href="/self/favicon.png?v=<%= encodeURIComponent(syzoj.config.nwpuoj_version || '1.0.0') %>">
    <link rel="shortcut icon" type="image/png" href="/self/favicon.png?v=<%= encodeURIComponent(syzoj.config.nwpuoj_version || '1.0.0') %>">
    <link rel="apple-touch-icon" href="/self/favicon.png?v=<%= encodeURIComponent(syzoj.config.nwpuoj_version || '1.0.0') %>">
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5S5PF5SMBP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5S5PF5SMBP');
    </script>
    <link href="<%- lib('semantic-ui/2.4.1/semantic.min.css') %>" rel="stylesheet">
    <link href="<%- selfLib('syntect-tomorrow.css') %>?20220512" rel="stylesheet">
    <link href="/self/username_tiers.css?v=<%= encodeURIComponent(syzoj.config.nwpuoj_version || '1.0.0') %>" rel="stylesheet">
    <link href="<%- selfLib('style.css') %>?20181212" rel="stylesheet">
    <link href="<%- lib('morris.js/0.5.1/morris.css') %>" rel="stylesheet">
    <link href="/self/ui-system.css?v=<%= encodeURIComponent(syzoj.config.nwpuoj_version || '1.0.0') %>" rel="stylesheet">
    <link href="/self/sidebar.css?v=<%= encodeURIComponent(syzoj.config.nwpuoj_version || '1.0.0') %>" rel="stylesheet">
    <link href="/self/mobile.css?v=<%= encodeURIComponent(syzoj.config.nwpuoj_version || '1.0.0') %>" rel="stylesheet">
    <script>
    (function () {
      document.documentElement.setAttribute('data-nwpuoj-sidebar-initializing', 'true');
      try {
        if (window.innerWidth > 768 && localStorage.getItem('nwpuoj_sidebar_collapsed') === 'true') {
          document.documentElement.setAttribute('data-nwpuoj-sidebar-collapsed', 'true');
        }
      } catch (error) {}
    })();
    </script>
    <% if (!user || !(user.is_admin || (user.privileges && user.privileges.includes('manage_problem')))) { %>
      <style>#add_problem_dropdown { display: none !important; }</style>
    <% } %>
    <% if (useLocalLibs || !syzoj.config.google_fonts || !['like-google-fonts', 'like-local', 'built-in'].includes(syzoj.config.google_fonts.type)) { %>
      <link href="<%- syzoj.utils.makeUrl(['google-fonts', 'fira-mono.css']) %>" rel="stylesheet">
      <link href="<%- syzoj.utils.makeUrl(['google-fonts', 'lato.css']) %>" rel="stylesheet">
      <link href="<%- syzoj.utils.makeUrl(['google-fonts', 'open-sans.css']) %>" rel="stylesheet">
      <link href="<%- syzoj.utils.makeUrl(['google-fonts', 'exo-2.css']) %>" rel="stylesheet">
    <% } else if (syzoj.config.google_fonts.type === 'like-local') { %>
      <link href="<%- syzoj.config.google_fonts.url %>/google-fonts/fira-mono.css" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/google-fonts/lato.css" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/google-fonts/open-sans.css" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/google-fonts/exo-2.css" rel="stylesheet">
    <% } else if (syzoj.config.google_fonts.type === 'like-google-fonts') { %>
      <link href="<%- syzoj.config.google_fonts.url %>/css?family=Fira+Mono" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/css?family=Lato:400,700,400italic,700italic&subset=latin" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i,800,800i&amp;subset=latin-ext" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/css?family=Exo+2:600" rel="stylesheet">
    <% } else if (syzoj.config.google_fonts.type === 'built-in') { %>
      <link href="<%- this.builtInCdnUrl %>/google-fonts/fira-mono.css" rel="stylesheet">
      <link href="<%- this.builtInCdnUrl %>/google-fonts/lato.css" rel="stylesheet">
      <link href="<%- this.builtInCdnUrl %>/google-fonts/open-sans.css" rel="stylesheet">
      <link href="<%- this.builtInCdnUrl %>/google-fonts/exo-2.css" rel="stylesheet">
    <% } %>
    <script data-cfasync="false" src="<%- lib('jquery/3.3.1/jquery.min.js') %>"></script>
    <script>
    (function () {
      var token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
      function sameOrigin(url) {
        try { return new URL(url || location.href, location.href).origin === location.origin; }
        catch (error) { return false; }
      }
      function protectForm(form) {
        if (!token || String(form.method || 'get').toLowerCase() === 'get' || !sameOrigin(form.action)) return;
        var input = form.querySelector('input[name="_csrf"]');
        if (!input) {
          input = document.createElement('input');
          input.type = 'hidden';
          input.name = '_csrf';
          form.appendChild(input);
        }
        input.value = token;
      }
      document.addEventListener('DOMContentLoaded', function () {
        Array.prototype.forEach.call(document.forms, protectForm);
      });
      document.addEventListener('submit', function (event) { protectForm(event.target); }, true);

      if (window.jQuery) {
        window.jQuery.ajaxPrefilter(function (options, originalOptions, xhr) {
          if (token && sameOrigin(options.url) && !/^(GET|HEAD|OPTIONS)$/i.test(options.type || 'GET')) {
            xhr.setRequestHeader('X-CSRF-Token', token);
          }
        });
      }
      if (window.fetch) {
        var originalFetch = window.fetch;
        window.fetch = function (input, options) {
          var requestOptions = Object.assign({}, options || {});
          var url = typeof input === 'string' ? input : input.url;
          var method = String(requestOptions.method || (typeof input !== 'string' && input.method) || 'GET').toUpperCase();
          if (token && sameOrigin(url) && !/^(GET|HEAD|OPTIONS)$/.test(method)) {
            var headers = new Headers(requestOptions.headers || (typeof input !== 'string' ? input.headers : undefined));
            headers.set('X-CSRF-Token', token);
            requestOptions.headers = headers;
          }
          return originalFetch.call(window, input, requestOptions);
        };
      }
    })();
    </script>
    <%
    // ============ 用户名颜色 tier 注入 ============
    let _tierMap;
    function _calcTier(userId, isAdminUser) {
        if (isAdminUser) return 'admin';
        if (syzoj.adminUserIds && syzoj.adminUserIds.has(userId)) return 'admin';
        if (syzoj.userHitScores && syzoj.userHitScores.has(userId)) {
            let s = syzoj.userHitScores.get(userId);
            let h = s.total || 0;
            if (h >= 350) return 'red';
            if (h >= 280) return 'orange';
            if (h >= 200) return 'green';
            if (h >= 100) return 'blue';
            return 'gray';
        }
        return 'default';
    }
    if (syzoj.clientUserTierMapHitSource !== syzoj.userHitScores ||
        syzoj.clientUserTierMapAdminSource !== syzoj.adminUserIds) {
        syzoj.clientUserTierMap = {};
        if (syzoj.adminUserIds) {
            for (let uid of syzoj.adminUserIds) syzoj.clientUserTierMap[uid] = 'admin';
        }
        if (syzoj.userHitScores) {
            for (let [uid, scoreData] of syzoj.userHitScores) {
                if (syzoj.clientUserTierMap[uid] === 'admin') continue;
                let t = _calcTier(uid, false);
                if (t !== 'default' && t !== 'gray') syzoj.clientUserTierMap[uid] = t;
            }
        }
        syzoj.clientUserTierMapHitSource = syzoj.userHitScores;
        syzoj.clientUserTierMapAdminSource = syzoj.adminUserIds;
    }
    _tierMap = syzoj.clientUserTierMap || {};
    let _cheatedIds = [];
    let _cancelledIds = [];
    let _cheaterUids = [];
    if (typeof info !== 'undefined' && info && info.submissionId) {
      if (syzoj.cheatedJudgeIds && syzoj.cheatedJudgeIds.has(info.submissionId)) _cheatedIds.push(info.submissionId);
      if (syzoj.cancelledJudgeIds && syzoj.cancelledJudgeIds.has(info.submissionId)) _cancelledIds.push(info.submissionId);
    }
    if (syzoj.cheaterUserIds) for (let id of syzoj.cheaterUserIds) _cheaterUids.push(id);
    let _userTagsObj = {};
    if (syzoj.userTagsEnabled !== false && syzoj.userTags) {
      for (let [uid, info] of syzoj.userTags) {
        _userTagsObj[uid] = { text: info.text, tier: info.tier };
      }
    }
    %>
    <script>
    window.__SYZOJ_USER_TIERS = <%- serializejs(_tierMap) %>;
    window.__SYZOJ_CHEATED_JUDGE_IDS = <%- serializejs(_cheatedIds) %>;
    window.__SYZOJ_CANCELLED_JUDGE_IDS = <%- serializejs(_cancelledIds) %>;
    window.__SYZOJ_CHEATER_USER_IDS = <%- serializejs(_cheaterUids) %>;
    window.__SYZOJ_USER_TAGS = <%- serializejs(_userTagsObj) %>;
    </script>
</head>
<body class="nwpuoj-sidebar-layout">

    <!-- ============ Top Bar ============ -->
    <div class="nwpuoj-topbar">
      <div class="nwpuoj-topbar-left">
        <button type="button" class="nwpuoj-topbar-toggle" title="折叠/展开侧栏" aria-label="折叠或展开侧栏" aria-controls="nwpuoj-sidebar" aria-expanded="true">
          <i class="bars icon"></i>
        </button>
        <a href="/" class="nwpuoj-topbar-brand">
          <img src="/self/logo.png?v=<%= encodeURIComponent(syzoj.config.nwpuoj_version || '1.0.0') %>" alt="NWPUOJ" width="32" height="32">
          <span class="nwpuoj-topbar-brand-name"><%= syzoj.config.title %></span>
        </a>
      </div>
      <div class="nwpuoj-topbar-right">
        <% if (user) { %>
          <a class="nwpuoj-topbar-icon" href="<%= syzoj.utils.makeUrl(['notifications']) %>" title="通知中心">
            <i class="bell outline icon"></i>
            <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
              <span class="nwpuoj-topbar-badge"><%= unreadNotificationsCount > 99 ? '99+' : unreadNotificationsCount %></span>
            <% } %>
          </a>
          <a class="nwpuoj-topbar-icon" href="/messages" title="站内信">
            <i class="envelope outline icon"></i>
            <% if (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) { %>
              <span class="nwpuoj-topbar-badge"><%= unreadMessagesCount > 99 ? '99+' : unreadMessagesCount %></span>
            <% } %>
          </a>
          <div class="ui simple dropdown nwpuoj-topbar-user-dropdown">
            <%= user.username %>
            <i class="dropdown icon"></i>
            <div class="menu">
              <a class="item" href="<%= syzoj.utils.makeUrl(['user', user.id]) %>"><i class="user icon"></i>我的主页</a>
              <a class="item" href="<%= syzoj.utils.makeUrl(['user', user.id, 'edit']) %>"><i class="edit icon"></i>修改资料</a>
              <a class="item" href="<%= syzoj.utils.makeUrl(['clipboard']) %>"><i class="clipboard outline icon"></i>我的剪贴板</a>
              <% if (user.is_admin) { %>
                <style>
                  .nwpuoj-topbar-user-dropdown .nwpuoj-recalc-hit-item { background: transparent !important; }
                  .nwpuoj-topbar-user-dropdown .nwpuoj-recalc-hit-item:hover { background: rgba(0, 0, 0, 0.05) !important; }
                </style>
                <div class="ui divider"></div>
                <a class="item" href="<%= syzoj.utils.makeUrl(['admin', 'info']) %>"><i class="settings icon"></i>后台管理</a>
                <form method="post" action="<%= syzoj.utils.makeUrl(['admin', 'recalc-hit-scores']) %>"
                      onsubmit="return confirm('确定立即重新计算所有用户的 Hit 值吗？这是后台异步任务，需要 10-30 秒。');"
                      style="margin: 0;">
                  <button type="submit" class="item nwpuoj-recalc-hit-item" style="border: none; cursor: pointer; padding: 11px 16px; width: 100%; text-align: left; font-family: inherit; font-size: 1em; color: rgba(0,0,0,0.87); display: flex; align-items: center;">
                    <i class="refresh icon"></i>重算 Hit 值
                  </button>
                </form>
                <div class="ui basic modal" id="modal-restart">
                  <div class="ui icon header">
                    <i class="redo icon"></i>
                    <p style="margin-top: 15px;">重启服务</p>
                  </div>
                  <div class="content" style="text-align: center;">
                    <p>确认重新启动 SYZOJ Web 服务吗？</p>
                  </div>
                  <div class="actions">
                    <div class="ui red basic cancel inverted button">
                      <i class="remove icon"></i>否
                    </div>
                    <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['admin', 'restart'], { url: req.query['url'] || req.originalUrl }) %>">
                      <i class="checkmark icon"></i>是
                    </a>
                  </div>
                </div>
                <a class="item" href="#" onclick="$('#modal-restart').modal('show')"><i class="redo icon"></i>重启服务</a>
              <% } %>
              <% if (user.is_admin || (user.privileges && user.privileges.includes('manage_problem'))) { %>
                <a class="item" href="<%= syzoj.utils.makeUrl(['admin', 'solutions']) %>"><i class="gavel icon"></i>题解审核</a>
              <% } %>
              <% if (user.is_admin) { %>
                <a class="item" href="<%= syzoj.utils.makeUrl(['admin', 'announcements']) %>"><i class="bullhorn icon"></i>公告管理</a>
                <a class="item" href="<%= syzoj.utils.makeUrl(['admin', 'banners']) %>"><i class="audio description icon"></i>轮播管理</a>
              <% } %>
              <div class="ui divider"></div>
              <a class="item" href-post="<%= syzoj.utils.makeUrl(['logout'], { url: req.originalUrl }) %>"><i class="power icon"></i>注销</a>
            </div>
          </div>
        <% } else { %>
          <a class="nwpuoj-topbar-icon" href="<%= syzoj.utils.makeUrl(['login'], { url: req.query['url'] || req.originalUrl }) %>" style="padding: 6px 14px;">登录</a>
          <a class="nwpuoj-topbar-icon" href="<%= syzoj.utils.makeUrl(['sign_up'], { url: req.query['url'] || req.originalUrl }) %>" style="padding: 6px 14px; background: #2185d0; color: white !important;">注册</a>
        <% } %>
      </div>
    </div>

    <!-- ============ Side Bar ============ -->
    <aside class="nwpuoj-sidebar" id="nwpuoj-sidebar">
      <nav class="nwpuoj-sidebar-nav">
        <a class="nwpuoj-sidebar-item<% if (active === '') { %> active<% } %>" href="/">
          <i class="home icon"></i><span class="nwpuoj-sidebar-label">首页</span>
        </a>
        <a class="nwpuoj-sidebar-item<% if (active.startsWith('announcement')) { %> active<% } %>" href="<%= syzoj.utils.makeUrl(['announcements']) %>">
          <i class="bullhorn icon"></i><span class="nwpuoj-sidebar-label">公告</span>
        </a>
        <a class="nwpuoj-sidebar-item<% if (active.startsWith('problem')) { %> active<% } %>" href="/problems">
          <i class="list icon"></i><span class="nwpuoj-sidebar-label">题库</span>
        </a>
        <a class="nwpuoj-sidebar-item<% if (active.startsWith('contest')) { %> active<% } %>" href="/contests">
          <i class="calendar icon"></i><span class="nwpuoj-sidebar-label">比赛</span>
        </a>
        <a class="nwpuoj-sidebar-item<% if (active.startsWith('submission')) { %> active<% } %>" href="/submissions">
          <i class="tasks icon"></i><span class="nwpuoj-sidebar-label">评测</span>
        </a>
        <a class="nwpuoj-sidebar-item<% if (active.startsWith('ranklist')) { %> active<% } %>" href="/ranklist">
          <i class="signal icon"></i><span class="nwpuoj-sidebar-label">排名</span>
        </a>
        <a class="nwpuoj-sidebar-item<% if (active.startsWith('discussion') || active.startsWith('article')) { %> active<% } %>" href="/discussion/global">
          <i class="comments icon"></i><span class="nwpuoj-sidebar-label">讨论</span>
        </a>
        <a class="nwpuoj-sidebar-item<% if (active.startsWith('tags')) { %> active<% } %>" href="/tags">
          <i class="tags icon"></i><span class="nwpuoj-sidebar-label">标签</span>
        </a>
        <% if (user) { %>
          <a class="nwpuoj-sidebar-item" href="<%= syzoj.utils.makeUrl(['tickets']) %>">
            <i class="ticket icon"></i><span class="nwpuoj-sidebar-label">工单</span>
          </a>
        <% } %>
        <a class="nwpuoj-sidebar-item<% if (active.startsWith('help')) { %> active<% } %>" href="/help">
          <i class="help circle icon"></i><span class="nwpuoj-sidebar-label">帮助</span>
        </a>
      </nav>
    </aside>

    <!-- ============ Backdrop (移动端遮罩) ============ -->
    <div class="nwpuoj-backdrop"></div>

    <!-- ============ Main Content ============ -->
    <div style="margin-top: 0;">
    <div class="ui main container">
    <% if (typeof contestHeader !== 'undefined' && contestHeader) { %>
      <% include contest_context %>
    <% } %>
    <% if (typeof problemContext !== 'undefined' && problemContext) { %>
      <% include problem_context %>
    <% } %>
    <%
    let standardPageHeading = null;
    let hasPageContext = (typeof contestHeader !== 'undefined' && contestHeader) ||
      (typeof problemContext !== 'undefined' && problemContext);
    if (!hasPageContext) {
      if (/^\/problems(?:\/|$)/.test(req.path)) standardPageHeading = { title: '题库', icon: 'list' };
      else if (/^\/contests(?:\/|$)/.test(req.path)) standardPageHeading = { title: '比赛', icon: 'calendar' };
      else if (req.path === '/submissions') standardPageHeading = { title: '评测', icon: 'tasks' };
      else if (req.path === '/ranklist') standardPageHeading = { title: '排名', icon: 'signal' };
      else if (/^\/discussion\/(?:global|problems)\/?$/.test(req.path)) standardPageHeading = { title: '讨论', icon: 'comments' };
    }
    %>
    <% if (standardPageHeading) { %>
      <div class="padding nwpuoj-standard-page-heading">
        <% if (standardPageHeading.title === '题库') { %>
          <%
          const headingRepository = typeof repository !== 'undefined' && ['all', 'main', 'uoj', 'hdu', 'poj'].includes(repository)
            ? repository
            : (['main', 'uoj', 'hdu', 'poj'].includes(req.query.repository) ? req.query.repository : 'all');
          const headingRepositories = [
            { key: 'all', label: '全部题库' },
            { key: 'main', label: '主题库' },
            { key: 'uoj', label: 'UOJ' },
            { key: 'hdu', label: 'HDU' },
            { key: 'poj', label: 'POJ' }
          ];
          const headingFilterParams = {};
          if (req.query.keyword) headingFilterParams.keyword = req.query.keyword;
          if (req.query.sort) headingFilterParams.sort = req.query.sort;
          if (req.query.order) headingFilterParams.order = req.query.order;
          if (req.query.progress) headingFilterParams.progress = req.query.progress;
          const headingTagIDs = req.params && req.params.tagIDs;
          const headingPath = headingTagIDs
            ? ['problems', 'tag', headingTagIDs]
            : (req.path === '/problems/search' ? ['problems', 'search'] : ['problems']);
          const headingSearchPath = headingTagIDs ? ['problems', 'tag', headingTagIDs] : ['problems', 'search'];
          %>
          <style>
            .problem-repository-heading { display: block; }
            .problem-repository-heading h2 { margin: 0; }
            .problem-repository-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 0.5cm; }
            .problem-repository-search { margin-left: auto; width: 280px; max-width: 100%; }
            @media (max-width: 767px) {
              .problem-repository-controls { align-items: stretch; }
              .problem-repository-search { margin-left: 0; width: 100%; }
            }
          </style>
          <div class="problem-repository-heading">
            <h2 class="nwpuoj-page-title"><i class="list icon"></i>题库</h2>
            <div class="problem-repository-controls">
              <div class="nwpuoj-segmented" aria-label="切换题库">
                <% for (const option of headingRepositories) { %>
                  <a class="nwpuoj-segment <%= headingRepository === option.key ? 'active' : '' %>"
                     aria-current="<%= headingRepository === option.key ? 'page' : 'false' %>"
                     href="<%= syzoj.utils.makeUrl(headingPath, Object.assign({}, headingFilterParams, option.key === 'all' ? {} : { repository: option.key })) %>">
                    <%= option.label %>
                  </a>
                <% } %>
              </div>
              <form action="<%= syzoj.utils.makeUrl(headingSearchPath) %>" method="get" class="problem-repository-search">
                <% if (headingRepository !== 'all') { %><input type="hidden" name="repository" value="<%= headingRepository %>"><% } %>
                <% if (req.query.sort) { %><input type="hidden" name="sort" value="<%= req.query.sort %>"><% } %>
                <% if (req.query.order) { %><input type="hidden" name="order" value="<%= req.query.order %>"><% } %>
                <% if (req.query.progress) { %><input type="hidden" name="progress" value="<%= req.query.progress %>"><% } %>
                <div class="ui search" style="width: 100%;">
                  <div class="ui left icon input" style="width: 100%;">
                    <input class="prompt" style="width: 100%;" type="text" value="<%= req.query.keyword || '' %>" placeholder="ID / 题目名 …" name="keyword">
                    <i class="search icon"></i>
                  </div>
                  <div class="results" style="width: 100%;"></div>
                </div>
              </form>
            </div>
          </div>
        <% } else { %>
          <h2 class="nwpuoj-page-title"><i class="<%= standardPageHeading.icon %> icon"></i><%= standardPageHeading.title %></h2>
        <% } %>
      </div>
    <% } %>
