  <input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>">
  <div class="inline fields">
    <div class="field">
      <div class="ui checkbox">
        <input type="checkbox" name="is_public" checked>
        <label>导入后公开</label>
      </div>
    </div>
    <button class="ui primary labeled icon button" type="submit" id="uoj-import-all-button">
      <i class="download icon"></i>导入全部 UOJ 题目
    </button>
  </div>
</form>

<div class="ui message" id="uoj-import-all-status" style="display: none; max-width: 760px;" aria-live="polite">
