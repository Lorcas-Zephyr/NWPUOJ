<% this.adminPage = 'other'; %>
<% include admin_header %>
<% if (typeof success !== "undefined" && success) { %>
  <div class="ui success message" style="flex-grow: 0; ">
    <p><%= typeof successMessage !== 'undefined' ? successMessage : '操作成功！' %></p>
  </div>
<% } %>
<form method="post" class="ui form">
  <p><button class="ui blue labeled icon button" name="type" value="reset_count" type="submit"><i class="ui repeat icon"></i>重新计算提交及 AC 数</button></p>
  <p><button class="ui blue labeled icon button" name="type" value="reset_discussion" type="submit"><i class="ui repeat icon"></i>重新计算讨论版回复数和回复时间</button></p>
  <p><button class="ui blue labeled icon button" name="type" value="reset_codelen" type="submit"><i class="ui repeat icon"></i>重新计算提交代码长度</button></p>
  <p><button class="ui blue labeled icon button" name="type" value="import_luogu" type="submit"><i class="ui repeat icon"></i>导入洛谷 VJudge 题目</button></p>
</form>

<div class="ui divider"></div>
<form method="post" action="/admin/uoj/import" class="ui form">
  <input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>">
  <div class="inline fields">
    <div class="field">
      <label>UOJ 题号</label>
      <input type="number" name="problem_id" min="1" required placeholder="例如 1">
    </div>
    <div class="field">
      <div class="ui checkbox">
        <input type="checkbox" name="is_public" checked>
        <label>导入后公开</label>
      </div>
    </div>
    <button class="ui primary labeled icon button" type="submit">
      <i class="download icon"></i>导入 UOJ VJudge 题目
    </button>
  </div>
</form>
<form method="post" action="/admin/uoj/check" style="margin-top: 12px;">
  <input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>">
  <button class="ui basic labeled icon button" type="submit">
    <i class="plug icon"></i>测试 UOJ 账号连接
  </button>
</form>

<div class="ui divider"></div>
<form method="post" action="/admin/uoj/import-all" class="ui form" id="uoj-import-all-form"
