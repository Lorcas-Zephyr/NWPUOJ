  <p id="poj-import-all-summary"></p>
  <div class="ui tiny progress" id="poj-import-all-progress" style="margin: 10px 0 0;">
    <div class="bar" style="width: 0;"></div>
  </div>
  <div class="ui list" id="poj-import-all-failures"></div>
</div>

<script>
(function () {
  function setupBulkImport(provider, prefix, name) {
    var statusBox = document.getElementById(provider + '-import-all-status');
    var title = document.getElementById(provider + '-import-all-title');
    var summary = document.getElementById(provider + '-import-all-summary');
    var progress = document.getElementById(provider + '-import-all-progress');
    var failures = document.getElementById(provider + '-import-all-failures');
    var button = document.getElementById(provider + '-import-all-button');

    function render(status) {
      if (!status || status.state === 'idle') return;
      statusBox.style.display = '';
      statusBox.className = 'ui message';
      button.disabled = status.state === 'running';
      failures.innerHTML = '';

      if (status.state === 'running') {
        title.textContent = status.phase === 'listing' ? '正在读取 ' + name + ' 题库' : '正在批量导入 ' + name + ' 题目';
        summary.textContent = status.phase === 'listing'
          ? '正在获取远端题目列表...'
          : '总计 ' + status.total + '，已处理 ' + status.processed + '，导入 ' + status.imported +
            '，跳过 ' + status.skipped + '，失败 ' + status.failed +
            (status.currentRemoteId ? '，当前 ' + prefix + status.currentRemoteId : '');
      } else if (status.state === 'completed') {
        statusBox.className = 'ui positive message';
        title.textContent = name + ' 批量导入完成';
        summary.textContent = '总计 ' + status.total + '，导入 ' + status.imported +
          '，跳过 ' + status.skipped + '，失败 ' + status.failed + '。';
      } else {
        statusBox.className = 'ui negative message';
        title.textContent = name + ' 批量导入失败';
        summary.textContent = status.error || '任务异常终止。';
      }

      var percent = status.total ? Math.min(100, Math.round(status.processed * 100 / status.total)) : 0;
      progress.querySelector('.bar').style.width = percent + '%';
      (status.failures || []).forEach(function (failure) {
        var item = document.createElement('div');
        item.className = 'item';
        item.textContent = prefix + failure.remoteId + ': ' + failure.message;
        failures.appendChild(item);
      });
    }

    function poll() {
      fetch('/admin/' + provider + '/import-all/status', { credentials: 'same-origin' })
        .then(function (response) { return response.json(); })
        .then(function (status) {
          render(status);
          if (status.state === 'running') setTimeout(poll, 2000);
        })
        .catch(function () {});
    }

    poll();
  }

  setupBulkImport('uoj', 'U', 'UOJ');
  setupBulkImport('hdu', 'H', 'HDU');
  setupBulkImport('poj', 'P', 'POJ');
})();
</script>
<% include admin_footer %>
