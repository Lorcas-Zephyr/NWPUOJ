<% this.title = '公告' %>
<% include app_header %>

<div class="app-page app-announcements-page">
  <header class="app-page-header">
    <div class="app-page-heading"><span class="app-kicker">ANNOUNCEMENTS</span><h1 class="app-page-title">公告</h1><p class="app-page-description">查看平台通知、比赛安排和系统维护信息。</p></div>
    <span class="app-page-count"><strong><%= announcements.length %></strong> 条公告</span>
  </header>

  <% if (announcements.length) { %>
    <div class="app-announcement-list">
      <% for (const announcement of announcements) {
        const appLevelText = announcement.level === 'important' ? '重要' : (announcement.level === 'warning' ? '提醒' : '信息');
        const appLevelClass = announcement.level === 'important' ? 'app-status-error' : (announcement.level === 'warning' ? 'app-status-waiting' : '');
        const appAnnouncementState = announcement.start_time && now < announcement.start_time ? '未开始' : (announcement.end_time && now > announcement.end_time ? '已结束' : '生效中');
        const appAnnouncementStateClass = appAnnouncementState === '生效中' ? 'app-status-accepted' : (appAnnouncementState === '未开始' ? 'app-status-waiting' : '');
      %>
        <details class="app-announcement-row" id="announcement-<%= announcement.id %>">
          <summary><span class="app-announcement-row-main"><i data-lucide="chevron-right"></i><span class="app-status <%= appLevelClass %>"><%= appLevelText %></span><strong><%= announcement.title %></strong></span><span class="app-announcement-row-meta"><time><%= syzoj.utils.formatDate(announcement.public_time || announcement.start_time) %></time><span class="app-status <%= appAnnouncementStateClass %>"><%= appAnnouncementState %></span></span></summary>
          <div class="app-announcement-body"><% if (announcement.start_time || announcement.end_time) { %><p class="app-announcement-validity">有效期：<%= announcement.start_time ? syzoj.utils.formatDate(announcement.start_time) : '不限' %> 至 <%= announcement.end_time ? syzoj.utils.formatDate(announcement.end_time) : '不限' %></p><% } %><div class="app-markdown"><%- announcement.contentRendered %></div></div>
        </details>
      <% } %>
    </div>
  <% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="megaphone-off"></i><strong>暂无公告</strong><p>新的平台通知会显示在这里。</p></div></div><% } %>
</div>

<script>if (location.hash) { var announcement = document.querySelector(location.hash); if (announcement && announcement.tagName === 'DETAILS') { announcement.open = true; announcement.scrollIntoView({ block: 'center' }); } }</script>
<% include app_footer %>
