<% this.adminPage = 'help'; %>
<% include admin_header %>

<div class="app-admin-toolbar"><div><h3>编辑帮助页</h3><p>当前修订 <%= helpPage.revision %>，提交时会检查并发修改。</p></div><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['help']) %>" target="_blank" rel="noopener"><i data-lucide="external-link"></i>查看帮助页</a></div>
<form class="app-form" method="post" data-markdown-editor data-admin-help-v2 data-draft-key="content-draft:admin-help:<%= user.id %>">
  <input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><input type="hidden" name="revision" value="<%= helpPage.revision %>">
  <div class="app-editor-bar"><div class="app-segmented" role="tablist"><button class="is-active" type="button" role="tab" aria-selected="true" data-tab="edit"><i data-lucide="square-pen"></i>编辑</button><button type="button" role="tab" aria-selected="false" data-tab="preview"><i data-lucide="eye"></i>预览</button></div><span class="app-form-status" data-draft-status aria-live="polite"></span></div>
  <div class="app-editor-workspace">
    <div data-editor-panel="edit"><label class="app-field app-field-full app-editor-content-field"><span class="app-label">Markdown 内容</span><textarea class="app-textarea app-admin-editor" rows="30" id="content" name="content" required><%= helpPage.content %></textarea></label></div>
    <div class="app-editor-preview app-markdown" data-editor-panel="preview" hidden aria-live="polite"><div data-preview-content></div></div>
  </div>
  <div class="app-form-actions"><button class="app-button app-button-secondary" type="button" data-save-draft><i data-lucide="save"></i>保存草稿</button><button class="app-button app-button-primary" type="submit"><i data-lucide="send"></i>发布帮助页</button></div>
</form>
<% include markdown_editor_script %>
<script>
(function () {
  var form = document.querySelector('[data-admin-help-v2]');
  if (!form) return;
  form.addEventListener('submit', async function (event) {
    event.preventDefault();
    var button = form.querySelector('[type="submit"]'); if (button) button.disabled = true;
    try {
      var current = await fetch('/api/v2/admin/help/pages/main', { credentials: 'same-origin', cache: 'no-store' });
      var currentBody = await current.json();
      if (!current.ok) throw new Error(currentBody && currentBody.error && currentBody.error.message || '帮助页读取失败。');
      var response = await fetch('/api/v2/admin/help/pages/main', {
        method: 'PUT', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'If-Match': current.headers.get('ETag') || '' },
        body: JSON.stringify({ content: form.elements.content.value })
      });
      var body = await response.json();
      if (!response.ok) throw new Error(body && body.error && body.error.message || '帮助页保存失败。');
      try { localStorage.removeItem(form.dataset.draftKey); } catch (error) {}
      window.location.assign('/admin/help?saved=1');
    } catch (error) {
      if (window.NWPUOJApp) window.NWPUOJApp.showToast(error.message || '帮助页保存失败。', 'danger');
      if (button) button.disabled = false;
    }
  });
})();
</script>
<% include admin_footer %>
