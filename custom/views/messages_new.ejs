<% this.title = '发起新对话' %>
<% include app_header %>

<div class="app-page app-compose-page">
  <nav class="app-breadcrumb" aria-label="面包屑"><a href="<%= syzoj.utils.makeUrl(['messages']) %>">站内信</a><i data-lucide="chevron-right"></i><span>新对话</span></nav>
  <header class="app-page-header"><div class="app-page-heading"><span class="app-kicker">NEW MESSAGE</span><h1 class="app-page-title">发起新对话</h1><p class="app-page-description">选择收件人并发送第一条消息。</p></div></header>
  <form class="app-form app-compose-form" method="post" data-message-v2="new"><label class="app-field app-user-search-field"><span class="app-label">收件人</span><span class="app-input-with-action"><input class="app-input" type="text" name="to" value="<%= prefill %>" placeholder="输入用户名或 UID" autocomplete="off" required data-user-search><i data-lucide="search"></i></span><span class="app-user-search-results" data-user-search-results hidden></span><small class="app-field-help">可以直接输入用户名或数字 UID。</small></label><label class="app-field"><span class="app-label">消息内容</span><textarea class="app-textarea app-content-textarea" name="content" rows="8" maxlength="5000" required></textarea></label><div class="app-editor-actions"><a class="app-button app-button-quiet" href="<%= syzoj.utils.makeUrl(['messages']) %>">取消</a><button class="app-button app-button-primary" type="submit"><i data-lucide="send"></i>发送消息</button></div></form>
</div>

<script>
(function () { var input = document.querySelector('[data-user-search]'); var results = document.querySelector('[data-user-search-results]'); var timer; if (!input || !results) return; function close() { results.hidden = true; results.replaceChildren(); } input.addEventListener('input', function () { window.clearTimeout(timer); var query = input.value.trim(); if (!query) return close(); timer = window.setTimeout(async function () { try { var response = await fetch('/api/v2/search/users/' + encodeURIComponent(query), { credentials: 'same-origin', cache: 'no-store' }); var payload = await response.json(); var users = response.ok && payload && payload.data || []; results.replaceChildren(); users.slice(0, 8).forEach(function (listedUser) { var button = document.createElement('button'); button.type = 'button'; var strong = document.createElement('strong'); strong.textContent = listedUser.name; var small = document.createElement('small'); small.textContent = 'UID #' + listedUser.value; button.append(strong, small); button.addEventListener('click', function () { input.value = listedUser.name; input.dataset.recipientId = listedUser.value; close(); input.focus(); }); results.appendChild(button); }); results.hidden = !users.length; } catch (error) { close(); } }, 180); }); input.addEventListener('input', function () { delete input.dataset.recipientId; }); document.addEventListener('click', function (event) { if (!event.target.closest('.app-user-search-field')) close(); }); })();
</script>
<% include messages_v2_script %>
<% include app_footer %>
