<% this.title = '站内信设置' %>
<% include app_header %>

<div class="app-page app-message-settings-page">
  <nav class="app-breadcrumb" aria-label="面包屑"><a href="<%= syzoj.utils.makeUrl(['messages']) %>">站内信</a><i data-lucide="chevron-right"></i><span>设置</span></nav>
  <header class="app-page-header"><div class="app-page-heading"><span class="app-kicker">MESSAGE SETTINGS</span><h1 class="app-page-title">站内信设置</h1><p class="app-page-description">控制其他用户是否可以向你发起新对话。</p></div></header>
  <form class="app-form app-message-settings-form" method="post" data-message-v2="settings"><label class="app-setting-row"><span><strong>关闭站内信功能</strong><small>关闭后，除管理员外的其他用户无法给你发送私信；已有消息仍可查看。</small></span><input class="app-switch" type="checkbox" name="disable_messages"<%= setting.disable_messages ? ' checked' : '' %>></label><div class="app-form-actions app-form-actions-end"><button class="app-button app-button-primary" type="submit"><i data-lucide="save"></i>保存设置</button></div></form>
</div>

<% include messages_v2_script %>
<% include app_footer %>
