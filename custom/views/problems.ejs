<% this.title = '题库' %>
<%
let tagIDs = [];
if (typeof tags !== 'undefined') tagIDs = tags.map(tag => tag.id);
const canBulkDelete = typeof canBulkArchive !== 'undefined' && canBulkArchive;
const bulkJobId = /^[0-9a-f-]{36}$/i.test(String(req.query.bulk_job || '')) ? String(req.query.bulk_job) : '';
const bulkQueuedCount = Math.max(0, Math.min(200, Number(req.query.bulk_queued) || 0));
const currentRepository = typeof repository !== 'undefined' && ['all', 'main', 'uoj', 'hdu', 'poj'].includes(repository) ? repository : 'all';
const currentProgress = typeof progress !== 'undefined' ? progress : 'all';
const currentOrder = curOrder ? 'asc' : 'desc';
const repositories = [
  { key: 'all', label: '全部' },
  { key: 'main', label: '主题库' },
  { key: 'uoj', label: 'UOJ' },
  { key: 'hdu', label: 'HDU' },
  { key: 'poj', label: 'POJ' }
];
const tagFilterGroups = [
  { key: 'source', label: '题目来源', items: [] },
  { key: 'category', label: '算法大类', items: [] },
  { key: 'algorithm', label: '算法细目', items: [] },
  { key: 'type', label: '题目类型', items: [] },
  { key: 'difficulty', label: '题目难度', items: [] }
];
for (const tag of allProblemTags || []) {
  let key = tag.category === 'problem_type' ? 'type' : tag.category;
  if (!tagFilterGroups.some(group => group.key === key)) {
    key = 'algorithm';
    if (tag.color === 'pink') key = 'source';
    else if (tag.color === 'teal') key = 'category';
    else if (tag.color === 'olive') key = 'type';
    else if (['red', 'orange', 'yellow', 'green', 'blue', 'purple', 'black'].includes(tag.color) || tag.name === '暂无评定') key = 'difficulty';
  }
  tagFilterGroups.find(group => group.key === key).items.push(tag);
}
function problemGroup(displayId) {
  const value = String(displayId || '');
  if (value.startsWith('H')) return 'H';
  if (value.startsWith('P')) return 'P';
  if (value.startsWith('U')) return 'U';
  return '#';
}
const visibleProblems = problems.filter(problem => problem.is_public || problem.allowedEdit);
const problemGroupCounts = visibleProblems.reduce((counts, problem) => {
  const group = problemGroup(problem.getDisplayId());
  counts[group] = (counts[group] || 0) + 1;
  return counts;
}, {});
const problemColumnCount = 6 + (user ? 1 : 0) + (canBulkDelete ? 1 : 0);
function makeProblemFilterUrl(changes, nextTagIDs) {
  const query = {};
  if (currentRepository !== 'all') query.repository = currentRepository;
  if (req.query.keyword) query.keyword = req.query.keyword;
  if (curSort) query.sort = curSort;
  if (currentOrder) query.order = currentOrder;
  if (currentProgress !== 'all') query.progress = currentProgress;
  Object.keys(changes || {}).forEach(key => {
    if (changes[key] === null || changes[key] === '' || changes[key] === 'all') delete query[key];
    else query[key] = changes[key];
  });
  const selectedTags = typeof nextTagIDs === 'undefined' ? tagIDs : nextTagIDs;
  const path = selectedTags.length
    ? ['problems', 'tag', selectedTags.slice().sort((a, b) => a - b).join(',')]
    : (query.keyword ? ['problems', 'search'] : ['problems']);
  return syzoj.utils.makeUrl(path, query);
}
function problemSortUrl(key) {
  const nextOrder = curSort === key && currentOrder === 'asc' ? 'desc' : 'asc';
  return makeProblemFilterUrl({ sort: key, order: nextOrder });
}
function sortIcon(key) {
  if (curSort !== key) return 'arrow-up-down';
  return currentOrder === 'asc' ? 'arrow-up' : 'arrow-down';
}
function judgeStateClass(state) {
  const value = String(state || '').toLowerCase();
  if (value === 'accepted') return 'app-status-accepted';
  if (value.includes('waiting')) return 'app-status-waiting';
  if (value.includes('running') || value.includes('judging')) return 'app-status-judging';
  if (value.includes('partially')) return 'app-status-partial';
  return 'app-status-error';
}
%>
<% include app_header %>

<div class="app-page app-problems-page">
  <header class="app-page-header">
    <div class="app-page-heading">
      <span class="app-kicker">PROBLEM LIBRARY</span>
      <h1 class="app-page-title">题库</h1>
      <p class="app-page-description">按来源、进度和算法标签筛选题目，继续你的训练计划。</p>
    </div>
    <div class="app-page-actions">
      <% if (allowedManageTag) { %>
        <a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['problems', 'tag', 0, 'edit']) %>"><i data-lucide="tag"></i>新建标签</a>
      <% } %>
      <% if ((currentRepository === 'all' || currentRepository === 'main') && allowedCreateProblem) { %>
        <a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['problem', 0, 'edit']) %>"><i data-lucide="file-plus"></i>添加题目</a>
      <% } %>
    </div>
  </header>

  <% if (canBulkDelete && Number(req.query.bulk_archived) > 0) { %>
    <div class="app-notice app-notice-success"><i data-lucide="circle-check"></i><span>已归档 <strong><%= Number(req.query.bulk_archived) %></strong> 道题目。</span></div>
  <% } %>
  <% if (canBulkDelete && bulkJobId) { %>
    <div class="app-notice" role="status" aria-live="polite" data-problem-bulk-job data-job-id="<%= bulkJobId %>"><i data-lucide="loader-circle"></i><span data-bulk-job-text>正在处理 <strong><%= bulkQueuedCount %></strong> 道题目...</span></div>
  <% } %>

  <section class="app-section">
    <div class="app-toolbar app-problem-toolbar">
      <div class="app-toolbar-start">
        <div class="app-segmented" aria-label="题库来源">
          <% for (const option of repositories) { %>
            <a class="<%= currentRepository === option.key ? 'is-active' : '' %>" aria-current="<%= currentRepository === option.key ? 'page' : 'false' %>" href="<%= makeProblemFilterUrl({ repository: option.key }) %>"><%= option.label %></a>
          <% } %>
        </div>
        <% if (user) { %>
          <div class="app-segmented" aria-label="做题状态">
            <% for (const option of [{ key: 'all', label: '全部状态' }, { key: 'solved', label: '已通过' }, { key: 'attempted', label: '尝试过' }, { key: 'unattempted', label: '未尝试' }]) { %>
              <a class="<%= currentProgress === option.key ? 'is-active' : '' %>" aria-current="<%= currentProgress === option.key ? 'page' : 'false' %>" href="<%= makeProblemFilterUrl({ progress: option.key }) %>"><%= option.label %></a>
            <% } %>
          </div>
        <% } %>
      </div>
      <div class="app-toolbar-actions">
        <button class="app-button app-button-secondary" type="button" data-dialog-open="problem-filter-drawer" aria-haspopup="dialog" aria-controls="problem-filter-drawer"><i data-lucide="list-filter"></i>标签筛选<% if (tagIDs.length) { %><span class="app-filter-count"><%= tagIDs.length %></span><% } %></button>
        <label class="app-switch-control"><input type="checkbox" data-problem-tags-toggle><span class="app-switch-track"></span><span>显示标签</span></label>
      </div>
    </div>

    <form class="app-problem-search" action="<%= syzoj.utils.makeUrl(tagIDs.length ? ['problems', 'tag', tagIDs.join(',')] : ['problems', 'search']) %>" method="get" role="search">
      <% if (currentRepository !== 'all') { %><input type="hidden" name="repository" value="<%= currentRepository %>"><% } %>
      <% if (currentProgress !== 'all') { %><input type="hidden" name="progress" value="<%= currentProgress %>"><% } %>
      <span class="app-input-wrap"><i data-lucide="search"></i><input class="app-input" type="search" name="keyword" value="<%= req.query.keyword || '' %>" placeholder="搜索题号或题目名称"></span>
      <button class="app-button app-button-primary" type="submit">搜索</button>
      <% if (currentRepository !== 'all' || req.query.keyword || tagIDs.length || currentProgress !== 'all') { %><a class="app-button app-button-quiet" href="<%= syzoj.utils.makeUrl(['problems']) %>">清除筛选</a><% } %>
    </form>
  </section>

  <% if (visibleProblems.length) { %>
    <% if (canBulkDelete) { %>
      <form method="post" id="problem-bulk-delete-form" data-select-group data-problem-bulk-v2>
        <input type="hidden" name="repository" value="<%= currentRepository %>">
        <input type="hidden" name="csrf_token" value="<%= bulkDeleteCsrfToken %>">
        <div class="app-bulk-bar">
          <span>已选择 <strong data-selected-count>0</strong> 题</span>
          <button class="app-button app-button-danger-outline" type="button" data-dialog-open="problem-delete-dialog" data-requires-selection disabled><i data-lucide="archive"></i>批量归档</button>
        </div>
    <% } %>

    <div class="app-table-region" role="region" aria-label="题目列表" tabindex="0">
      <table class="app-table app-problem-table">
        <thead>
          <tr>
            <% if (canBulkDelete) { %><th><label class="app-check"><input type="checkbox" data-select-all aria-label="选择当前页全部题目"><span>选择</span></label></th><% } %>
            <% if (user) { %><th>状态</th><% } %>
            <th><a href="<%= problemSortUrl('id') %>">编号 <i data-lucide="<%= sortIcon('id') %>"></i></a></th>
            <th class="app-cell-primary"><a href="<%= problemSortUrl('title') %>">题目 <i data-lucide="<%= sortIcon('title') %>"></i></a></th>
            <th class="app-problem-tag-column">标签</th>
            <th><a href="<%= problemSortUrl('ac_num') %>">通过 <i data-lucide="<%= sortIcon('ac_num') %>"></i></a></th>
            <th><a href="<%= problemSortUrl('submit_num') %>">提交 <i data-lucide="<%= sortIcon('submit_num') %>"></i></a></th>
            <th>通过率</th>
          </tr>
        </thead>
        <tbody>
          <% let previousProblemGroup = null; %>
          <% for (const problem of problems) { if (!(problem.is_public || problem.allowedEdit)) continue; const currentProblemGroup = problemGroup(problem.getDisplayId()); %>
            <% if (currentProblemGroup !== previousProblemGroup) { previousProblemGroup = currentProblemGroup; %>
              <tr class="app-table-group"><td colspan="<%= problemColumnCount %>"><%= currentProblemGroup %><span><%= problemGroupCounts[currentProblemGroup] %> 题</span></td></tr>
            <% } %>
            <tr>
              <% if (canBulkDelete) { %><td><input type="checkbox" name="problem_ids" value="<%= problem.id %>" data-select-item aria-label="选择 <%= problem.getDisplayId() %> <%= problem.title %>"></td><% } %>
              <% if (user) { %>
                <td><% if (problem.judge_state) { %><a href="<%= syzoj.utils.makeUrl(['submission', problem.judge_state.id]) %>" class="app-status <%= judgeStateClass(problem.judge_state.status) %>"><%= problem.judge_state.status %></a><% } else { %><span class="app-status">未提交</span><% } %></td>
              <% } %>
              <td class="app-cell-number"><strong><%= problem.getDisplayId() %></strong></td>
              <td class="app-cell-primary">
                <span class="app-row-title"><a href="<%= syzoj.utils.makeUrl(['problem', problem.id]) %>"><%= problem.title %></a><% if (!problem.is_public) { %><span class="app-status app-status-warning">未公开</span><% } %></span>
              </td>
              <td class="app-problem-tag-column"><div class="app-tag-list"><% for (const tag of problem.tags || []) { const nextTags = tagIDs.includes(tag.id) ? tagIDs.filter(id => id !== tag.id) : tagIDs.concat(tag.id); %><a class="app-tag" href="<%= makeProblemFilterUrl({}, nextTags) %>"><%= tag.name %></a><% } %></div></td>
              <td class="app-cell-number"><%= problem.ac_num %></td>
              <td class="app-cell-number"><%= problem.submit_num %></td>
              <td class="app-cell-number"><%= problem.submit_num ? (((problem.ac_num / problem.submit_num * 100) || 0).toFixed(2) + '%') : '-' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (canBulkDelete) { %></form><% } %>
    <% include app_pagination %>
  <% } else { %>
    <div class="app-empty"><div class="app-empty-inner"><i data-lucide="<%= req.query.keyword ? 'search-x' : 'list-x' %>"></i><strong><%= req.query.keyword ? '没有匹配的题目' : '暂无题目' %></strong><p>调整筛选条件后再试。</p></div></div>
  <% } %>
</div>

<dialog class="app-dialog app-drawer" id="problem-filter-drawer" aria-modal="true" aria-labelledby="problem-filter-title">
  <div class="app-dialog-header app-drawer-header"><div><span class="app-kicker">FILTERS</span><h2 id="problem-filter-title">题目标签</h2></div><button class="app-icon-button" type="button" data-dialog-close aria-label="关闭标签筛选"><i data-lucide="x"></i></button></div>
  <div class="app-drawer-body">
    <div class="app-filter-menu-head"><strong><%= tagIDs.length ? '已选择 ' + tagIDs.length + ' 个标签' : '选择标签缩小题目范围' %></strong><% if (tagIDs.length) { %><a href="<%= makeProblemFilterUrl({}, []) %>">清除全部</a><% } %></div>
    <% for (const group of tagFilterGroups) { if (!group.items.length) continue; %>
      <div class="app-filter-group">
        <span><%= group.label %></span>
        <div class="app-filter-options">
          <% for (const tag of group.items) { const nextTags = tagIDs.includes(tag.id) ? tagIDs.filter(id => id !== tag.id) : tagIDs.concat(tag.id); %>
            <a class="app-tag <%= tagIDs.includes(tag.id) ? 'is-selected' : '' %>"<% if (tagIDs.includes(tag.id)) { %> aria-current="true"<% } %> href="<%= makeProblemFilterUrl({}, nextTags) %>"><%= tag.name %></a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
  <div class="app-dialog-actions app-drawer-actions"><button class="app-button app-button-secondary" type="button" data-dialog-close>完成</button></div>
</dialog>

<% if (canBulkDelete) { %>
  <dialog class="app-dialog" id="problem-delete-dialog">
    <div class="app-dialog-header"><h2>批量归档题目</h2><button class="app-icon-button" type="button" data-dialog-close aria-label="关闭"><i data-lucide="x"></i></button></div>
    <div class="app-dialog-body">
      <div class="app-notice app-notice-warning"><i data-lucide="archive"></i><span>归档后题目将从公开题库隐藏，历史提交、比赛快照、讨论和测试数据保持不变。</span></div>
    </div>
    <div class="app-dialog-actions"><button class="app-button app-button-secondary" type="button" data-dialog-close>取消</button><button class="app-button app-button-danger" type="submit" form="problem-bulk-delete-form"><i data-lucide="archive"></i>确认归档</button></div>
  </dialog>
<% } %>

<script>
(function () {
  var bulkForm = document.querySelector('[data-problem-bulk-v2]');
  if (bulkForm) {
    bulkForm.addEventListener('submit', async function (event) {
      event.preventDefault();
      var ids = Array.from(bulkForm.querySelectorAll('[data-select-item]:checked')).map(function (input) {
        return Number(input.value);
      }).filter(Number.isSafeInteger);
      if (!ids.length) return;
      var submit = document.querySelector('[type="submit"][form="problem-bulk-delete-form"]');
      if (submit) submit.disabled = true;
      try {
        var response = await fetch('/api/v2/problems/bulk-actions', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'Idempotency-Key': window.crypto && window.crypto.randomUUID ? window.crypto.randomUUID() : String(Date.now()) + Math.random()
          },
          body: JSON.stringify({ action: 'archive', problem_ids: ids })
        });
        var body = await response.json();
        if (!response.ok) throw new Error(body && body.error && body.error.message || '批量归档任务创建失败。');
        var next = new URL(window.location.href);
        next.searchParams.set('bulk_job', body.data.id);
        next.searchParams.set('bulk_queued', String(ids.length));
        window.location.assign(next.pathname + next.search);
      } catch (error) {
        if (window.NWPUOJApp) window.NWPUOJApp.showToast(error.message || '批量归档任务创建失败。', 'danger');
        else window.alert(error.message || '批量归档任务创建失败。');
        if (submit) submit.disabled = false;
      }
    });
  }

  var toggle = document.querySelector('[data-problem-tags-toggle]');
  var page = document.querySelector('.app-problems-page');
  if (toggle && page) {
    var visible = false;
    try { visible = localStorage.getItem('show_problem_tags') === '1'; } catch (error) {}
    toggle.checked = visible;
    page.classList.toggle('is-showing-tags', visible);
    toggle.addEventListener('change', function () {
      page.classList.toggle('is-showing-tags', toggle.checked);
      try { localStorage.setItem('show_problem_tags', toggle.checked ? '1' : '0'); } catch (error) {}
    });
  }

  var bulkJobNotice = document.querySelector('[data-problem-bulk-job]');
  if (bulkJobNotice) {
    var bulkJobText = bulkJobNotice.querySelector('[data-bulk-job-text]');
    var bulkJobId = bulkJobNotice.dataset.jobId;
    var bulkJobAttempts = 0;
    function renderBulkJob(job) {
      var result = job.result || {};
      var total = Number(result.total || <%= bulkQueuedCount %>);
      var processed = Number(result.processed || 0);
      if (job.state === 'completed') {
        bulkJobNotice.classList.add('app-notice-success');
        bulkJobText.textContent = '归档完成：成功 ' + Number(result.archived || 0) + '，跳过 ' + Number(result.skipped || 0) + '，失败 ' + Number(result.failed || 0) + '。刷新列表即可查看结果。';
        return true;
      }
      if (job.state === 'failed' || job.state === 'cancelled') {
        bulkJobNotice.classList.add(job.state === 'failed' ? 'app-notice-danger' : 'app-notice-warning');
        bulkJobText.textContent = job.state === 'failed' ? '批量归档失败，请在后台任务中重试。' : '批量归档已取消。';
        return true;
      }
      bulkJobText.textContent = (job.state === 'cancelling' ? '正在取消' : '正在归档') + '：' + processed + ' / ' + total;
      return false;
    }
    function refreshBulkJob() {
      fetch('/api/v2/problem-jobs/' + encodeURIComponent(bulkJobId), { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
        .then(function (response) { if (!response.ok) throw new Error('status'); return response.json(); })
        .then(function (body) { if (!renderBulkJob(body.data || {})) setTimeout(refreshBulkJob, 1500); })
        .catch(function () {
          bulkJobAttempts++;
          if (bulkJobAttempts < 4) setTimeout(refreshBulkJob, 2500);
          else { bulkJobNotice.classList.add('app-notice-warning'); bulkJobText.textContent = '任务状态暂时无法读取，稍后刷新页面即可继续查看。'; }
        });
    }
    refreshBulkJob();
  }

  document.addEventListener('keydown', function (event) {
    if (event.target && event.target.matches('input, textarea, select')) return;
    var target = event.key === 'ArrowRight' ? document.getElementById('page_next') : event.key === 'ArrowLeft' ? document.getElementById('page_prev') : null;
    if (target) target.click();
  });
})();
</script>

<% include app_footer %>
