<% this.title = '工单 #' + ticket.id + ' - ' + ticket.title %>
<% include app_header %>
<%
const appCat = categories[ticket.category];
const appState = statusMeta[ticket.status];
const appSubtype = appCat ? appCat.subtypes.find(function (item) { return item.value === ticket.subtype; }) : null;
const appStateClasses = { pending: 'app-status-pending', in_progress: 'app-status-running', resolved: 'app-status-accepted', rejected: 'app-status-rejected', closed: 'app-status-muted' };
const appTerminal = ['closed', 'rejected', 'resolved'].includes(ticket.status);
%>

<div class="app-page app-ticket-detail-page">
  <header class="app-page-header app-ticket-detail-header">
    <div class="app-page-heading"><a class="app-back-link" href="<%= syzoj.utils.makeUrl(['tickets']) %>"><i data-lucide="arrow-left"></i>工单列表</a><span class="app-kicker">TICKET #<%= ticket.id %></span><h1 class="app-page-title"><%= ticket.title %></h1><div class="app-ticket-header-meta"><span><%= appCat ? appCat.label : ticket.category %></span><span><%= appSubtype ? appSubtype.label : ticket.subtype %></span><span class="app-status <%= appStateClasses[ticket.status] || 'app-status-muted' %>"><%= appState ? appState.label : ticket.status %></span></div></div>
    <% if (canWithdraw) { %><form method="post" data-ticket-v2="close" data-ticket-id="<%= ticket.id %>" data-confirm="确定撤回此工单吗？撤回后将无法修改或回复。"><button class="app-button app-button-secondary" type="submit"><i data-lucide="undo"></i>撤回工单</button></form><% } %>
  </header>

  <div class="app-ticket-detail-grid">
    <main class="app-ticket-thread">
      <section class="app-ticket-description"><div class="app-section-header"><div><h2 class="app-section-title">问题描述</h2><p class="app-section-description">工单创建时提交的原始信息</p></div></div><div class="app-markdown"><% if (descRendered) { %><%- descRendered %><% } else { %><p class="app-muted-copy">未填写详细描述。</p><% } %></div></section>

      <% if (typeof attachments !== 'undefined' && attachments && attachments.length) { %><section class="app-ticket-attachments"><div class="app-section-header"><div><h2 class="app-section-title">附件</h2><p class="app-section-description"><%= attachments.length %> 个文件</p></div></div><div class="app-file-list"><% for (const attachment of attachments) { const isImage = attachment.mime_type && attachment.mime_type.startsWith('image/'); const sizeKB = Math.round(attachment.file_size / 1024); const size = sizeKB > 1024 ? (sizeKB / 1024).toFixed(2) + ' MB' : sizeKB + ' KB'; const url = syzoj.utils.makeUrl(['ticket-attachment', attachment.id]); %><div class="app-file-row"><% if (isImage) { %><a class="app-file-preview" href="<%= url %>" target="_blank" rel="noopener"><img src="<%= url %>" alt=""></a><% } else { %><span class="app-file-preview"><i data-lucide="file"></i></span><% } %><span><a href="<%= url %>" <%= isImage ? 'target="_blank" rel="noopener"' : 'download' %>><%= attachment.original_name %></a><small><%= size %><% if (attachment.mime_type) { %> · <%= attachment.mime_type %><% } %></small></span><% if (attachment.uploader_id === res.locals.user.id || isAdmin) { %><form method="post" action="/api/v2/ticket-attachments/<%= attachment.id %>" data-ticket-attachment-v2="<%= attachment.id %>" data-confirm="确定删除此附件吗？"><button class="app-icon-button" type="submit" aria-label="删除附件" title="删除附件"><i data-lucide="trash"></i></button></form><% } %></div><% } %></div></section><% } %>

      <section class="app-ticket-replies"><div class="app-section-header"><div><h2 class="app-section-title">处理记录</h2><p class="app-section-description"><%= replies.length %> 条记录</p></div></div>
        <% if (!replies.length) { %><div class="app-empty app-empty-compact"><div class="app-empty-inner"><i data-lucide="messages-square"></i><strong>暂无回复</strong><p>新的处理进展会显示在这里。</p></div></div><% } else { %><div class="app-ticket-timeline"><% for (const reply of replies) { const replyUser = replyUserMap[reply.user_id]; %><% if (reply.is_status_change) { %><div class="app-ticket-event"><span><i data-lucide="refresh-cw"></i></span><p><%= reply.content %><time><%= syzoj.utils.formatDate(reply.created_at) %></time></p></div><% } else { %><article class="app-ticket-reply <%= reply.is_internal ? 'is-internal' : '' %>"><div class="app-ticket-reply-head"><span class="app-avatar"><%= replyUser ? replyUser.username.charAt(0).toUpperCase() : '?' %></span><span><strong><% if (replyUser) { %><%- syzoj.utils.renderUsername(replyUser) %><% } else { %>账户已删除<% } %></strong><small><%= syzoj.utils.formatDate(reply.created_at) %></small></span><% if (reply.is_internal) { %><em><i data-lucide="lock-keyhole"></i>内部备注</em><% } %></div><div class="app-markdown"><%- reply.contentRendered %></div></article><% } %><% } %></div><% } %>
      </section>

      <% if (canReply) { %><section class="app-ticket-compose"><div class="app-section-header"><div><h2 class="app-section-title">添加回复</h2><p class="app-section-description">支持 Markdown，回复提交后不可编辑或删除。</p></div></div><form class="app-form" method="post" data-ticket-v2="reply" data-ticket-id="<%= ticket.id %>"><label class="app-field app-field-full"><span class="app-label">回复内容</span><textarea class="app-textarea" name="content" rows="6" maxlength="50000" placeholder="填写回复内容" required></textarea></label><div class="app-form-actions app-form-actions-split"><% if (isAdmin) { %><label class="app-check"><input type="checkbox" name="is_internal"><span>仅管理员可见的内部备注</span></label><% } else { %><span></span><% } %><button class="app-button app-button-primary" type="submit"><i data-lucide="send"></i>提交回复</button></div></form>
        <form class="app-upload-strip" id="attachment-upload-form" method="post" enctype="multipart/form-data" action="/api/v2/tickets/<%= ticket.id %>/attachments"><label><i data-lucide="paperclip"></i><span><strong>添加附件</strong><small>单文件最大 <%= typeof MAX_ATTACHMENT_SIZE_MB !== 'undefined' ? MAX_ATTACHMENT_SIZE_MB : 20 %> MB，累计最多 <%= typeof MAX_ATTACHMENT_FILES !== 'undefined' ? MAX_ATTACHMENT_FILES : 10 %> 个</small></span><input type="file" name="attachments" multiple id="attachment-file-input"></label><button class="app-button app-button-secondary" type="submit" id="attachment-upload-btn">上传文件</button><span id="attachment-upload-status" class="app-form-status" aria-live="polite"></span></form>
      </section><% } else if (appTerminal) { %><div class="app-notice"><i data-lucide="lock-keyhole"></i><span><strong>此工单已结案</strong><small>状态为“<%= appState ? appState.label : ticket.status %>”，无法继续回复。</small></span></div><% } else if (isAdmin && ticket.assignee_id !== res.locals.user.id) { %><div class="app-notice"><i data-lucide="hand"></i><span><strong>请先认领工单</strong><small>认领后可以回复并更新状态。</small></span></div><% } %>
    </main>

    <aside class="app-ticket-sidebar">
      <section><h2>工单信息</h2><dl><div><dt>状态</dt><dd><span class="app-status <%= appStateClasses[ticket.status] || 'app-status-muted' %>"><%= appState ? appState.label : ticket.status %></span></dd></div><div><dt>创建者</dt><dd><% if (creator) { %><%- syzoj.utils.renderUsername(creator) %><% } else { %>账户已删除<% } %></dd></div><div><dt>处理人</dt><dd><% if (assignee) { %><%- syzoj.utils.renderUsername(assignee) %><% } else { %>尚未分配<% } %></dd></div><div><dt>类型</dt><dd><%= appCat ? appCat.label : ticket.category %><% if (appSubtype) { %> · <%= appSubtype.label %><% } %></dd></div><% if (relationInfo) { %><div><dt>关联对象</dt><dd><a href="<%= relationInfo.url %>"><%= relationInfo.name %></a></dd></div><% } %><div><dt>创建时间</dt><dd><%= syzoj.utils.formatDate(ticket.created_at) %></dd></div><% if (ticket.updated_at !== ticket.created_at) { %><div><dt>最后更新</dt><dd><%= syzoj.utils.formatDate(ticket.updated_at) %></dd></div><% } %></dl><p class="app-private-note"><i data-lucide="lock-keyhole"></i>非公开工单</p></section>
      <% if (Object.keys(extraData).length) { %><section><h2>附加信息</h2><dl><% Object.keys(extraData).forEach(function (key) { %><div><dt><%= key === 'report_reason' ? '举报原因' : key %></dt><dd><%= extraData[key] %></dd></div><% }); %></dl></section><% } %>
      <% if (isAdmin) { %>
        <section class="app-ticket-admin">
          <h2>处理操作</h2>
          <% if (ticket.assignee_id !== res.locals.user.id) { %>
            <form class="app-admin-action-stack" method="post" data-ticket-v2="assign" data-ticket-id="<%= ticket.id %>" data-confirm="<%= ticket.assignee_id ? '确定接手此工单吗？' : '确定认领此工单吗？' %>">
              <button class="app-button app-button-primary" type="submit"><i data-lucide="hand"></i><%= ticket.assignee_id ? '接手工单' : '认领工单' %></button>
            </form>
          <% } else if (canChangeStatus && !appTerminal) { %>
            <% for (const action of [{ status: 'resolved', label: '标记为已处理', icon: 'circle-check', style: 'app-button-primary' }, { status: 'in_progress', label: '设为处理中', icon: 'loader-circle', style: 'app-button-secondary', hidden: ticket.status === 'in_progress' }, { status: 'rejected', label: '驳回工单', icon: 'circle-x', style: 'app-button-danger-outline' }]) { if (action.hidden) continue; %>
              <form class="app-admin-action-stack" method="post" data-ticket-v2="status" data-ticket-id="<%= ticket.id %>" data-confirm="确定执行“<%= action.label %>”吗？">
                <input type="hidden" name="status" value="<%= action.status %>">
                <button class="app-button <%= action.style %>" type="submit"><i data-lucide="<%= action.icon %>"></i><%= action.label %></button>
              </form>
            <% } %>
          <% } else if (appTerminal) { %>
            <form class="app-admin-action-stack" method="post" data-ticket-v2="status" data-ticket-id="<%= ticket.id %>" data-confirm="确定重新打开此工单吗？">
              <input type="hidden" name="status" value="in_progress">
              <button class="app-button app-button-secondary" type="submit"><i data-lucide="rotate-ccw"></i>重新打开</button>
            </form>
          <% } %>
          <% if (ticket.status !== 'closed') { %>
            <div class="app-danger-zone"><span>关闭后仍保留全部历史</span><form class="app-admin-action-stack" method="post" data-ticket-v2="admin-close" data-ticket-id="<%= ticket.id %>" data-confirm="确定关闭此工单吗？"><button class="app-button app-button-danger-outline" type="submit"><i data-lucide="lock-keyhole"></i>关闭工单</button></form></div>
          <% } %>
        </section>
      <% } %>
    </aside>
  </div>
</div>

<% if (canReply) { %><script>
(function () {
  var form = document.getElementById('attachment-upload-form'); var button = document.getElementById('attachment-upload-btn'); var input = document.getElementById('attachment-file-input'); var status = document.getElementById('attachment-upload-status'); var max = <%= typeof MAX_ATTACHMENT_SIZE_MB !== 'undefined' ? MAX_ATTACHMENT_SIZE_MB : 20 %>;
  form.addEventListener('submit', async function (event) { event.preventDefault(); if (!input.files.length) { status.textContent = '请先选择文件'; return; } for (var i = 0; i < input.files.length; i++) { if (input.files[i].size > max * 1024 * 1024) { status.textContent = input.files[i].name + ' 超过 ' + max + ' MB'; return; } } button.disabled = true; status.textContent = '正在上传...'; try { var response = await fetch(form.action, { method: 'POST', body: new FormData(form) }); var data = await response.json(); if (!response.ok || !data.data) throw new Error(data && data.error && data.error.message || '上传失败'); status.textContent = '上传成功，正在刷新...'; window.setTimeout(function () { location.reload(); }, 450); } catch (error) { status.textContent = error.message; button.disabled = false; } });
})();
</script><% } %>

<script>
(function () {
  document.addEventListener('submit', async function (event) {
    var form = event.target.closest('[data-ticket-attachment-v2]');
    if (!form || event.defaultPrevented) return;
    event.preventDefault();
    var button = form.querySelector('button[type="submit"]');
    if (button) button.disabled = true;
    try {
      var response = await fetch(form.action, { method: 'DELETE', credentials: 'same-origin' });
      var body = await response.json();
      if (!response.ok) throw new Error(body && body.error && body.error.message || '附件删除失败。');
      window.location.reload();
    } catch (error) {
      if (window.NWPUOJApp) window.NWPUOJApp.showToast(error.message || '附件删除失败。', 'danger');
      if (button) button.disabled = false;
    }
  });
})();
</script>

<% include ticket_v2_script %>

<% include app_footer %>
