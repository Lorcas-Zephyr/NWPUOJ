<% this.title = item.id ? '编辑剪贴板' : '新建剪贴板' %>
<% include app_header %>
<%
function appExpiresToDays(timestamp) { if (!timestamp) return 0; const remaining = timestamp - Math.floor(Date.now() / 1000); return remaining > 0 ? Math.ceil(remaining / 86400) : 0; }
const appCurrentVisibility = ['public', 'link'].includes(item.visibility) ? item.visibility : 'private';
%>

<div class="app-page app-clipboard-editor-page">
  <header class="app-page-header"><div class="app-page-heading"><a class="app-back-link" href="<%= syzoj.utils.makeUrl(['clipboard']) %>"><i data-lucide="arrow-left"></i>我的剪贴板</a><span class="app-kicker">CLIPBOARD EDITOR</span><h1 class="app-page-title"><%= item.id ? '编辑内容' : '新建内容' %></h1><p class="app-page-description">使用 Markdown 编写，预览会实时更新。</p></div></header>
  <form class="app-form" method="post" data-clipboard-v2="save" data-clipboard-id="<%= item.id %>">
    <div class="app-clipboard-meta"><label class="app-field"><span class="app-label">标题</span><input class="app-input" type="text" name="title" maxlength="120" value="<%= item.title || '' %>" placeholder="例如：常用模板代码" required></label><fieldset class="app-field"><legend class="app-label">可见性</legend><div class="app-choice-row"><label class="app-choice"><input type="radio" name="visibility" value="private"<%= appCurrentVisibility === 'private' ? ' checked' : '' %>><span><i data-lucide="lock-keyhole"></i><strong>私有</strong><small>仅自己可见</small></span></label><label class="app-choice"><input type="radio" name="visibility" value="public"<%= appCurrentVisibility === 'public' ? ' checked' : '' %>><span><i data-lucide="globe-2"></i><strong>公开</strong><small>显示在公开列表</small></span></label><label class="app-choice"><input type="radio" name="visibility" value="link"<%= appCurrentVisibility === 'link' ? ' checked' : '' %>><span><i data-lucide="link"></i><strong>链接</strong><small>凭分享链接访问</small></span></label></div></fieldset><label class="app-field app-link-options" id="link-options"<%= appCurrentVisibility === 'link' ? '' : ' hidden' %>><span class="app-label">链接有效期</span><span class="app-input-with-unit"><input class="app-input" type="number" name="share_days" min="0" max="365" value="<%= appExpiresToDays(item.share_expires) %>"><em>天</em></span><span class="app-help">0 表示永不过期，最长 365 天。</span></label></div>
    <section class="app-clipboard-editor is-vditor-workspace"><div class="app-editor-pane"><header><span><i data-lucide="square-pen"></i>Markdown</span><small id="clipboard-editor-stats">0 字 · 1 行</small></header><textarea name="content" id="clipboard-edit-content" rows="20" maxlength="102400" placeholder="开始输入 Markdown 内容"><%= item.content || '' %></textarea></div></section>
    <div class="app-form-actions"><a class="app-button app-button-quiet" href="<%= item.id ? syzoj.utils.makeUrl(['clipboard', item.id]) : syzoj.utils.makeUrl(['clipboard']) %>">取消</a><button class="app-button app-button-primary" type="submit"><i data-lucide="save"></i>保存内容</button></div>
  </form>
</div>

<script>
(function () {
  var visibility = document.querySelectorAll('input[name="visibility"]');
  var linkOptions = document.getElementById('link-options');
  var textarea = document.getElementById('clipboard-edit-content');
  var stats = document.getElementById('clipboard-editor-stats');

  function render() {
    var text = textarea.value;
    stats.textContent = text.length + ' 字 · ' + text.split('\n').length + ' 行';
  }

  visibility.forEach(function (input) {
    input.addEventListener('change', function () { linkOptions.hidden = document.querySelector('input[name="visibility"]:checked').value !== 'link'; });
  });
  textarea.addEventListener('input', render);
  render();
})();
</script>
<% include clipboard_v2_script %>
<% include app_footer %>
