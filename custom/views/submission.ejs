<% this.title = '提交记录 #' + info.submissionId %>
<% include util %>
<%
const appAdminAction = typeof judgeAdminAction !== 'undefined' && judgeAdminAction ? judgeAdminAction : null;
const appIsCheated = !!(appAdminAction && appAdminAction.action_type === 'cheated');
const appIsCancelled = !!(appAdminAction && appAdminAction.action_type === 'cancelled');
const appIsMarked = appIsCheated || appIsCancelled;
const appCanManage = typeof canManageSubmissionAction !== 'undefined' && canManageSubmissionAction;
if (appIsCheated) detailResult = null;
const appResultTypes = ['', 'Accepted', 'Wrong Answer', 'Partially Correct', 'Memory Limit Exceeded', 'Time Limit Exceeded', 'Output Limit Exceeded', 'File Error', 'Runtime Error', 'Judgement Failed', 'Invalid Interaction'];
function appStatusClass(status) {
  const value = String(status || '').toLowerCase();
  if (value === 'accepted') return 'app-verdict app-verdict-accepted';
  if (value === 'waiting') return 'app-status-waiting';
  if (value === 'running' || value === 'judging' || value === 'compiling') return 'app-status-judging';
  if (value === 'partially correct') return 'app-status-partial';
  if (value === 'skipped' || value === '已取消') return '';
  if (value === '作弊' || value === 'cheated' || value === 'wrong answer') return 'app-verdict app-verdict-wrong';
  if (value === 'runtime error' || value === 'invalid interaction') return 'app-verdict app-verdict-runtime';
  if (value === 'time limit exceeded') return 'app-verdict app-verdict-time';
  if (value === 'memory limit exceeded' || value === 'output limit exceeded') return 'app-verdict app-verdict-memory';
  if (value.includes('error') || value === 'judgement failed') return 'app-verdict app-verdict-compile';
  return '';
}
function appCaseStatus(testcase) {
  if (!testcase) return 'System Error';
  if (testcase.status === 0) return 'Waiting';
  if (testcase.status === 1) return 'Running';
  if (testcase.status === 4) return 'Skipped';
  if (testcase.status === 2 && testcase.result) return appResultTypes[testcase.result.type] || 'System Error';
  return 'System Error';
}
function appSubtaskStatus(subtask) {
  if (subtask.resultStatus === 'Skipped') return 'Skipped';
  if (subtask.resultType != null) return appResultTypes[subtask.resultType] || 'System Error';
  const statuses = (subtask.cases || []).map(appCaseStatus);
  if (statuses.includes('Running')) return 'Running';
  if (statuses.includes('Waiting')) return 'Waiting';
  if (statuses.length && statuses.every(status => status === 'Skipped')) return 'Skipped';
  return statuses.find(status => status !== 'Accepted' && status !== 'Skipped') || (statuses.length ? 'Accepted' : 'System Error');
}
function appFormatSize(bytes) {
  let value = Number(bytes || 0); const units = ['B', 'K', 'M', 'G']; let unit = 0;
  while (value >= 1024 && unit < units.length - 1) { value /= 1024; unit += 1; }
  return (value === Math.round(value) ? value : value.toFixed(1)) + ' ' + units[unit];
}
const appStatus = appIsCheated ? '作弊' : (appIsCancelled ? '已取消' : (roughResult ? roughResult.result : (submissionPending ? 'Judging' : 'Waiting')));
const appScore = appIsMarked ? 0 : (roughResult ? Math.floor(roughResult.score || 0) : 0);
const appProblemUrl = displayConfig.inContest && typeof contest !== 'undefined' && contest
  ? syzoj.utils.makeUrl(['contest', contest.id, 'problem', info.problemId])
  : syzoj.utils.makeUrl(['problem', info.sourceProblemId || info.problemId]);
const appPreferredFormatted = !!(preferFormattedCode && formattedCode !== null);
const appCodeHtml = appPreferredFormatted ? formattedCode : code;
const appSubtasks = detailResult && detailResult.judge && Array.isArray(detailResult.judge.subtasks) ? detailResult.judge.subtasks : [];
%>
<% include app_header %>
<% if (typeof contestHeader !== 'undefined' && contestHeader) { %><% include contest_context %><% } %>

<div class="app-page app-submission-detail-page">
  <header class="app-page-header">
    <div class="app-page-heading">
      <span class="app-kicker">SUBMISSION <%= info.submissionId %></span>
      <h1 class="app-page-title"><a href="<%= appProblemUrl %>"><%= displayConfig.inContest ? this.alpha(info.problemId) : info.problemDisplayId %>. <%= info.problemName %></a></h1>
      <p class="app-page-description">由 <a href="<%= syzoj.utils.makeUrl(['user', info.userId]) %>"><%= info.user %></a> 于 <%= info.submitTime %> 提交</p>
    </div>
    <div class="app-page-actions">
      <% if (displayConfig.showRejudge && !submissionPending) { %><button class="app-button app-button-secondary" type="button" data-dialog-open="submission-rejudge-dialog"><i data-lucide="refresh-cw"></i>重新评测</button><% } %>
      <a class="app-button app-button-quiet" href="<%= displayConfig.inContest && typeof contest !== 'undefined' && contest ? syzoj.utils.makeUrl(['contest', contest.id, 'submissions']) : syzoj.utils.makeUrl(['submissions']) %>"><i data-lucide="arrow-left"></i>返回列表</a>
    </div>
  </header>

  <% if (appIsMarked && appAdminAction) { %>
    <div class="app-notice <%= appIsCheated ? 'app-notice-danger' : 'app-notice-warning' %>"><i data-lucide="<%= appIsCheated ? 'ban' : 'circle-slash' %>"></i><span><strong>该提交已被标记为“<%= appIsCheated ? '作弊' : '取消评测' %>”</strong> · 操作人：<a href="<%= syzoj.utils.makeUrl(['user', appAdminAction.operator_id]) %>"><%= appAdminAction.operator_username %></a> · <%= syzoj.utils.formatDate(appAdminAction.operator_time) %><% if (appAdminAction.reason) { %><small>原因：<%= appAdminAction.reason %></small><% } %></span></div>
  <% } %>

  <section class="app-submission-summary" aria-label="提交摘要">
    <div><span>状态</span><strong class="app-status <%= appStatusClass(appStatus) %>" data-detail-status><%= appStatus %></strong></div>
    <% if (displayConfig.showScore) { %><div><span>分数</span><strong class="app-score <%= appScore === 100 ? 'app-score-perfect' : (appScore === 0 ? 'app-score-zero' : '') %>" data-detail-score><%= appScore %></strong></div><% } %>
    <% if (displayConfig.showUsage) { %><div><span>总时间</span><strong data-detail-time><%= roughResult ? roughResult.time || 0 : 0 %> ms</strong></div><div><span>内存</span><strong data-detail-memory><%= roughResult ? appFormatSize((roughResult.memory || 0) * 1024) : '0 B' %></strong></div><% } %>
    <% if (displayConfig.showCode) { %><div><span>语言 / 大小</span><strong><%= info.language || '答案文件' %> · <%= appFormatSize(info.codeSize) %></strong></div><% } %>
  </section>

  <% if (appCanManage) { %>
    <details class="app-admin-operation">
      <summary><span><i data-lucide="shield"></i>管理员操作</span><i data-lucide="chevron-down"></i></summary>
      <div class="app-admin-operation-body">
        <% if (!appIsMarked) { %>
          <form class="app-form app-inline-admin-form" method="post" action="/api/v2/submissions/<%= info.submissionId %>/admin-actions" data-submission-admin-v2="create" data-confirm="确定执行此操作吗？提交状态、AC 数与 Hit 统计将同步更新。"><span class="app-inline-actions"><button class="app-button app-button-danger" type="submit" name="action_type" value="cheated"><i data-lucide="ban"></i>判定作弊</button><button class="app-button app-button-secondary" type="submit" name="action_type" value="cancelled"><i data-lucide="circle-slash"></i>取消评测</button></span></form>
        <% } else { %>
          <div class="app-admin-action-stack"><form class="app-inline-form" method="post" action="/api/v2/submissions/<%= info.submissionId %>/admin-actions" data-submission-admin-v2="revoke" data-confirm="确定撤销此标记吗？提交将恢复原有评测状态。"><button class="app-button app-button-secondary" type="submit"><i data-lucide="undo"></i>撤销标记</button></form><% if (appIsCancelled) { %><form class="app-inline-form" method="post" action="/api/v2/submissions/<%= info.submissionId %>/restore-and-rejudge" data-submission-admin-v2="restore" data-confirm="确定清除取消标记并重新评测吗？"><button class="app-button app-button-primary" type="submit"><i data-lucide="refresh-cw"></i>恢复并重测</button></form><% } %></div>
        <% } %>
      </div>
    </details>
  <% } %>

  <script>
  (function () {
    document.addEventListener('submit', async function (event) {
      var form = event.target.closest('[data-submission-admin-v2]');
      if (!form || event.defaultPrevented) return;
      event.preventDefault();
      var action = form.dataset.submissionAdminV2;
      var submitter = event.submitter || form.querySelector('button[type="submit"]');
      var buttons = form.querySelectorAll('button[type="submit"]');
      buttons.forEach(function (button) { button.disabled = true; });
      try {
        var method = action === 'revoke' ? 'DELETE' : 'POST';
        var payload = action === 'create' ? { action_type: submitter && submitter.value } : {};
        var response = await fetch(form.action, { method: method, credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: method === 'DELETE' ? undefined : JSON.stringify(payload) });
        var body = await response.json();
        if (!response.ok) throw new Error(body && body.error && body.error.message || '提交管理操作失败。');
        window.location.reload();
      } catch (error) {
        if (window.NWPUOJApp) window.NWPUOJApp.showToast(error.message || '提交管理操作失败。', 'danger');
        buttons.forEach(function (button) { button.disabled = false; });
      }
    });
  })();
  </script>

  <% if (displayConfig.showCode && appCodeHtml != null) { %>
    <section class="app-code-panel">
      <header><div><span class="app-kicker">SOURCE</span><h2>源代码</h2></div><span class="app-inline-actions"><% if (formattedCode !== null) { %><button class="app-icon-button" type="button" data-code-format-toggle aria-label="切换代码格式" title="切换代码格式"><i data-lucide="braces"></i></button><% } %><button class="app-icon-button" type="button" data-copy="#submission-source" aria-label="复制源代码" title="复制源代码"><i data-lucide="copy"></i></button></span></header>
      <pre><code id="submission-source"><%- appCodeHtml %></code></pre>
    </section>
  <% } %>

  <% if (detailResult && detailResult.compile && detailResult.compile.message) { %><details class="app-log-panel" open><summary><span><i data-lucide="square-terminal"></i>编译信息</span><i data-lucide="chevron-down"></i></summary><pre><code><%= detailResult.compile.message %></code></pre></details><% } %>
  <% if (detailResult && detailResult.systemMessage) { %><details class="app-log-panel"><summary><span><i data-lucide="server-cog"></i>系统信息</span><i data-lucide="chevron-down"></i></summary><pre><code><%= detailResult.systemMessage %></code></pre></details><% } %>

  <% if (appSubtasks.length) { %>
    <section class="app-judge-details">
      <div class="app-section-heading"><div><span class="app-kicker">JUDGE DETAILS</span><h2>测试结果</h2></div><span class="app-section-count"><%= appSubtasks.length %> 个子任务</span></div>
      <div class="app-subtask-list">
        <% let appSubtaskIndex = 0; for (const subtask of appSubtasks) { appSubtaskIndex += 1; const appSubtaskState = appSubtaskStatus(subtask); %>
          <details class="app-subtask"<%= appSubtasks.length === 1 ? ' open' : '' %>>
            <summary><span class="app-subtask-title"><i data-lucide="chevron-right"></i><strong>子任务 <%= appSubtaskIndex %></strong><span class="app-status <%= appStatusClass(appSubtaskState) %>"><%= appSubtaskState %></span></span><span class="app-subtask-metrics"><% if (subtask.score != null) { %><span>得分 <strong><%= Math.trunc(subtask.score) %></strong></span><% } %><span><%= (subtask.cases || []).length %> 个测试点</span></span></summary>
            <div class="app-testcase-list">
              <% let appCaseIndex = 0; for (const testcase of subtask.cases || []) { appCaseIndex += 1; const appTestcaseState = appCaseStatus(testcase); const appCaseResult = testcase.result || {}; const appHasCaseDetail = !!(testcase.errorMessage || appCaseResult.input || appCaseResult.output || appCaseResult.userOutput || appCaseResult.userError || appCaseResult.spjMessage || appCaseResult.systemMessage); %>
                <% if (appHasCaseDetail) { %><details class="app-testcase"><summary><% } else { %><div class="app-testcase app-testcase-static"><% } %>
                  <span class="app-testcase-title"><% if (appHasCaseDetail) { %><i data-lucide="chevron-right"></i><% } %><strong>#<%= appCaseIndex %></strong><span class="app-status <%= appStatusClass(appTestcaseState) %>"><%= appTestcaseState %></span></span>
                  <span class="app-testcase-metrics"><% if (appCaseResult.scoringRate != null) { %><span><%= Math.trunc(appCaseResult.scoringRate * 100) %> 分</span><% } %><% if (appCaseResult.time != null) { %><span><%= appCaseResult.time %> ms</span><% } %><% if (appCaseResult.memory != null) { %><span><%= appCaseResult.memory %> KiB</span><% } %></span>
                <% if (appHasCaseDetail) { %></summary><div class="app-testcase-detail">
                  <% if (appCaseResult.input) { %><section><h3>输入文件 <code><%= appCaseResult.input.name %></code><% if (!appCaseResult.input.remote) { %><a class="app-icon-button" href="<%= syzoj.utils.makeUrl(['problem', info.sourceProblemId || info.problemId, 'testdata', 'download']) %>/<%= encodeURIComponent(appCaseResult.input.name) %>" aria-label="下载输入文件"><i data-lucide="download"></i></a><% } %></h3><pre><code><%= appCaseResult.input.content %></code></pre></section><% } %>
                  <% if (appCaseResult.output) { %><section><h3>答案文件 <code><%= appCaseResult.output.name %></code><a class="app-icon-button" href="<%= syzoj.utils.makeUrl(['problem', info.sourceProblemId || info.problemId, 'testdata', 'download']) %>/<%= encodeURIComponent(appCaseResult.output.name) %>" aria-label="下载答案文件"><i data-lucide="download"></i></a></h3><pre><code><%= appCaseResult.output.content %></code></pre></section><% } %>
                  <% for (const appOutput of [{ title: '用户输出', value: appCaseResult.userOutput }, { title: '标准错误流', value: appCaseResult.userError }, { title: 'Special Judge 信息', value: appCaseResult.spjMessage }, { title: '系统信息', value: appCaseResult.systemMessage }, { title: '错误信息', value: testcase.errorMessage }]) { if (!appOutput.value) continue; %><section><h3><%= appOutput.title %></h3><pre><code><%= appOutput.value %></code></pre></section><% } %>
                </div></details><% } else { %></div><% } %>
              <% } %>
            </div>
          </details>
        <% } %>
      </div>
    </section>
  <% } else if (!submissionPending && !appIsMarked) { %><div class="app-empty app-empty-compact"><div class="app-empty-inner"><i data-lucide="scan-search"></i><strong>暂无测试点详情</strong><p>当前评测没有可公开的详细结果。</p></div></div><% } %>
</div>

<% if (displayConfig.showRejudge && !submissionPending) { %><dialog class="app-dialog" id="submission-rejudge-dialog"><div class="app-dialog-header"><h2>重新评测</h2><button class="app-icon-button" type="button" data-dialog-close aria-label="关闭"><i data-lucide="x"></i></button></div><div class="app-dialog-body"><p>确认将提交 #<%= info.submissionId %> 重新加入评测队列吗？</p></div><div class="app-dialog-actions"><button class="app-button app-button-secondary" type="button" data-dialog-close>取消</button><button class="app-button app-button-primary" type="button" data-submission-v2-rejudge="/api/v2/submissions/<%= info.submissionId %>/rejudge"><i data-lucide="refresh-cw"></i>确认重测</button></div></dialog><% } %>

<script>
(function () {
  var source = document.getElementById('submission-source');
  var toggle = document.querySelector('[data-code-format-toggle]');
  if (source && toggle) {
    var raw = <%- serializejs(code) %>;
    var formatted = <%- serializejs(formattedCode) %>;
    var showingFormatted = <%- serializejs(appPreferredFormatted) %>;
    toggle.addEventListener('click', function () { showingFormatted = !showingFormatted; source.innerHTML = showingFormatted ? formatted : raw; });
  }
  var rejudge = document.querySelector('[data-submission-v2-rejudge]');
  if (rejudge) rejudge.addEventListener('click', async function () {
    rejudge.disabled = true;
    try {
      var response = await fetch(rejudge.dataset.submissionV2Rejudge, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: '{}' });
      var payload = await response.json();
      if (!response.ok || !payload.data) throw new Error(payload && payload.error && payload.error.message || '重新评测失败。');
      var dialog = rejudge.closest('dialog');
      if (dialog) dialog.close();
      if (window.NWPUOJApp) window.NWPUOJApp.showToast('提交已重新加入评测队列', 'success');
      window.setTimeout(function () { window.location.reload(); }, 350);
    } catch (error) {
      if (window.NWPUOJApp) window.NWPUOJApp.showToast(error.message || '重新评测失败。', 'danger');
      rejudge.disabled = false;
    }
  });
  if (!<%- serializejs(!!submissionPending) %>) return;
  var retryDelay = 1000;
  var statusLabels = {
    created: 'Waiting', queued: 'Waiting', compiling: 'Compiling', judging: 'Judging',
    accepted: 'Accepted', wrong_answer: 'Wrong Answer', compile_error: 'Compile Error',
    runtime_error: 'Runtime Error', time_limit: 'Time Limit Exceeded', memory_limit: 'Memory Limit Exceeded',
    output_limit: 'Output Limit Exceeded', file_error: 'File Error', invalid_interaction: 'Invalid Interaction',
    partially_correct: 'Partially Correct', system_error: 'System Error', cancelled: 'Cancelled'
  };
  function connect() {
    var received = false;
    var events = new EventSource('/api/v2/submissions/<%= info.submissionId %>/events');
    events.onmessage = function (event) {
      received = true;
      var update = JSON.parse(event.data);
      var projected = update && update.payload && update.payload.status;
      if (!projected) return;
      var label = statusLabels[projected] || projected;
      var status = document.querySelector('[data-detail-status]');
      if (status) { status.textContent = label; status.className = 'app-status ' + (<%- appStatusClass.toString() %>)(label); }
      if (!['created', 'queued', 'compiling', 'judging'].includes(projected)) { events.close(); location.reload(); }
    };
    events.onerror = function () { events.close(); var delay = retryDelay; retryDelay = received ? 1000 : Math.min(retryDelay * 2, 30000); window.setTimeout(connect, delay); };
  }
  connect();
})();
</script>

<% include app_footer %>
