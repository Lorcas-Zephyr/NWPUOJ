<% this.title = '标签' %>
<% include app_header %>
<%
const appKnownColors = ['red', 'orange', 'yellow', 'olive', 'green', 'teal', 'blue', 'violet', 'purple', 'pink', 'black'];
const appTagGroups = [
  { key: 'source', title: '题目来源', icon: 'flag', description: '赛事、平台与题库来源', match: function (tag) { return tag.category === 'source' || (!tag.category && tag.color === 'pink'); } },
  { key: 'category', title: '算法大类', icon: 'blocks', description: '核心算法领域', match: function (tag) { return tag.category === 'category' || (!tag.category && tag.color === 'teal'); } },
  { key: 'algorithm', title: '算法细目', icon: 'binary', description: '具体算法与数据结构', match: function (tag) { return tag.category === 'algorithm' || (!tag.category && !appKnownColors.includes(tag.color) && tag.name !== '暂无评定'); } },
  { key: 'problem_type', title: '题目类型', icon: 'list-checks', description: '题目形式与评测类型', match: function (tag) { return tag.category === 'problem_type' || (!tag.category && tag.color === 'olive'); } },
  { key: 'difficulty', title: '难度', icon: 'gauge', description: '由入门到高阶的难度分级', match: function (tag) { return tag.category === 'difficulty' || (!tag.category && (['red', 'orange', 'yellow', 'green', 'blue', 'purple', 'black'].includes(tag.color) || tag.name === '暂无评定')); }, order: ['red', 'orange', 'yellow', 'green', 'blue', 'purple', 'black', ''] }
];
const appGroupedTags = appTagGroups.map(function (group) { return Object.assign({}, group, { items: [] }); });
const appOtherTags = [];
for (const tag of tags) { const group = appGroupedTags.find(function (candidate) { return candidate.match(tag); }); if (group) group.items.push(tag); else appOtherTags.push(tag); }
const appDifficulty = appGroupedTags.find(function (group) { return group.key === 'difficulty'; });
if (appDifficulty) appDifficulty.items.sort(function (a, b) { const ai = appDifficulty.order.indexOf(a.color); const bi = appDifficulty.order.indexOf(b.color); return ai === bi ? String(a.name).localeCompare(String(b.name), 'zh-CN') : ai - bi; });
function appTagUrl(tag) { const repository = { UOJ: 'uoj', HDU: 'hdu', POJ: 'poj' }[tag.name] || 'all'; return syzoj.utils.makeUrl(['problems', 'tag', tag.id], repository === 'all' ? {} : { repository: repository }); }
%>

<div class="app-page app-tags-page">
  <header class="app-page-header"><div class="app-page-heading"><span class="app-kicker">KNOWLEDGE MAP</span><h1 class="app-page-title">题目标签</h1><p class="app-page-description"><%= tags.length %> 个标签组成的知识索引，选择标签即可查看对应题目。</p></div><div class="app-page-actions"><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['problems']) %>"><i data-lucide="list-tree"></i>浏览题库</a></div></header>
  <div class="app-tag-directory"><% for (const group of appGroupedTags) { if (!group.items.length) continue; %><section><header><span><i data-lucide="<%= group.icon %>"></i></span><div><h2><%= group.title %></h2><p><%= group.description %></p></div><em><%= group.items.length %></em></header><div class="app-tag-cloud"><% for (const tag of group.items) { %><a href="<%= appTagUrl(tag) %>" data-tag-color="<%= tag.color || 'default' %>"><span><%= tag.name %></span><small><%= tag.problemCount || 0 %></small></a><% } %></div></section><% } %><% if (appOtherTags.length) { %><section><header><span><i data-lucide="shapes"></i></span><div><h2>其他标签</h2><p>尚未归入固定知识分类</p></div><em><%= appOtherTags.length %></em></header><div class="app-tag-cloud"><% for (const tag of appOtherTags) { %><a href="<%= appTagUrl(tag) %>" data-tag-color="<%= tag.color || 'default' %>"><span><%= tag.name %></span><small><%= tag.problemCount || 0 %></small></a><% } %></div></section><% } %></div>
</div>

<% include app_footer %>
