<% this.adminPage = 'notifications'; %>
<% include admin_header %>
<div class="app-admin-toolbar"><div><h3><%= notification.id ? '编辑通知' : '新建通知' %></h3><p>通知发布后会复制到所有未禁用用户的通知中心，已发布通知不可直接修改。</p></div><a class="app-button app-button-secondary" href="/admin/notifications"><i data-lucide="arrow-left"></i>返回列表</a></div>
<% const isPublished = notification.status === 'published'; %>
<form class="app-form" data-site-notification-editor data-notification-id="<%= notification.id || 0 %>" data-published="<%= isPublished ? '1' : '0' %>">
  <section class="app-settings-section"><div class="app-settings-copy"><span class="app-kicker">SITE NOTIFICATION</span><h2>通知内容</h2><p>通知与公开公告分离，支持 Markdown 和 @ 用户链接。<% if (isPublished) { %>此通知已发布，内容不可修改。<% } %></p></div><div class="app-settings-fields"><label class="app-field app-field-full"><span class="app-label">标题</span><input class="app-input" name="title" maxlength="255" required value="<%= notification.title || '' %>" placeholder="例如：今晚 22:00 评测服务维护"<%= isPublished ? ' disabled' : '' %>></label><label class="app-field app-field-full"><span class="app-label">内容</span><textarea class="app-textarea app-admin-editor" name="content" rows="12" required<%= isPublished ? ' disabled' : '' %>><%= notification.content || '' %></textarea></label><label class="app-field"><span class="app-label">级别</span><select class="app-select" name="level"<%= isPublished ? ' disabled' : '' %>><option value="info"<%= notification.level === 'info' ? ' selected' : '' %>>信息</option><option value="warning"<%= notification.level === 'warning' ? ' selected' : '' %>>提醒</option><option value="important"<%= notification.level === 'important' ? ' selected' : '' %>>重要</option></select></label></div></section>
  <div class="app-settings-submit"><a class="app-button app-button-secondary" href="/admin/notifications">取消</a><button class="app-button app-button-primary" type="submit"<%= isPublished ? ' disabled' : '' %>><i data-lucide="save"></i>保存通知</button><button class="app-button app-button-primary" type="button" data-notification-publish<%= notification.id && !isPublished ? '' : ' disabled' %>><i data-lucide="send"></i>发布通知</button></div>
</form>
<script>(function(){var form=document.querySelector('[data-site-notification-editor]');if(!form)return;var id=Number(form.dataset.notificationId||0),etag=<%- JSON.stringify(notificationEtag || '') %>;function key(){return window.crypto&&crypto.randomUUID?crypto.randomUUID():String(Date.now())+Math.random();}function msg(body,fallback){return body&&body.error&&body.error.message||fallback;}function data(){return {title:form.elements.title.value,content:form.elements.content.value,level:form.elements.level.value,if_match:etag};}async function save(publish){var headers={'Content-Type':'application/json','Idempotency-Key':key()};if(etag)headers['If-Match']=etag;var url='/api/v2/admin/notifications'+(id?'/'+id:'');var r=await fetch(url,{method:id?'PATCH':'POST',credentials:'same-origin',headers:headers,body:JSON.stringify(data())}),b=await r.json();if(!r.ok)throw new Error(msg(b,'通知保存失败。'));id=Number(b.data&&b.data.id||id);etag=r.headers.get('ETag')||b.meta&&b.meta.etag||etag;if(publish){var ph={'Content-Type':'application/json','Idempotency-Key':key(),'If-Match':etag};var pr=await fetch('/api/v2/admin/notifications/'+id+'/publish',{method:'POST',credentials:'same-origin',headers:ph,body:JSON.stringify({if_match:etag})}),pb=await pr.json();if(!pr.ok)throw new Error(msg(pb,'通知发布失败。'));}location.assign('/admin/notifications');}form.addEventListener('submit',function(e){e.preventDefault();save(false).catch(function(err){if(window.NWPUOJApp)window.NWPUOJApp.showToast(err.message,'danger');});});var publish=form.querySelector('[data-notification-publish]');if(publish)publish.addEventListener('click',function(){if(!window.confirm('发布后会发送给所有未禁用用户，确认发布吗？'))return;publish.disabled=true;save(true).catch(function(err){publish.disabled=false;if(window.NWPUOJApp)window.NWPUOJApp.showToast(err.message,'danger');});});})();</script>
<% include admin_footer %>
