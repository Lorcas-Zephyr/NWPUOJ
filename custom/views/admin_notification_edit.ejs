<% this.adminPage = 'notifications'; %>
<% include admin_header %>
<div class="app-admin-toolbar"><div><h3><%= notification.id ? '编辑通知' : '新建通知' %></h3><p>通知与公开公告分离，按发布范围进入用户通知中心。</p></div><a class="app-button app-button-secondary" href="/admin/notifications">返回列表</a></div>
<form class="app-form" data-site-notification-editor data-notification-id="<%= notification.id || 0 %>">
<section class="app-settings-section"><div class="app-settings-copy"><span class="app-kicker">SITE NOTIFICATION</span><h2>通知内容</h2><p>支持 Markdown 与 @ 用户链接；定向用户填写 UID。</p></div><div class="app-settings-fields">
<label class="app-field app-field-full"><span class="app-label">标题</span><input class="app-input" name="title" maxlength="255" required value="<%= notification.title || '' %>"></label>
<label class="app-field app-field-full"><span class="app-label">内容</span><textarea class="app-textarea app-admin-editor" name="content" rows="12" required><%= notification.content || '' %></textarea></label>
<label class="app-field"><span class="app-label">级别</span><select class="app-select" name="level"><option value="none">无级别</option><option value="info">信息</option><option value="warning">提醒</option><option value="important">重要</option><option value="urgent">紧急</option></select></label>
<label class="app-field"><span class="app-label">发送范围</span><select class="app-select" name="audience"><option value="all">全部用户</option><option value="participants">比赛参赛者</option><option value="users">指定用户</option></select></label>
<label class="app-field" data-audience-ref><span class="app-label">比赛 ID</span><input class="app-input" name="audience_ref" value="<%= notification.audience_ref || '' %>" placeholder="仅参赛者范围填写"></label>
<label class="app-field app-field-full" data-audience-users><span class="app-label">用户 UID（逗号或换行分隔）</span><textarea class="app-textarea" name="target_user_ids" rows="3" placeholder="例如：1001,1002"></textarea></label>
<label class="app-field"><span class="app-label">定时发布时间</span><input class="app-input" type="datetime-local" name="scheduled_at"></label>
<label class="app-field"><span class="app-label">显示选项</span><span class="app-check-row"><label><input type="checkbox" name="is_pinned"> 置顶</label><label><input type="checkbox" name="require_ack"> 要求确认阅读</label></span></label>
<label class="app-field"><span class="app-label">渲染选项</span><span class="app-check-row"><label><input type="checkbox" name="allow_markdown" checked> Markdown</label><label><input type="checkbox" name="allow_images" checked> 图片</label></span></label>
</div></section><div class="app-settings-submit"><a class="app-button app-button-secondary" href="/admin/notifications">取消</a><button class="app-button app-button-primary" type="submit">保存草稿</button><button class="app-button app-button-primary" type="button" data-notification-publish>发布通知</button></div></form>
<script>(function(){const f=document.querySelector('[data-site-notification-editor]');if(!f)return;const id=Number(f.dataset.notificationId||0);let etag=<%-JSON.stringify(notificationEtag||'')%>;const q=s=>f.querySelector('[name="'+s+'"]');const audience=q('audience'),ref=f.querySelector('[data-audience-ref]'),users=f.querySelector('[data-audience-users]');function toggle(){ref.hidden=audience.value!=='participants';users.hidden=audience.value!=='users'}audience.addEventListener('change',toggle);toggle();q('level').value=<%-JSON.stringify(notification.level||'none')%>;audience.value=<%-JSON.stringify(notification.audience||'all')%>;toggle();function key(){return crypto.randomUUID?crypto.randomUUID():String(Date.now())}function payload(){return{title:q('title').value,content:q('content').value,level:q('level').value,audience:audience.value,audience_ref:q('audience_ref').value,target_user_ids:q('target_user_ids').value,scheduled_at:q('scheduled_at').value||null,is_pinned:q('is_pinned').checked,require_ack:q('require_ack').checked,allow_markdown:q('allow_markdown').checked,allow_images:q('allow_images').checked,if_match:etag}}async function save(pub){const h={'Content-Type':'application/json','Idempotency-Key':key()};if(etag)h['If-Match']=etag;let r=await fetch('/api/v2/admin/notifications'+(id?'/'+id:''),{method:id?'PATCH':'POST',credentials:'same-origin',headers:h,body:JSON.stringify(payload())}),b=await r.json();if(!r.ok)throw Error(b.error&&b.error.message||'通知保存失败');const rid=b.data&&b.data.id||id;etag=r.headers.get('ETag')||(b.meta&&b.meta.etag)||etag;if(pub){h['If-Match']=etag;r=await fetch('/api/v2/admin/notifications/'+rid+'/publish',{method:'POST',credentials:'same-origin',headers:h,body:JSON.stringify({if_match:etag})});b=await r.json();if(!r.ok)throw Error(b.error&&b.error.message||'通知发布失败')}location.href='/admin/notifications'}f.addEventListener('submit',e=>{e.preventDefault();save(false).catch(e=>alert(e.message))});f.querySelector('[data-notification-publish]').addEventListener('click',()=>{if(confirm('确认发布此通知？'))save(true).catch(e=>alert(e.message))})})();</script>
<% include admin_footer %>
