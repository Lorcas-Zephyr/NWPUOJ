<% this.title = '排名' %>
<%
const isHitMode = curSort === 'hit';
function rankSortUrl(sort, defaultOrder) {
  const same = curSort === sort;
  const order = same ? (curOrder ? 'desc' : 'asc') : defaultOrder;
  return syzoj.utils.makeUrl(['ranklist'], { sort: sort, order: order });
}
%>
<% include app_header %>

<div class="app-page app-ranklist-page">
  <header class="app-page-header">
    <div class="app-page-heading">
      <span class="app-kicker">LEADERBOARD</span>
      <h1 class="app-page-title">排名</h1>
      <p class="app-page-description">从比赛表现和日常训练两个维度查看站内进度。</p>
    </div>
  </header>

  <div class="app-toolbar">
    <div class="app-toolbar-start">
      <div class="app-segmented" aria-label="排名模式">
        <a class="<%= !isHitMode ? 'is-active' : '' %>" aria-current="<%= !isHitMode ? 'page' : 'false' %>" href="<%= syzoj.utils.makeUrl(['ranklist']) %>">Rating</a>
        <a class="<%= isHitMode ? 'is-active' : '' %>" aria-current="<%= isHitMode ? 'page' : 'false' %>" href="<%= syzoj.utils.makeUrl(['ranklist'], { sort: 'hit', order: 'desc' }) %>">Hit 值</a>
      </div>
    </div>
    <form class="app-rank-search" action="<%= syzoj.utils.makeUrl(['find_user']) %>" method="get" role="search">
      <span class="app-input-wrap"><i data-lucide="search"></i><input class="app-input" name="nickname" placeholder="查找用户名" type="search"></span>
      <button class="app-button app-button-secondary" type="submit">查找</button>
    </form>
  </div>

  <div class="app-table-region" role="region" aria-label="用户排名" tabindex="0">
    <table class="app-table app-rank-table">
      <thead><tr>
        <th>名次</th>
        <th class="app-cell-primary"><a href="<%= rankSortUrl('username', 'asc') %>">用户<i data-lucide="arrow-up-down"></i></a></th>
        <th>个性签名</th>
        <th><a href="<%= rankSortUrl('ac_num', 'desc') %>">通过<i data-lucide="arrow-up-down"></i></a></th>
        <th><a href="<%= rankSortUrl(isHitMode ? 'hit' : 'rating', 'desc') %>"><%= isHitMode ? 'Hit 值' : 'Rating' %><i data-lucide="arrow-up-down"></i></a></th>
      </tr></thead>
      <tbody>
        <%
        let rankPosition = (paginate.currPage - 1) * paginate.perPage;
        for (const rankUser of ranklist) {
          rankPosition += 1;
          let hitValue = typeof rankUser.__hitTotal !== 'undefined' ? rankUser.__hitTotal : (syzoj.userHitScores && syzoj.userHitScores.has(rankUser.id) ? (syzoj.userHitScores.get(rankUser.id).total || 0) : 0);
          let hitTier = 'default';
          if (rankUser.is_admin || (syzoj.adminUserIds && syzoj.adminUserIds.has(rankUser.id))) hitTier = 'admin';
          else if (hitValue >= 350) hitTier = 'red';
          else if (hitValue >= 280) hitTier = 'orange';
          else if (hitValue >= 200) hitTier = 'green';
          else if (hitValue >= 100) hitTier = 'blue';
        %>
          <tr>
            <td class="app-cell-number"><span class="app-rank-position <%= rankPosition <= 3 ? 'is-top' : '' %>"><%= rankPosition %></span></td>
            <td class="app-cell-primary"><span class="app-user-cell"><img src="<%= syzoj.utils.avatar(rankUser, 32) %>" alt="" width="32" height="32"><span><%- syzoj.utils.renderUsername(rankUser) %></span></span></td>
            <td><div class="app-user-bio"><%- rankUser.information || '' %></div></td>
            <td class="app-cell-number"><%= rankUser.ac_num %></td>
            <td class="app-cell-number"><strong class="<%= isHitMode ? 'username-tier-' + hitTier : '' %>"><%= isHitMode ? hitValue : rankUser.rating %></strong></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% include app_pagination %>
</div>

<% include app_footer %>
