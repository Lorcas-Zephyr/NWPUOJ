<% this.adminPage = 'notifications'; %>
<% include admin_header %>
<div class="app-admin-toolbar"><div><h3>通知管理</h3><p>通知只会进入用户右上角的通知中心，不会出现在公开公告列表。</p></div><a class="app-button app-button-primary" href="/admin/notification/0/edit"><i data-lucide="plus"></i>新建通知</a></div>
<% if (notifications.length) { %><div class="app-table-region"><table class="app-table"><thead><tr><th>标题</th><th>级别</th><th>范围</th><th>状态</th><th>更新时间</th><th aria-label="操作"></th></tr></thead><tbody><% notifications.forEach(function (item) { const level = item.level === 'important' ? ['重要', 'app-status-rejected'] : item.level === 'warning' ? ['提醒', 'app-status-pending'] : ['信息', 'app-status-info']; const state = item.status === 'published' ? ['已发布', 'app-status-accepted'] : item.status === 'archived' ? ['已归档', 'app-status-muted'] : ['草稿', 'app-status-info']; %><tr><td class="app-cell-primary"><strong><%= item.title %></strong></td><td><span class="app-status <%= level[1] %>"><%= level[0] %></span></td><td>全站用户</td><td><span class="app-status <%= state[1] %>"><%= state[0] %></span></td><td><%= item.updated_at ? syzoj.utils.formatDate(new Date(item.updated_at).getTime() / 1000) : '-' %></td><td class="app-cell-actions"><a class="app-icon-button" href="/admin/notification/<%= item.id %>/edit" title="编辑通知" aria-label="编辑通知"><i data-lucide="square-pen"></i></a></td></tr><% }); %></tbody></table></div><% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="bell-off"></i><strong>暂无通知</strong><p>创建通知后，可保存草稿并发布到用户通知中心。</p></div></div><% } %>
<% include admin_footer %>
