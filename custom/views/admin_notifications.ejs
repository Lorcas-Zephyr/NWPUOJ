<% this.adminPage = 'notifications'; %>
<% include admin_header %>
<div class="app-admin-toolbar"><div><h3>通知管理</h3><p>手动通知与系统自动发送的通知统一显示在这里。</p></div><a class="app-button app-button-primary" href="/admin/notification/0/edit">新建通知</a></div>
<nav class="app-tabs" aria-label="通知来源筛选">
  <% [['all','全部'],['manual','手动通知'],['system','系统通知'],['rating','Rating 变化']].forEach(function(item) { %>
  <a class="app-tab<%= filter === item[0] ? ' is-active' : '' %>" href="/admin/notifications?filter=<%= item[0] %>"<%= filter === item[0] ? ' aria-current="page"' : '' %>><%= item[1] %></a>
  <% }); %>
</nav>
<% if (notifications.length) { %>
<div class="app-table-region"><table class="app-table app-admin-notifications-table"><thead><tr><th>标题/内容</th><th>来源</th><th>接收人/范围</th><th>状态</th><th>发送时间</th><th>已读人数</th><th>操作</th></tr></thead><tbody>
<% notifications.forEach(function(n){ if (n.origin === 'system') { %>
  <tr data-notification-origin="system">
    <td class="app-cell-primary"><strong><%= n.title %></strong><details><summary class="app-row-description">查看内容</summary><p class="app-admin-notification-content"><%= n.content || '无正文' %></p></details></td>
    <td><span class="app-status app-status-info"><%= n.type_label %></span></td>
    <td><% if (n.recipient_username) { %><a href="/user/<%= n.recipient_id %>"><%= n.recipient_username %></a><% } else { %>用户 #<%= n.recipient_id %>（已删除）<% } %></td>
    <td><span class="app-status <%= n.is_read ? 'app-status-muted' : 'app-status-pending' %>"><%= n.is_read ? '已读' : '未读' %></span></td>
    <td class="app-cell-number"><%= syzoj.utils.formatDate(new Date(n.published_at).getTime() / 1000) %></td>
    <td><%= n.is_read ? 1 : 0 %> / 1</td>
    <td class="app-cell-actions"><% if (n.source_url) { %><a class="app-button app-button-secondary" href="<%= n.source_url %>">查看来源</a><% } %></td>
  </tr>
<% } else { %>
  <tr data-notification-row="<%= n.id %>" data-etag="<%= n.etag %>">
    <td class="app-cell-primary"><strong><%= n.title %></strong></td><td><span class="app-status">手动通知</span></td>
    <td><%= n.audience==='all'?'全部用户':n.audience==='participants'?'比赛参赛者':'指定用户' %></td>
    <td><span class="app-status"><%= n.status==='published'?'已发布':n.status==='scheduled'?'待发布':n.status==='revoked'?'已撤回':n.status==='archived'?'已归档':'草稿' %></span></td>
    <td class="app-cell-number"><%= n.published_at || n.scheduled_at ? syzoj.utils.formatDate(new Date(n.published_at || n.scheduled_at).getTime() / 1000) : '-' %></td>
    <td><%= n.read_count %> / <%= n.recipient_count %></td>
    <td class="app-cell-actions"><div class="app-inline-actions">
      <a class="app-button app-button-secondary" href="/admin/notification/<%= n.id %>/edit">查看/编辑</a>
      <% if (n.status === 'draft') { %><button class="app-button app-button-primary" data-notification-action="publish">发布</button><button class="app-button app-button-danger" data-notification-action="delete">删除</button>
      <% } else if (n.status === 'scheduled') { %><button class="app-button app-button-primary" data-notification-action="publish">立即发布</button><button class="app-button app-button-secondary" data-notification-action="reopen">取消定时</button>
      <% } else if (n.status === 'published') { %><button class="app-button app-button-secondary" data-notification-action="revoke">撤回</button><button class="app-button app-button-secondary" data-notification-action="archive">归档</button>
      <% } else if (n.status === 'revoked') { %><button class="app-button app-button-secondary" data-notification-action="reopen">重新编辑</button><% } %>
    </div></td>
  </tr>
<% }}); %>
</tbody></table></div>
<% include app_pagination %>
<% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="bell-off"></i><strong>暂无通知</strong><p>当前筛选下没有通知记录。</p></div></div><% } %>
<script>
(function() {
  function key() { return window.crypto && window.crypto.randomUUID ? window.crypto.randomUUID() : String(Date.now()) + '-' + Math.random().toString(36).slice(2); }
  document.addEventListener('click', async function(event) {
    const button = event.target.closest('[data-notification-action]');
    if (!button || button.disabled) return;
    const row = button.closest('[data-notification-row]');
    if (!row || row.dataset.busy === '1') return;
    const id = row.dataset.notificationRow, action = button.dataset.notificationAction;
    if (!confirm('确认执行此通知操作？')) return;
    row.dataset.busy = '1';
    button.disabled = true;
    try {
      const response = await fetch('/api/v2/admin/notifications/' + encodeURIComponent(id) + (action === 'delete' ? '' : '/' + action), {
        method: action === 'delete' ? 'DELETE' : 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'Idempotency-Key': key(), 'If-Match': row.dataset.etag },
        body: JSON.stringify({ if_match: row.dataset.etag })
      });
      const body = await response.json();
      if (!response.ok) throw Error(body.error && body.error.message || '通知操作失败');
      location.reload();
    } catch(error) {
      row.dataset.busy = '0';
      button.disabled = false;
      if (window.NWPUOJApp) window.NWPUOJApp.showToast(error.message, 'danger');
    }
  });
})();
</script>
<% include admin_footer %>
