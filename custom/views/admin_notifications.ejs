<% this.adminPage = 'notifications'; %>
<% include admin_header %>
<div class="app-admin-toolbar"><div><h3>通知管理</h3><p>通知只进入用户通知中心，不会混入公开公告。</p></div><a class="app-button app-button-primary" href="/admin/notification/0/edit">新建通知</a></div>
<div class="app-table-region"><table class="app-table"><thead><tr><th>标题</th><th>范围</th><th>状态</th><th>发布时间</th><th>操作</th></tr></thead><tbody><% notifications.forEach(function(n){ %><tr data-notification-row="<%= n.id %>" data-etag="<%= n.etag %>"><td class="app-cell-primary"><strong><%= n.title %></strong></td><td><%= n.audience==='all'?'全部用户':n.audience==='participants'?'比赛参赛者':'指定用户' %></td><td><span class="app-status"><%= n.status==='published'?'已发布':n.status==='scheduled'?'待发布':n.status==='revoked'?'已撤回':n.status==='archived'?'已归档':'草稿' %></span></td><td><%= n.published_at || n.scheduled_at || '-' %></td><td class="app-cell-actions"><a class="app-button app-button-secondary" href="/admin/notification/<%= n.id %>/edit">查看/编辑</a><% if (n.status === 'draft') { %><button class="app-button app-button-primary" data-notification-action="publish">发布</button><button class="app-button app-button-danger" data-notification-action="delete">删除</button><% } else if (n.status === 'scheduled') { %><button class="app-button app-button-primary" data-notification-action="publish">立即发布</button><button class="app-button app-button-secondary" data-notification-action="reopen">取消定时</button><% } else if (n.status === 'published') { %><button class="app-button app-button-secondary" data-notification-action="revoke">撤回</button><button class="app-button app-button-secondary" data-notification-action="archive">归档</button><% } else if (n.status === 'revoked') { %><button class="app-button app-button-secondary" data-notification-action="reopen">重新编辑</button><% } %></td></tr><% }); %></tbody></table></div>
<script>(function(){function key(){return crypto.randomUUID?crypto.randomUUID():String(Date.now())+'-'+Math.random().toString(36).slice(2)}document.addEventListener('click',async function(e){const b=e.target.closest('[data-notification-action]');if(!b)return;const row=b.closest('[data-notification-row]'),id=row.dataset.notificationRow,action=b.dataset.notificationAction;if(!confirm('确认执行此通知操作？'))return;b.disabled=true;const h={'Content-Type':'application/json','Idempotency-Key':key(),'If-Match':row.dataset.etag};try{const r=await fetch('/api/v2/admin/notifications/'+id+'/'+action,{method:action==='delete'?'DELETE':'POST',credentials:'same-origin',headers:h,body:JSON.stringify({if_match:row.dataset.etag})});const body=await r.json();if(!r.ok)throw Error(body.error&&body.error.message||'通知操作失败');location.reload()}catch(err){b.disabled=false;if(window.NWPUOJApp)window.NWPUOJApp.showToast(err.message,'danger')}}})})();</script>
<% include admin_footer %>
