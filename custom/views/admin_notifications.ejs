<% this.adminPage = 'notifications'; %>
<% include admin_header %>
<div class="app-admin-toolbar"><div><h3>通知管理</h3><p>通知只进入用户通知中心，不会混入公开公告。</p></div><a class="app-button app-button-primary" href="/admin/notification/0/edit">新建通知</a></div>
<div class="app-table-region"><table class="app-table"><thead><tr><th>标题</th><th>范围</th><th>状态</th><th>发布时间</th><th>操作</th></tr></thead><tbody><% notifications.forEach(function(n){ %><tr><td class="app-cell-primary"><strong><%= n.title %></strong></td><td><%= n.audience==='all'?'全部用户':n.audience==='participants'?'比赛参赛者':'指定用户' %></td><td><span class="app-status"><%= n.status==='published'?'已发布':n.status==='scheduled'?'已定时':n.status==='revoked'?'已撤回':n.status==='archived'?'已归档':'草稿' %></span></td><td><%= n.published_at || n.scheduled_at || '-' %></td><td><a class="app-button app-button-secondary" href="/admin/notification/<%= n.id %>/edit">查看/编辑</a></td></tr><% }); %></tbody></table></div>
<% include admin_footer %>
