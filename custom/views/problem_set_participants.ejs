<% this.title='报名管理 - '+problemSet.title; const problemSetActiveSection='participants'; const problemSetAccess={manager:true}; %>
<% include app_header %><% include problem_set_context %>
<div class="app-page app-problem-set-participants-page">
  <section class="app-temp-account-section"><div><span class="app-kicker">ORDINARY ACCOUNTS</span><h2>添加普通账户</h2><p>可搜索用户名、UID、学号或姓名；也可以按 CSV 或班级批量添加。</p></div><div class="app-form app-participant-imports"><form class="app-inline-form app-user-picker-form" data-set-participant-add><div class="app-entity-picker" data-user-picker data-endpoint="/api/v2/search/users/__QUERY__?ordinary=1"><span class="app-input-wrap"><i data-lucide="search"></i><input class="app-input" type="search" data-user-search placeholder="用户名、UID、学号或姓名" autocomplete="off"></span><div class="app-entity-results" data-user-results hidden></div><div class="app-contest-account-state" data-user-state>输入用户名、UID、学号或姓名进行搜索。</div><input type="hidden" name="user_id" data-user-id></div><button class="app-button app-button-primary" type="submit" data-user-submit disabled><i data-lucide="user-plus"></i>添加</button></form><form class="app-inline-form" enctype="multipart/form-data" data-set-participant-import><label class="app-file-field"><input type="file" name="student_ids_csv" accept=".csv,text/csv" required><span><i data-lucide="file-spreadsheet"></i><strong>选择学号 CSV</strong></span></label><button class="app-button app-button-secondary" type="submit"><i data-lucide="upload"></i>批量导入</button></form></div></section>
  <% if(registrationClassOptions.length){%><section class="app-temp-account-section"><div><span class="app-kicker">CLASS IMPORT</span><h2>按班级添加</h2><p>先搜索班级，再选择一个或多个班级导入成员。</p></div><form class="app-form" data-set-class-import><div class="app-entity-picker app-class-picker" data-class-picker><span class="app-input-wrap"><i data-lucide="search"></i><input class="app-input" type="search" data-class-search placeholder="搜索班级名称" autocomplete="off"></span><div class="app-entity-results" data-class-results hidden></div><div class="app-entity-selected" data-class-selected></div></div><div class="app-form-actions"><button class="app-button app-button-primary" type="submit"><i data-lucide="users-round"></i>按班级添加</button></div></form></section><%}%>
  <section class="app-section"><div class="app-section-header"><div><h2 class="app-section-title">报名名单</h2><p class="app-section-description"><%= problemSet.allow_registration?'允许用户自行报名':'仅限管理员添加' %></p></div><span class="app-page-count"><strong><%= participants.length %></strong> 人</span></div><% if(participants.length){%><div class="app-table-region"><table class="app-table"><thead><tr><th>用户名</th><th>姓名</th><th>学号</th><th>学院</th><th>来源</th><th aria-label="操作"></th></tr></thead><tbody><% participants.forEach(function(item){%><tr><td><%- syzoj.utils.renderUsername({id:item.user_id,username:item.username}) %></td><td><%= item.real_name||'-' %></td><td><%= item.student_id||'-' %></td><td><%= item.college||'-' %></td><td><%= ({self:'自行报名',managed:'管理员',csv:'CSV',class:'班级'})[item.source]||item.source %></td><td class="app-cell-actions"><button class="app-icon-button app-icon-danger" type="button" data-set-participant-remove="<%= item.user_id %>" title="移出报名" aria-label="移出报名"><i data-lucide="user-minus"></i></button></td></tr><%});%></tbody></table></div><%}else{%><div class="app-empty app-empty-compact"><div class="app-empty-inner"><i data-lucide="users-round"></i><strong>暂无报名用户</strong></div></div><%}%></section>
</div>
<script>(function(){var base='/api/v2/problem-sets/<%= problemSet.id %>/participants';async function request(url,options){var response=await fetch(url,Object.assign({credentials:'same-origin'},options||{}));var body=await response.json().catch(function(){return null;});if(!response.ok)throw new Error(body&&body.error&&body.error.message||'操作失败。');return body.data;}function fail(error){if(window.NWPUOJApp)window.NWPUOJApp.showToast(error.message,'danger');}function setupUserPicker(form){var picker=form.querySelector('[data-user-picker]'),input=picker.querySelector('[data-user-search]'),results=picker.querySelector('[data-user-results]'),state=picker.querySelector('[data-user-state]'),hidden=picker.querySelector('[data-user-id]'),submit=form.querySelector('[data-user-submit]'),timer,version=0;function setState(text,error){state.textContent=text;state.hidden=false;state.classList.toggle('is-error',!!error);}function label(account){var bits=[account.name||account.username||('#'+account.value)];if(account.real_name)bits.push(account.real_name);if(account.student_id)bits.push(account.student_id);return bits.join(' · ');}input.addEventListener('input',function(){hidden.value='';submit.disabled=true;clearTimeout(timer);var query=input.value.trim(),current=++version;results.innerHTML='';results.hidden=true;if(!/^\d+$/.test(query)&&query.length<2){setState('输入用户名、UID、学号或姓名进行搜索。',false);return;}setState('正在搜索...',false);timer=setTimeout(async function(){try{var response=await fetch('/api/v2/search/users/'+encodeURIComponent(query)+'?ordinary=1',{credentials:'same-origin',cache:'no-store'}),body=await response.json();if(current!==version)return;var items=body.results||body.data||body||[];if(!Array.isArray(items)||!items.length){setState('没有可添加的普通账户。',false);return;}items.forEach(function(account){var button=document.createElement('button');button.type='button';button.textContent=label(account);button.title=label(account);button.addEventListener('click',function(){hidden.value=String(account.value);input.value=label(account);results.hidden=true;setState('已选择 '+label(account),false);submit.disabled=false;});results.appendChild(button);});results.hidden=false;setState('',false);state.hidden=true;}catch(error){if(current===version)setState('普通账户搜索失败。',true);}},220);});form.addEventListener('submit',function(event){event.preventDefault();if(!hidden.value){setState('请先从搜索结果中选择账户。',true);return;}submit.disabled=true;request(base,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({user_id:Number(hidden.value)})}).then(function(){location.reload();}).catch(function(error){submit.disabled=false;fail(error);});});}var add=document.querySelector('[data-set-participant-add]');if(add)setupUserPicker(add);var importer=document.querySelector('[data-set-participant-import]');if(importer)importer.addEventListener('submit',function(event){event.preventDefault();request(base+'/import',{method:'POST',body:new FormData(importer)}).then(function(result){if(window.NWPUOJApp)window.NWPUOJApp.showToast('已添加 '+result.added_count+' 人。','success');setTimeout(function(){location.reload();},500);}).catch(fail);});var classForm=document.querySelector('[data-set-class-import]');if(classForm){var classPicker=classForm.querySelector('[data-class-picker]'),classInput=classPicker.querySelector('[data-class-search]'),classResults=classPicker.querySelector('[data-class-results]'),classSelected=classPicker.querySelector('[data-class-selected]'),classOptions=<%- JSON.stringify(registrationClassOptions.map(function(group){return {id:Number(group.id),name:group.name,member_count:Number(group.member_count||0),tag_text:group.tag_text||''};})) %>,selectedIds=new Set();function renderClasses(){classResults.innerHTML='';var query=classInput.value.trim().toLowerCase();classOptions.filter(function(group){return group.name.toLowerCase().includes(query)&&!selectedIds.has(group.id);}).forEach(function(group){var button=document.createElement('button');button.type='button';button.textContent=group.name+' · '+group.member_count+' 人';button.title=group.name+' · '+group.tag_text;button.addEventListener('click',function(){selectedIds.add(group.id);var chip=document.createElement('span');chip.dataset.classValue=String(group.id);var hiddenClass=document.createElement('input');hiddenClass.type='hidden';hiddenClass.name='class_ids';hiddenClass.value=String(group.id);var classLabel=document.createElement('em');classLabel.textContent=group.name;var removeClass=document.createElement('button');removeClass.type='button';removeClass.dataset.classRemove='';removeClass.setAttribute('aria-label','移除班级');removeClass.innerHTML='<i data-lucide="x"></i>';chip.appendChild(hiddenClass);chip.appendChild(classLabel);chip.appendChild(removeClass);classSelected.appendChild(chip);classInput.value='';classResults.hidden=true;if(window.NWPUOJApp)window.NWPUOJApp.refreshIcons(chip);});classResults.appendChild(button);});if(!classResults.children.length){var empty=document.createElement('span');empty.textContent=query?'没有匹配的班级':'输入名称搜索班级';classResults.appendChild(empty);}classResults.hidden=false;}classInput.addEventListener('input',renderClasses);classPicker.addEventListener('click',function(event){var remove=event.target.closest('[data-class-remove]');if(remove){var chip=remove.closest('[data-class-value]');selectedIds.delete(Number(chip.dataset.classValue));chip.remove();}});document.addEventListener('click',function(event){if(!classPicker.contains(event.target))classResults.hidden=true;});classForm.addEventListener('submit',function(event){event.preventDefault();var ids=Array.from(selectedIds);if(!ids.length){fail(new Error('请至少选择一个班级。'));return;}request(base+'/import-class',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({class_ids:ids})}).then(function(result){if(window.NWPUOJApp)window.NWPUOJApp.showToast('已添加 '+result.added_count+' 人。','success');setTimeout(function(){location.reload();},500);}).catch(fail);});}document.querySelectorAll('[data-set-participant-remove]').forEach(function(button){button.addEventListener('click',function(){if(!confirm('确定移出该用户吗？'))return;request(base+'/'+button.dataset.setParticipantRemove,{method:'DELETE'}).then(function(){location.reload();}).catch(fail);});});})();</script>
<% include app_footer %>
