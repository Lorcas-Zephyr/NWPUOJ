<% this.title = classGroup.name + ' - 班级管理' %>
<% include app_header %>
<div class="app-page app-class-page">
  <header class="app-page-header"><div class="app-page-heading"><a class="app-back-link" href="/classes"><i data-lucide="arrow-left"></i>返回班级</a><span class="app-kicker">CLASS MANAGEMENT</span><h1 class="app-page-title"><%= classGroup.name %></h1><p class="app-page-description"><span class="user-name-tag tag-tier-blue"><%= classGroup.tag_text %></span> · <%= members.length %> 名成员</p></div><div class="app-page-actions"><button class="app-button app-button-secondary" type="button" data-dialog-open="class-edit-dialog"><i data-lucide="settings"></i>班级设置</button></div></header>
  <section class="app-temp-account-section"><div><span class="app-kicker">MEMBERS</span><h2>添加普通账户</h2><p>搜索用户名、UID、学号或姓名；也可以上传仅含“学号”列的 UTF-8 CSV。</p></div><div class="app-form app-class-member-tools"><form class="app-inline-form app-user-picker-form" data-class-member-add><div class="app-entity-picker" data-user-picker data-endpoint="/api/v2/search/users/__QUERY__?ordinary=1"><span class="app-input-wrap"><i data-lucide="search"></i><input class="app-input" type="search" data-user-search placeholder="用户名、UID、学号或姓名" autocomplete="off"></span><div class="app-entity-results" data-user-results hidden></div><div class="app-contest-account-state" data-user-state>输入用户名、UID、学号或姓名进行搜索。</div><input type="hidden" name="user_id" data-user-id></div><button class="app-button app-button-primary" type="submit" data-user-submit disabled><i data-lucide="user-plus"></i>添加</button></form><form class="app-inline-form" enctype="multipart/form-data" data-class-member-import><label class="app-file-field"><input type="file" name="student_ids_csv" accept=".csv,text/csv" required><span><i data-lucide="file-spreadsheet"></i><strong>选择学号 CSV</strong></span></label><button class="app-button app-button-secondary" type="submit"><i data-lucide="upload"></i>批量导入</button></form></div></section>
  <section class="app-section"><div class="app-section-header"><div><h2 class="app-section-title">班级成员</h2><p class="app-section-description">成员会在用户名旁显示班级标签</p></div><span class="app-page-count"><strong><%= members.length %></strong> 人</span></div><% if(members.length){%><div class="app-table-region"><table class="app-table"><thead><tr><th>用户名</th><th>姓名</th><th>学号</th><th>学院</th><th aria-label="操作"></th></tr></thead><tbody><% members.forEach(function(member){%><tr><td><%- syzoj.utils.renderUsername({id:member.user_id,username:member.username}) %></td><td><%= member.real_name || '-' %></td><td><%= member.student_id || '-' %></td><td><%= member.college || '-' %></td><td class="app-cell-actions"><button class="app-icon-button app-icon-danger" type="button" data-class-member-remove="<%= member.user_id %>" title="移出班级" aria-label="移出班级"><i data-lucide="user-minus"></i></button></td></tr><%});%></tbody></table></div><%}else{%><div class="app-empty app-empty-compact"><div class="app-empty-inner"><i data-lucide="users-round"></i><strong>暂无成员</strong><p>按学号添加已注册的普通账户。</p></div></div><%}%></section>
</div>
<dialog class="app-dialog" id="class-edit-dialog"><form class="app-form" data-class-edit><div class="app-dialog-header"><h2>班级设置</h2><button class="app-icon-button" type="button" data-dialog-close aria-label="关闭"><i data-lucide="x"></i></button></div><div class="app-dialog-body"><label class="app-field"><span class="app-label">班级名称</span><input class="app-input" name="name" maxlength="80" value="<%= classGroup.name %>" required></label><label class="app-field"><span class="app-label">用户名标签</span><input class="app-input" name="tag_text" maxlength="12" value="<%= classGroup.tag_text %>" required></label><label class="app-setting-row"><span><strong>允许用于活动报名</strong></span><input class="app-switch" type="checkbox" name="allow_activity_import"<%= classGroup.allow_activity_import ? ' checked' : '' %>></label></div><div class="app-dialog-actions"><button class="app-button app-button-danger-outline" type="button" data-class-archive><i data-lucide="archive"></i>归档</button><button class="app-button app-button-primary" type="submit"><i data-lucide="save"></i>保存</button></div></form></dialog>
<script>(function(){var base='/api/v2/classes/<%= classGroup.id %>';async function request(url,options){var response=await fetch(url,Object.assign({credentials:'same-origin'},options||{}));var body=await response.json().catch(function(){return null;});if(!response.ok)throw new Error(body&&body.error&&body.error.message||'操作失败。');return body&&body.data;}function fail(error){if(window.NWPUOJApp)window.NWPUOJApp.showToast(error.message,'danger');}var add=document.querySelector('[data-class-member-add]');if(add){var picker=add.querySelector('[data-user-picker]'),input=picker.querySelector('[data-user-search]'),results=picker.querySelector('[data-user-results]'),state=picker.querySelector('[data-user-state]'),hidden=picker.querySelector('[data-user-id]'),submit=add.querySelector('[data-user-submit]'),timer,version=0;function label(account){var bits=[account.name||account.username||('#'+account.value)];if(account.real_name)bits.push(account.real_name);if(account.student_id)bits.push(account.student_id);return bits.join(' · ');}function setState(text,error){state.textContent=text;state.hidden=!text;state.classList.toggle('is-error',!!error);}input.addEventListener('input',function(){hidden.value='';submit.disabled=true;clearTimeout(timer);var query=input.value.trim(),current=++version;results.innerHTML='';results.hidden=true;if(!/^\d+$/.test(query)&&query.length<2){setState('输入用户名、UID、学号或姓名进行搜索。',false);return;}setState('正在搜索...',false);timer=setTimeout(async function(){try{var response=await fetch('/api/v2/search/users/'+encodeURIComponent(query)+'?ordinary=1',{credentials:'same-origin',cache:'no-store'}),body=await response.json();if(current!==version)return;var items=body.results||body.data||body||[];if(!Array.isArray(items)||!items.length){setState('没有可添加的普通账户。',false);return;}items.forEach(function(account){var button=document.createElement('button');button.type='button';button.textContent=label(account);button.title=label(account);button.addEventListener('click',function(){hidden.value=String(account.value);input.value=label(account);results.hidden=true;setState('已选择 '+label(account),false);submit.disabled=false;});results.appendChild(button);});results.hidden=false;setState('',false);}catch(error){if(current===version)setState('普通账户搜索失败。',true);}},220);});add.addEventListener('submit',function(event){event.preventDefault();if(!hidden.value){setState('请先从搜索结果中选择账户。',true);return;}submit.disabled=true;request(base+'/members',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({user_id:Number(hidden.value)})}).then(function(){location.reload();}).catch(function(error){submit.disabled=false;fail(error);});});}var importer=document.querySelector('[data-class-member-import]');if(importer)importer.addEventListener('submit',function(event){event.preventDefault();request(base+'/members/import',{method:'POST',body:new FormData(importer)}).then(function(result){if(window.NWPUOJApp)window.NWPUOJApp.showToast('已添加 '+result.added_count+' 人。','success');setTimeout(function(){location.reload();},500);}).catch(fail);});document.querySelectorAll('[data-class-member-remove]').forEach(function(button){button.addEventListener('click',function(){if(!confirm('确定将该用户移出班级吗？'))return;request(base+'/members/'+button.dataset.classMemberRemove,{method:'DELETE'}).then(function(){location.reload();}).catch(fail);});});var edit=document.querySelector('[data-class-edit]');edit.addEventListener('submit',function(event){event.preventDefault();var data=new FormData(edit);request(base,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:data.get('name'),tag_text:data.get('tag_text'),allow_activity_import:data.get('allow_activity_import')==='on'})}).then(function(){location.reload();}).catch(fail);});document.querySelector('[data-class-archive]').addEventListener('click',function(){if(!confirm('确定归档该班级吗？'))return;request(base,{method:'DELETE'}).then(function(){location.assign('/classes');}).catch(fail);});})();</script>
<% include app_footer %>
