<% this.title = '题目导入完成'; %>
<% include header %>
<div class="padding">
  <div class="ui positive message"><div class="header">已导入 <%= imported.length %> 道题目</div></div>
  <div class="nwpuoj-table-region" role="region" aria-label="导入结果" tabindex="0">
    <table class="ui very basic table">
      <thead><tr><th>编号</th><th>题目</th><th>状态</th></tr></thead>
      <tbody><% imported.forEach(function (problem) { %>
        <tr>
          <td><%= problem.getDisplayId() %></td>
          <td><a href="<%= syzoj.utils.makeUrl(['problem', problem.id]) %>"><%= problem.title %></a></td>
          <td><span class="nwpuoj-status <%= problem.is_public ? 'nwpuoj-status-success' : 'nwpuoj-status-muted' %>"><%= problem.is_public ? '已公开' : '未公开' %></span></td>
        </tr>
      <% }); %></tbody>
    </table>
  </div>
  <div class="nwpuoj-editor-actions">
    <a class="ui primary labeled icon button" href="<%= syzoj.utils.makeUrl(['problems'], { repository: 'main' }) %>"><i class="list icon"></i>返回主题库</a>
    <a class="ui basic labeled icon button" href="<%= syzoj.utils.makeUrl(['problem', 0, 'import']) %>"><i class="upload icon"></i>继续导入</a>
  </div>
</div>
<% include footer %>
