<% this.title = problemSet ? '编辑题单 - ' + problemSet.title : '创建题单' %>
<% include app_header %>
<div class="app-page app-problem-set-edit-page">
  <header class="app-page-header"><div class="app-page-heading"><a class="app-back-link" href="<%= problemSet?'/problem-set/'+problemSet.id:'/problem-sets' %>"><i data-lucide="arrow-left"></i>返回</a><span class="app-kicker">PROBLEM SET MANAGEMENT</span><h1 class="app-page-title"><%= problemSet?'编辑题单':'创建题单' %></h1><p class="app-page-description">设置题目、报名方式、截止时间和榜单赛制。</p></div></header>
  <form class="app-form app-problem-set-editor" data-problem-set-editor data-set-id="<%= problemSet?problemSet.id:'' %>" data-set-etag="<%= typeof problemSetEtag !== 'undefined' ? problemSetEtag : '' %>">
    <section class="app-settings-section"><div class="app-settings-copy"><span class="app-kicker">BASIC</span><h2>基本信息</h2><p>标题和说明会展示给参与者。</p></div><div class="app-settings-fields"><label class="app-field"><span class="app-label">题单标题</span><input class="app-input" name="title" maxlength="160" value="<%= problemSet?problemSet.title:'' %>" required></label><label class="app-field"><span class="app-label">题单说明</span><textarea class="app-textarea" name="description" rows="8"><%= problemSet?problemSet.description:'' %></textarea></label></div></section>
    <section class="app-settings-section"><div class="app-settings-copy"><span class="app-kicker">SCHEDULE</span><h2>期限与报名</h2><p>不设置截止时间即为无限期题单。</p></div><div class="app-settings-fields"><label class="app-setting-row"><span><strong>设置截止时间</strong><small>关闭后题单无限期开放。</small></span><input class="app-switch" type="checkbox" data-deadline-toggle<%= problemSet&&problemSet.deadline_at?' checked':'' %>></label><label class="app-field" data-deadline-field<%= problemSet&&problemSet.deadline_at?'':' hidden' %>><span class="app-label">截止时间</span><input class="app-input" type="datetime-local" name="deadline_at" step="60" value="<%= problemSet&&problemSet.deadline_at?new Date(Number(problemSet.deadline_at)*1000).toISOString().slice(0,16):'' %>"></label><label class="app-setting-row"><span><strong>允许自行报名</strong><small>关闭后仅可由管理员按学号、CSV 或班级添加。</small></span><input class="app-switch" type="checkbox" name="allow_registration"<%= !problemSet||problemSet.allow_registration?' checked':'' %>></label><div class="app-form-grid"><label class="app-field app-field-half"><span class="app-label">榜单赛制</span><select class="app-select" name="ranking_mode"><% [['acm','ACM'],['ioi','IOI'],['noi','NOI']].forEach(function(option){%><option value="<%= option[0] %>"<%= problemSet&&problemSet.ranking_mode===option[0]?' selected':'' %>><%= option[1] %></option><%});%></select></label><label class="app-field app-field-half"><span class="app-label">可见范围</span><select class="app-select" name="visibility"><option value="private"<%= !problemSet||problemSet.visibility==='private'?' selected':'' %>>隐藏</option><option value="public"<%= problemSet&&problemSet.visibility==='public'?' selected':'' %>>公开</option></select></label></div><label class="app-field"><span class="app-label">状态</span><select class="app-select" name="status"><option value="draft"<%= !problemSet||problemSet.status==='draft'?' selected':'' %>>草稿</option><option value="published"<%= problemSet&&problemSet.status==='published'?' selected':'' %>>发布</option></select></label></div></section>
    <section class="app-settings-section"><div class="app-settings-copy"><span class="app-kicker">PROBLEMS</span><h2>题目顺序</h2><p>搜索题号或最新标题后添加，使用箭头调整顺序。</p></div><div class="app-settings-fields"><div class="app-entity-picker" data-problem-picker data-endpoint="/api/v2/search/problems/__QUERY__" data-placeholder="输入题号或标题"><div class="app-set-problem-list app-entity-selected" data-problem-selected><% problemSetItems.forEach(function(item){%><div class="app-set-problem-row" data-problem-row data-problem-value="<%= item.problem_id %>" data-problem-id="<%= item.problem_id %>"><span class="app-drag-handle"><i data-lucide="grip-vertical"></i></span><input type="hidden" name="problem_ids" value="<%= item.problem_id %>"><strong>#<%= item.problem_id %></strong><span><%= item.title %></span><button class="app-icon-button" type="button" data-move="up" title="上移" aria-label="上移"><i data-lucide="arrow-up"></i></button><button class="app-icon-button" type="button" data-move="down" title="下移" aria-label="下移"><i data-lucide="arrow-down"></i></button><button class="app-icon-button app-icon-danger" type="button" data-problem-remove title="移除" aria-label="移除"><i data-lucide="x"></i></button></div><%});%></div><span class="app-input-wrap"><i data-lucide="search"></i><input class="app-input" type="search" data-problem-search placeholder="输入题号或标题添加试题" autocomplete="off"></span><div class="app-entity-results" data-problem-results hidden></div></div></div></section>
    <div class="app-settings-submit"><% if(problemSet){%><button class="app-button app-button-danger-outline" type="button" data-problem-set-archive><i data-lucide="archive"></i>归档题单</button><%}%><a class="app-button app-button-quiet" href="<%= problemSet?'/problem-set/'+problemSet.id:'/problem-sets' %>">取消</a><button class="app-button app-button-primary" type="submit"><i data-lucide="save"></i>保存题单</button></div>
  </form>
</div>
<script>(function(){var form=document.querySelector('[data-problem-set-editor]'),picker=form.querySelector('[data-problem-picker]'),list=picker.querySelector('[data-problem-selected]'),input=picker.querySelector('[data-problem-search]'),results=picker.querySelector('[data-problem-results]'),toggle=form.querySelector('[data-deadline-toggle]'),field=form.querySelector('[data-deadline-field]');toggle.addEventListener('change',function(){field.hidden=!toggle.checked;if(!toggle.checked)field.querySelector('input').value='';});function values(){return Array.prototype.map.call(list.querySelectorAll('[data-problem-row]'),function(item){return Number(item.dataset.problemId);}).filter(function(id){return Number.isInteger(id)&&id>0;});}function syncSelected(){if(window.NWPUOJApp)window.NWPUOJApp.refreshIcons(list);}function add(id,title){if(values().includes(id))return;title=String(title||'').replace(new RegExp('^#?'+id+'\\.\\s*'),'');var div=document.createElement('div');div.className='app-set-problem-row';div.dataset.problemRow='';div.dataset.problemValue=String(id);div.dataset.problemId=String(id);div.innerHTML='<span class="app-drag-handle"><i data-lucide="grip-vertical"></i></span><input type="hidden" name="problem_ids" value="'+id+'"><strong>#'+id+'</strong><span></span><button class="app-icon-button" type="button" data-move="up" title="上移" aria-label="上移"><i data-lucide="arrow-up"></i></button><button class="app-icon-button" type="button" data-move="down" title="下移" aria-label="下移"><i data-lucide="arrow-down"></i></button><button class="app-icon-button app-icon-danger" type="button" data-problem-remove title="移除" aria-label="移除"><i data-lucide="x"></i></button>';div.querySelector('span:not(.app-drag-handle)').textContent=title||'保存时读取最新标题';list.appendChild(div);input.value='';results.hidden=true;syncSelected();}picker.addEventListener('click',function(event){var remove=event.target.closest('[data-problem-remove]');if(remove){var row=remove.closest('[data-problem-row]');if(row){row.remove();syncSelected();}}});list.addEventListener('click',function(event){var current=event.target.closest('[data-problem-row]');if(!current)return;if(event.target.closest('[data-problem-remove]')){current.remove();syncSelected();}else if(event.target.closest('[data-move="up"]')&&current.previousElementSibling){list.insertBefore(current,current.previousElementSibling);syncSelected();}else if(event.target.closest('[data-move="down"]')&&current.nextElementSibling){list.insertBefore(current.nextElementSibling,current);syncSelected();}});var timer,controller;input.addEventListener('input',function(){clearTimeout(timer);if(controller)controller.abort();var query=input.value.trim();if(!query){results.hidden=true;return;}timer=setTimeout(async function(){controller=new AbortController();try{var response=await fetch(picker.dataset.endpoint.replace('__QUERY__',encodeURIComponent(query)),{credentials:'same-origin',cache:'no-store',signal:controller.signal}),body=await response.json(),items=body.results||body.data||body||[];results.innerHTML='';(Array.isArray(items)?items:[]).forEach(function(item){var id=Number(item.value!=null?item.value:item.id),label=String(item.name||item.title||('#'+id));if(!Number.isInteger(id)||id<1||values().includes(id))return;var button=document.createElement('button');button.type='button';button.textContent=label;button.title=label;button.addEventListener('click',function(){add(id,label);});results.appendChild(button);});if(!results.children.length){var empty=document.createElement('span');empty.textContent='没有可添加的结果';results.appendChild(empty);}results.hidden=false;}catch(error){if(error.name!=='AbortError')results.hidden=true;}},220);});document.addEventListener('click',function(event){if(!picker.contains(event.target))results.hidden=true;});syncSelected();async function request(url,options){var response=await fetch(url,Object.assign({credentials:'same-origin'},options));var body=await response.json().catch(function(){return null;});if(!response.ok)throw new Error(body&&body.error&&body.error.message||'保存失败。');return body.data;}form.addEventListener('submit',async function(event){event.preventDefault();var data=new FormData(form);var payload={title:data.get('title'),description:data.get('description'),deadline_at:toggle.checked?data.get('deadline_at'):'',allow_registration:data.get('allow_registration')==='on',ranking_mode:data.get('ranking_mode'),visibility:data.get('visibility'),status:data.get('status'),problem_ids:values()};try{var id=form.dataset.setId;var result=await request(id?'/api/v2/problem-sets/'+id:'/api/v2/problem-sets',{method:id?'PATCH':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});location.assign('/problem-set/'+result.id);}catch(error){if(window.NWPUOJApp)window.NWPUOJApp.showToast(error.message,'danger');}});var archive=form.querySelector('[data-problem-set-archive]');if(archive)archive.addEventListener('click',function(){if(!confirm('确定归档该题单吗？'))return;request('/api/v2/problem-sets/'+form.dataset.setId,{method:'DELETE'}).then(function(){location.assign('/problem-sets');}).catch(function(error){if(window.NWPUOJApp)window.NWPUOJApp.showToast(error.message,'danger');});});})();</script>
<script>(function(){var form=document.querySelector('[data-problem-set-editor]');if(!form)return;form.addEventListener('submit',async function(event){event.preventDefault();event.stopImmediatePropagation();var submit=form.querySelector('[type="submit"]');if(submit&&submit.disabled)return;if(submit)submit.disabled=true;form.setAttribute('aria-busy','true');try{var data=new FormData(form),toggle=form.querySelector('[data-deadline-toggle]'),problemIds=Array.prototype.map.call(form.querySelectorAll('[data-problem-row]'),function(item){return Number(item.dataset.problemId);}).filter(function(id){return Number.isSafeInteger(id)&&id>0;}),payload={title:data.get('title'),description:data.get('description'),deadline_at:toggle&&toggle.checked?data.get('deadline_at'):'',allow_registration:data.get('allow_registration')==='on',ranking_mode:data.get('ranking_mode'),visibility:data.get('visibility'),status:data.get('status'),problem_ids:problemIds},id=String(form.dataset.setId||'').trim(),headers={'Content-Type':'application/json'};if(id){var etag=String(form.dataset.setEtag||'').trim();if(!etag)throw new Error('题单版本信息缺失，请刷新页面后重试。');headers['If-Match']=etag;payload.if_match=etag;}var response=await fetch(id?'/api/v2/problem-sets/'+id:'/api/v2/problem-sets',{method:id?'PATCH':'POST',credentials:'same-origin',headers:headers,body:JSON.stringify(payload)}),body=await response.json().catch(function(){return null;});if(!response.ok)throw new Error(body&&body.error&&body.error.message||'保存失败。');var nextEtag=response.headers.get('ETag');if(nextEtag)form.dataset.setEtag=nextEtag;location.assign('/problem-set/'+body.data.id);}catch(error){if(window.NWPUOJApp)window.NWPUOJApp.showToast(error.message,'danger');else alert(error.message);}finally{form.removeAttribute('aria-busy');if(submit)submit.disabled=false;}},true);})();</script>
<script>(function(){var input=document.querySelector('[name="deadline_at"]');if(!input||!input.value)return;var utc=new Date(input.value+'Z');var pad=function(value){return String(value).padStart(2,'0');};input.value=utc.getFullYear()+'-'+pad(utc.getMonth()+1)+'-'+pad(utc.getDate())+'T'+pad(utc.getHours())+':'+pad(utc.getMinutes());})();</script>
<% include app_footer %>
