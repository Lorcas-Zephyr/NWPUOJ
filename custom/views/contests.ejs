<% this.title = '比赛' %>
<%
const temporaryContestList = typeof temporaryContestSession !== 'undefined' && temporaryContestSession;
const canManageContests = !temporaryContestList && !!(user && typeof appHasCapability === 'function' && appHasCapability('contest:create'));
const contestNow = syzoj.utils.getCurrentDate();
function contestListState(contest) {
  if (contestNow < contest.start_time) return { key: 'upcoming', label: '未开始', className: 'app-status-waiting' };
  if (contestNow < contest.end_time) return { key: 'running', label: '进行中', className: 'app-status-running' };
  return { key: 'ended', label: '已结束', className: 'app-status-muted' };
}
function contestListType(contest) {
  return { noi: 'NOI', ioi: 'IOI', acm: 'ACM' }[contest.type] || String(contest.type || '').toUpperCase();
}
function contestDuration(contest) {
  const seconds = Math.max(0, Number(contest.end_time) - Number(contest.start_time));
  const days = Math.floor(seconds / 86400);
  const hours = Math.floor(seconds % 86400 / 3600);
  const minutes = Math.floor(seconds % 3600 / 60);
  if (days) return days + ' 天' + (hours ? ' ' + hours + ' 小时' : '');
  if (hours) return hours + ' 小时' + (minutes ? ' ' + minutes + ' 分钟' : '');
  return Math.max(1, minutes) + ' 分钟';
}
const contestRows = contests.map(function (contest) {
  return { contest: contest, state: contestListState(contest) };
});
const listFilters = typeof contestListFilters !== 'undefined' ? contestListFilters : { state: 'all', mine: false, participating: false };
const contestCounts = typeof contestListCounts !== 'undefined' ? contestListCounts : contestRows.reduce(function (counts, item) {
  counts[item.state.key] += 1;
  return counts;
}, { all: contestRows.length, running: 0, upcoming: 0, ended: 0 });
const listTotal = typeof contestListTotal !== 'undefined' ? contestListTotal : contestRows.length;
%>
<% include app_header %>

<div class="app-page app-contests-page">
  <header class="app-page-header">
    <div class="app-page-heading">
      <span class="app-kicker">CONTESTS</span>
      <h1 class="app-page-title">比赛</h1>
      <p class="app-page-description"><%= temporaryContestList ? '仅显示此临时账号已报名的比赛。' : '查看当前赛程、报名状态和比赛结果。' %></p>
    </div>
    <% if (canManageContests) { %>
      <div class="app-page-actions"><a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['contest', 0, 'edit']) %>"><i data-lucide="plus"></i>创建比赛</a></div>
    <% } %>
  </header>

  <% if (Number(req.query.deleted) === 1) { %><div class="app-notice app-notice-success"><i data-lucide="circle-check"></i><span><strong>比赛已删除</strong><small>已按顺序重新计算 <%= Math.max(0, Number(req.query.rating_contests) || 0) %> 场后续 Rated 比赛，更新 <%= Math.max(0, Number(req.query.rating_users) || 0) %> 名用户。</small></span></div><% } %>

    <div class="app-contest-toolbar">
      <div class="app-segmented" role="group" aria-label="按比赛状态筛选">
        <button type="button" data-contest-filter="all" aria-pressed="<%= listFilters.state === 'all' %>">全部 <span><%= contestCounts.all %></span></button>
        <button type="button" data-contest-filter="running" aria-pressed="<%= listFilters.state === 'running' %>">进行中 <span><%= contestCounts.running %></span></button>
        <button type="button" data-contest-filter="upcoming" aria-pressed="<%= listFilters.state === 'upcoming' %>">未开始 <span><%= contestCounts.upcoming %></span></button>
        <button type="button" data-contest-filter="ended" aria-pressed="<%= listFilters.state === 'ended' %>">已结束 <span><%= contestCounts.ended %></span></button>
      </div>
      <% if (user && !temporaryContestList) { %>
      <div class="app-contest-personal-filters" role="group" aria-label="与我相关的比赛">
        <button class="app-button app-button-secondary app-filter-toggle" type="button" data-contest-owner-filter aria-pressed="<%= listFilters.mine %>"><i data-lucide="user-round"></i>我创建的</button>
        <button class="app-button app-button-secondary app-filter-toggle" type="button" data-contest-participant-filter aria-pressed="<%= listFilters.participating %>"><i data-lucide="check-circle-2"></i>我参加的</button>
      </div>
      <% } %>
      <span class="app-contest-result-count" aria-live="polite">共 <strong data-contest-visible-count><%= listTotal %></strong> 场</span>
    </div>

  <% if (contestRows.length) { %>
    <section class="app-contest-list" data-contest-list aria-label="比赛列表">
      <% for (const item of contestRows) {
        const contest = item.contest;
        const state = item.state;
        const type = contestListType(contest);
        const registration = typeof contestRegistrations !== 'undefined' && contestRegistrations ? contestRegistrations[contest.id] : null;
        const isRated = typeof contestRatedById !== 'undefined' && !!contestRatedById[contest.id];
      %>
        <article class="app-contest-list-row" data-contest-state="<%= state.key %>" data-contest-owner="<%= contest.holder_id %>" data-contest-registered="<%= registration && registration.registered ? '1' : '0' %>" data-reveal>
          <div class="app-contest-list-main">
            <span class="app-contest-state-marker is-<%= state.key %>" aria-hidden="true"></span>
            <span>
              <span class="app-row-title"><a href="<%= syzoj.utils.makeUrl(['contest', contest.id]) %>"><%= contest.title %></a></span>
              <span class="app-list-meta">
                <span><%= type || '自定义赛制' %></span>
                <span><%= isRated ? 'Rated' : 'Unrated' %></span>
                <% if (!contest.is_public) { %><span>隐藏</span><% } %>
              </span>
            </span>
          </div>
          <div class="app-contest-list-schedule">
            <strong><%= syzoj.utils.formatDate(contest.start_time) %></strong>
            <span><%= contestDuration(contest) %> · <%= syzoj.utils.formatDate(contest.end_time) %> 结束</span>
          </div>
          <div class="app-contest-list-attendance">
            <span><i data-lucide="users-round"></i><%= registration ? registration.registeredCount : 0 %></span>
            <span class="app-status <%= state.className %>"><%= state.label %></span>
          </div>
          <div class="app-contest-list-action">
            <% if (!registration) { %><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['contest', contest.id]) %>">查看</a>
            <% } else if (registration.isSupervisior) { %><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['contest', contest.id, 'edit']) %>"><i data-lucide="settings"></i>管理</a>
            <% } else if (registration.canRegister) { %><form method="post" data-contest-registration-v2="register" data-contest-id="<%= contest.id %>"><input type="hidden" name="csrf_token" value="<%= registration.csrfToken %>"><input type="hidden" name="return_url" value="<%= req.originalUrl %>"><button class="app-button app-button-primary" type="submit"><i data-lucide="user-plus"></i>报名</button></form>
            <% } else if (registration.canCancel) { %><form method="post" data-contest-registration-v2="unregister" data-contest-id="<%= contest.id %>" data-confirm="确定取消报名吗？"><input type="hidden" name="csrf_token" value="<%= registration.csrfToken %>"><input type="hidden" name="return_url" value="<%= req.originalUrl %>"><button class="app-button app-button-danger-outline" type="submit"><i data-lucide="user-minus"></i>取消报名</button></form>
            <% } else if (registration.registered) { %><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['contest', contest.id]) %>"><i data-lucide="check"></i>进入比赛</a>
            <% } else if (registration.removedByAdmin) { %><span class="app-status app-status-danger">已移出</span>
            <% } else if (!registration.allowRegistration) { %><span class="app-status app-status-muted">仅限比赛账号</span>
            <% } else if (registration.registrationOpen && !user) { %><a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['login'], { url: req.originalUrl }) %>">登录后报名</a>
            <% } else { %><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['contest', contest.id]) %>">查看</a><% } %>
          </div>
        </article>
      <% } %>
    </section>
  <% } else { %>
    <div class="app-empty" data-contest-filter-empty><div class="app-empty-inner"><i data-lucide="calendar-x"></i><strong>当前条件没有比赛</strong><p>切换筛选条件查看其他比赛。</p></div></div>
  <% } %>
  <% include app_pagination %>
</div>

<script>
(function () {
  var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-contest-filter]'));
  var ownerButton = document.querySelector('[data-contest-owner-filter]');
  var participantButton = document.querySelector('[data-contest-participant-filter]');
  function select(key, value) {
    var url = new URL(window.location.href);
    url.searchParams.delete('page');
    if (value) url.searchParams.set(key, value);
    else url.searchParams.delete(key);
    window.location.assign(url.pathname + url.search);
  }
  buttons.forEach(function (button) {
    button.addEventListener('click', function () { select('state', button.dataset.contestFilter === 'all' ? '' : button.dataset.contestFilter); });
  });
  if (ownerButton) ownerButton.addEventListener('click', function () {
    select('mine', ownerButton.getAttribute('aria-pressed') === 'true' ? '' : '1');
  });
  if (participantButton) participantButton.addEventListener('click', function () {
    select('participating', participantButton.getAttribute('aria-pressed') === 'true' ? '' : '1');
  });
})();
</script>

<% include contest_registration_v2_script %>

<% include app_footer %>
