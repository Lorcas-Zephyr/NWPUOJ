<% this.title = problem.title + ' - 题解' %>
<% include app_header %>
<% include problem_context %>

<div class="app-page app-solutions-page">
  <div class="app-section-header app-context-section-header"><div><h2 class="app-section-title">题解</h2><p class="app-section-description">共 <%= solutions.length %> 篇当前可见题解。</p></div><div class="app-page-actions"><% if (typeof submissionDisabled !== 'undefined' && submissionDisabled) { %><span class="app-button app-button-secondary is-disabled"><i data-lucide="lock"></i>投稿已关闭</span><% } else if (allowedPost) { %><a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['problem', problem.id, 'solution', 'new']) %>"><i data-lucide="square-pen"></i>投稿题解</a><% } else if (!res.locals.user) { %><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['login'], { url: req.originalUrl }) %>">登录后投稿</a><% } %><% if (typeof canManageSetting !== 'undefined' && canManageSetting) { %><form method="post" action="/api/v2/problems/<%= problem.id %>/solution-settings" data-solution-settings-v2 data-enabled="<%= submissionDisabled ? 'true' : 'false' %>" data-confirm="确定<%= submissionDisabled ? '重新开放' : '关闭' %>此题的题解投稿吗？"><button class="app-button app-button-secondary" type="submit"><i data-lucide="<%= submissionDisabled ? 'lock-open' : 'lock' %>"></i><%= submissionDisabled ? '开放投稿' : '关闭投稿' %></button></form><% } %></div></div>

  <% if (typeof submissionDisabled !== 'undefined' && submissionDisabled) { %><div class="app-notice app-notice-warning"><i data-lucide="info"></i><span>该题已关闭题解投稿，已通过的题解仍可查看和评论。</span></div><% } %>

  <% if (solutions.length) { %><div class="app-table-region" role="region" aria-label="题解列表" tabindex="0"><table class="app-table"><thead><tr><th class="app-cell-primary">题解</th><th>作者</th><th>状态</th><th>发布时间</th></tr></thead><tbody><% for (const solution of solutions) { const appSolutionStatus = { accepted: ['已通过', 'app-status-accepted'], pending: ['待审核', 'app-status-waiting'], rejected: ['已拒绝', 'app-status-error'], withdrawn: ['已撤回', ''] }[solution.status] || [solution.status, '']; %><tr><td class="app-cell-primary"><span class="app-row-title"><a href="<%= syzoj.utils.makeUrl(['solution', solution.id]) %>"><%= solution.title || '无标题题解' %></a></span></td><td><% if (solution.user) { %><a href="<%= syzoj.utils.makeUrl(['user', solution.user.id]) %>"><%= solution.user.username %></a><% } else { %>已删除用户<% } %></td><td><span class="app-status <%= appSolutionStatus[1] %>"><%= appSolutionStatus[0] %></span></td><td class="app-cell-number"><%= syzoj.utils.formatDate(solution.public_time) %></td></tr><% } %></tbody></table></div><% include app_pagination %><% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="notebook-tabs"></i><strong>暂无题解</strong><p>当前还没有可见的题解内容。</p><% if (allowedPost) { %><a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['problem', problem.id, 'solution', 'new']) %>">投稿第一篇题解</a><% } %></div></div><% } %>
</div>

<script>
(function () {
  var form = document.querySelector('[data-solution-settings-v2]');
  if (!form) return;
  form.addEventListener('submit', async function (event) {
    event.preventDefault();
    var button = form.querySelector('button[type="submit"]');
    if (button) button.disabled = true;
    try {
      var response = await fetch(form.action, { method: 'PATCH', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ submissions_enabled: form.dataset.enabled === 'true' }) });
      var body = await response.json();
      if (!response.ok) throw new Error(body && body.error && body.error.message || '题解投稿设置保存失败。');
      window.location.reload();
    } catch (error) {
      if (window.NWPUOJApp) window.NWPUOJApp.showToast(error.message || '题解投稿设置保存失败。', 'danger');
      if (button) button.disabled = false;
    }
  });
})();
</script>

<% include app_footer %>
