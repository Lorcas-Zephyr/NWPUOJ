<% this.title = problem.title + ' - 题解' %>
<% include header %>

<div class="padding">
  <div class="nwpuoj-page-header">
    <div>
      <h2 class="nwpuoj-page-title">题解</h2>
      <div class="nwpuoj-meta">共 <%= solutions.length %> 篇当前可见题解</div>
    </div>
    <div class="nwpuoj-page-actions">
      <% if (typeof submissionDisabled !== 'undefined' && submissionDisabled) { %>
        <span class="ui disabled button" aria-disabled="true">
          <i class="ban icon"></i> 已关闭投稿
        </span>
      <% } else if (allowedPost) { %>
        <a class="ui primary button" href="<%= syzoj.utils.makeUrl(['problem', problem.id, 'solution', 'new']) %>">
          <i class="edit icon"></i> 投稿题解
        </a>
      <% } else if (!res.locals.user) { %>
        <a class="ui button" href="<%= syzoj.utils.makeUrl(['login'], { url: req.originalUrl }) %>">
          <i class="sign in icon"></i> 登录后投稿
        </a>
      <% } %>

      <% if (typeof canManageSetting !== 'undefined' && canManageSetting) { %>
        <% if (submissionDisabled) { %>
          <form method="post"
                action="<%= syzoj.utils.makeUrl(['problem', problem.id, 'solution-toggle-submission']) %>"
                onsubmit="return confirm('确定重新开放此题的题解提交吗？');"
                style="display:inline;margin:0;">
            <button type="submit" class="ui green button">
              <i class="unlock icon"></i> 开放投稿
            </button>
          </form>
        <% } else { %>
          <form method="post"
                action="<%= syzoj.utils.makeUrl(['problem', problem.id, 'solution-toggle-submission']) %>"
                onsubmit="return confirm('确定关闭此题的题解提交吗？已通过的题解仍然可见，但用户不能再投稿。');"
                style="display: inline; margin: 0;">
            <button type="submit" class="ui yellow button">
              <i class="lock icon"></i> 关闭投稿
            </button>
          </form>
        <% } %>
      <% } %>
    </div>
  </div>

  <% if (typeof submissionDisabled !== 'undefined' && submissionDisabled) { %>
    <div class="ui yellow message">
      <i class="info circle icon"></i>
      <b>该题已关闭题解投稿。</b>已通过的题解仍可查看和评论；新的题解投稿暂不接受。
    </div>
  <% } %>

  <% if (solutions.length === 0) { %>
     <div class="nwpuoj-empty-state">
       <i class="file alternate outline icon"></i>
       <h3>暂无题解</h3>
      <% if (allowedPost) { %>
        <a class="ui primary button" href="<%= syzoj.utils.makeUrl(['problem', problem.id, 'solution', 'new']) %>">
          成为第一个投稿者
        </a>
      <% } %>
    </div>
  <% } else { %>
    <div class="nwpuoj-table-region" role="region" aria-label="题解列表" tabindex="0">
    <table class="ui very basic table">
      <thead>
        <tr>
          <th scope="col" style="width:50%;">标题</th>
          <th class="nwpuoj-priority-2" scope="col">作者</th>
          <th scope="col">状态</th>
          <th class="nwpuoj-priority-3" scope="col">发布时间</th>
        </tr>
      </thead>
      <tbody>
        <% for (let sol of solutions) { %>
          <tr>
            <td class="left aligned">
              <a href="<%= syzoj.utils.makeUrl(['solution', sol.id]) %>">
                <%= sol.title || '(无标题)' %>
              </a>
            </td>
            <td class="nwpuoj-priority-2">
              <% if (sol.user) { %>
                <%- syzoj.utils.renderUsername(sol.user) %>
              <% } else { %>
                <i>已删除</i>
              <% } %>
            </td>
            <td>
              <% if (sol.status === 'accepted') { %>
                <span class="nwpuoj-status nwpuoj-status-success">已通过</span>
              <% } else if (sol.status === 'pending') { %>
                <span class="nwpuoj-status nwpuoj-status-warning">待审核</span>
              <% } else if (sol.status === 'rejected') { %>
                <span class="nwpuoj-status nwpuoj-status-danger">已拒绝</span>
              <% } else if (sol.status === 'withdrawn') { %>
                <span class="nwpuoj-status nwpuoj-status-muted">已撤回</span>
              <% } %>
            </td>
            <td class="nwpuoj-priority-3"><%= syzoj.utils.formatDate(sol.public_time) %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
    </div>
    <% include page %>
  <% } %>
</div>

<% include footer %>
