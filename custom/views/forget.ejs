<% this.title = '忘记密码'; %>
<% include app_header %>

<div class="app-auth">
  <section class="app-auth-intro">
    <img src="/self/logo.png?v=<%= encodeURIComponent(syzoj.config.nwpuoj_version || '2.0.0') %>" alt="" width="52" height="52">
    <h1>恢复账户访问</h1>
    <p>系统会向已绑定邮箱发送一次性密码重置链接。</p>
  </section>
  <section class="app-auth-panel">
    <h2>忘记密码</h2>
    <p>输入注册邮箱以接收重置链接。</p>
    <div class="app-notice" id="forget-message" role="status" hidden><i data-lucide="info"></i><span id="forget-message-content"></span></div>
    <form class="app-form" id="forget-form">
      <label class="app-field app-field-full"><span class="app-label">邮箱</span><span class="app-input-wrap"><i data-lucide="at-sign"></i><input class="app-input" name="email" type="email" id="email" autocomplete="email" required></span></label>
      <button type="submit" class="app-button app-button-primary app-auth-submit" id="forget-button">发送重置邮件</button>
    </form>
    <div class="app-auth-links"><a href="<%= syzoj.utils.makeUrl(['login']) %>"><i data-lucide="arrow-left"></i>返回登录</a></div>
  </section>
</div>

<script>
(function () {
  var form = document.getElementById('forget-form');
  var button = document.getElementById('forget-button');
  var message = document.getElementById('forget-message');
  var content = document.getElementById('forget-message-content');
  function show(type, text) { message.className = 'app-notice ' + (type === 'success' ? 'app-notice-success' : 'app-notice-danger'); content.textContent = text; message.hidden = false; }
  form.addEventListener('submit', function (event) {
    event.preventDefault(); button.disabled = true; button.textContent = '正在发送…';
    var params = new URLSearchParams({ email: document.getElementById('email').value });
    fetch('/api/v2/auth/password/reset', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() })
      .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
      .then(function (result) { if (result.ok && result.data && result.data.data && result.data.data.accepted) { show('success', '密码重置邮件已发送，请检查收件箱和垃圾邮件文件夹。'); form.reset(); } else show('error', '密码重置服务暂时不可用。'); button.disabled = false; button.textContent = '发送重置邮件'; })
      .catch(function () { show('error', '密码重置服务暂时不可用。'); button.disabled = false; button.textContent = '发送重置邮件'; });
  });
})();
</script>

<% include app_footer %>
