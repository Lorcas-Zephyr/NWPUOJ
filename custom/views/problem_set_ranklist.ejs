<% include util %><% this.title='榜单 - '+problemSet.title; const problemSetActiveSection='ranklist'; const problemSetAccess={manager:canManageRanklist}; const selected=typeof ranklistSelectedClassIds!=='undefined'?ranklistSelectedClassIds:[]; function itemAlpha(value){let number=Number(value),result='';while(number>0){number--;result=String.fromCharCode(65+number%26)+result;number=Math.floor(number/26);}return result;} %>
<%
function setRankUrl(account){const query=Object.assign({},req.query,{page:1});if(account==='all')delete query.account;else query.account=account;return syzoj.utils.makeUrl(req,query);}
function setClassResetUrl(){const query=Object.assign({},req.query,{page:1});delete query.classes;return syzoj.utils.makeUrl(req,query);}
function setExportUrl(){const query={};if(ranklistAccountFilter!=='all')query.account=ranklistAccountFilter;if(selected.length)query.classes=selected.join(',');return syzoj.utils.makeUrl(['problem-set',problemSet.id,'ranklist','export'],query);}
function displayUser(item){if(!showRanklistIdentities||!(ranklistProfiles instanceof Map))return item.user;const profile=ranklistProfiles.get(Number(item.user.id));return profile&&profile.real_name&&profile.student_id?Object.assign({},item.user,{username:profile.real_name+'-'+profile.student_id}):item.user;}
%>
<% include app_header %><% include problem_set_context %>
<div class="app-page app-problem-set-rank-page">
  <div class="app-contest-rank-summary"><span><strong><%= ranklistTotal %></strong> 参与者</span><span><strong><%= problemSetItems.length %></strong> 题</span><span><strong><%= problemSet.ranking_mode.toUpperCase() %></strong> 赛制</span><span><strong>100</strong> 人/页</span></div>
  <div class="app-toolbar app-contest-rank-toolbar"><div class="app-toolbar-start"><nav class="app-segmented"><% [['all','全部'],['contest','比赛账户'],['ordinary','普通账户']].forEach(function(option){%><a class="<%= ranklistAccountFilter===option[0]?'is-active':'' %>" href="<%= setRankUrl(option[0]) %>"><%= option[1] %></a><%});%></nav><% if(ranklistClassOptions.length){%><details class="app-action-menu app-rank-class-filter"><summary class="app-button app-button-secondary"><i data-lucide="graduation-cap"></i>班级<% if(selected.length){%> <span><%= selected.length %></span><%}%><i data-lucide="chevron-down"></i></summary><form class="app-action-menu-list app-rank-class-filter-menu" method="get"><% if(ranklistAccountFilter!=='all'){%><input type="hidden" name="account" value="<%= ranklistAccountFilter %>"><%}%><% if(showRanklistIdentities){%><input type="hidden" name="identity" value="real"><%}%><div class="app-rank-class-options"><% ranklistClassOptions.forEach(function(group){%><label><input type="checkbox" name="classes" value="<%= group.id %>"<%= selected.includes(group.id)?' checked':'' %>><span><strong><%= group.name %></strong><small><%= group.tag %></small></span></label><%});%></div><div class="app-rank-class-actions"><a class="app-button app-button-quiet app-button-small" href="<%= setClassResetUrl() %>">清除</a><button class="app-button app-button-primary app-button-small" type="submit">应用</button></div></form></details><%}%></div><% if(canManageRanklist){%><div class="app-toolbar-actions"><label class="app-switch-control"><input type="checkbox" data-rank-identity-toggle<%= showRanklistIdentities?' checked':'' %>><span class="app-switch-track"></span><span>显示真实信息</span></label><a class="app-button app-button-secondary" href="<%= setExportUrl() %>" download><i data-lucide="download"></i>导出榜单</a></div><%}%></div>
  <% if(ranklist.length){%><div class="app-table-region"><table class="app-table app-contest-rank-table"><thead><tr><th>名次</th><th class="app-cell-primary">参与者</th><% if(problemSet.ranking_mode==='acm'){%><th>通过</th><th>罚时</th><%}%><% problemSetItems.forEach(function(item){%><th class="app-rank-problem"><a href="/problem-set/<%= problemSet.id %>/problem/<%= item.ordinal %>" title="<%= item.title %>"><%= itemAlpha(item.ordinal) %></a></th><%});%><% if(problemSet.ranking_mode!=='acm'){%><th>总分</th><%}%></tr></thead><tbody><% let row=rankOffset;ranklist.forEach(function(item){row++;const rank=item.player.standing_rank||row;const overall=item.player.overall_standing_rank;const shown=displayUser(item);%><tr class="<%= user&&user.id===item.user.id?'app-row-current':'' %>"><td><span class="app-rank-number<%= rank<=3?' is-top':'' %>"><%= rank %></span><% if(overall){%><small class="app-rank-overall">（<%= overall %>）</small><%}%></td><td class="app-cell-primary"><%- syzoj.utils.renderUsername(shown) %></td><% if(problemSet.ranking_mode==='acm'){%><td><strong><%= item.player.score %></strong></td><td><%= syzoj.utils.formatTime(item.tie) %></td><%}%><% problemSetItems.forEach(function(problem){const detail=item.player.score_details[problem.problem_id];%><td class="app-rank-result"><% if(detail){%><a href="/submission/<%= detail.judge_id %>"><% if(problemSet.ranking_mode==='acm'){%><% if(detail.accepted){%><strong class="app-score app-score-perfect"><%= detail.unacceptedCount?'+'+detail.unacceptedCount:'+' %></strong><small><%= syzoj.utils.formatTime(detail.acceptedTime-Number(problemSet.published_at||0)) %></small><%}else if(detail.unacceptedCount){%><strong class="app-score app-score-zero">-<%= detail.unacceptedCount %></strong><%}%><%}else{%><strong class="app-score <%= Number(detail.weighted_score)===100?'app-score-perfect':'' %>"><%= Math.round(Number(detail.weighted_score||0)) %></strong><%}%></a><%}%></td><%});%><% if(problemSet.ranking_mode!=='acm'){%><td><strong><%= item.player.score %></strong></td><%}%></tr><%});%></tbody></table></div><% include app_pagination %><%}else{%><div class="app-empty"><div class="app-empty-inner"><i data-lucide="users-round"></i><strong>暂无排名数据</strong><p>参与者提交后，成绩会显示在这里。</p></div></div><%}%>
</div>
<script>(function(){var toggle=document.querySelector('[data-rank-identity-toggle]');if(!toggle)return;toggle.addEventListener('change',function(){var next=new URL(location.href);if(toggle.checked)next.searchParams.set('identity','real');else next.searchParams.delete('identity');next.searchParams.delete('page');location.assign(next.pathname+next.search);});})();</script>
<% include app_footer %>
