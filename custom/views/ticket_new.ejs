<% this.title = '创建工单' %>
<% include app_header %>

<div class="app-page app-ticket-new-page">
  <header class="app-page-header"><div class="app-page-heading"><span class="app-kicker">NEW REQUEST</span><h1 class="app-page-title">创建工单</h1><p class="app-page-description">选择准确的类型并补充必要信息，便于更快处理。</p></div><div class="app-page-actions"><a class="app-button app-button-quiet" href="<%= syzoj.utils.makeUrl(['tickets']) %>"><i data-lucide="arrow-left"></i>返回工单</a></div></header>

  <ol class="app-stepper" aria-label="创建进度"><li class="<%= step === 'select_type' ? 'is-current' : 'is-complete' %>"><span><%= step === 'select_type' ? '1' : '✓' %></span><div><strong>选择类型</strong><small>确定问题归属</small></div></li><li class="<%= step === 'fill_form' ? 'is-current' : '' %>"><span>2</span><div><strong>补充信息</strong><small>描述具体情况</small></div></li></ol>

  <% if (step === 'select_type') { %>
    <section class="app-section"><div class="app-section-header"><div><h2 class="app-section-title">工单类型</h2><p class="app-section-description">从最符合问题的分类开始。</p></div><span class="app-quota"><strong><%= recentCount %></strong> / 5<span>近 24 小时</span></span></div>
      <div class="app-ticket-type-groups">
        <% Object.keys(categories).forEach(function (key) { const cat = categories[key]; %><section><div class="app-ticket-type-heading"><span class="app-ticket-icon"><i data-lucide="<%= ({ problem: 'file-question', contest: 'trophy', article: 'newspaper', user: 'user-round', report: 'flag' })[key] || 'message-square' %>"></i></span><div><h3><%= cat.label %></h3><small>选择具体事项</small></div></div><div class="app-ticket-type-options"><% cat.subtypes.forEach(function (subtype) { %><a href="<%= syzoj.utils.makeUrl(['ticket', 'new'], { category: key, subtype: subtype.value }) %>"><span><%= subtype.label %></span><i data-lucide="arrow-right"></i></a><% }); %></div></section><% }); %>
      </div>
    </section>
  <% } else if (step === 'fill_form') { const cat = categories[category]; const subInfo = cat.subtypes.find(function (item) { return item.value === subtype; }); const relationLabel = cat.relation === 'problem' ? '题目' : cat.relation === 'contest' ? '比赛' : cat.relation === 'article' ? '文章' : '用户'; %>
    <section class="app-ticket-form-layout">
      <aside class="app-ticket-selection"><span class="app-ticket-icon"><i data-lucide="<%= ({ problem: 'file-question', contest: 'trophy', article: 'newspaper', user: 'user-round', report: 'flag' })[category] || 'message-square' %>"></i></span><span><small>当前类型</small><strong><%= cat.label %></strong><em><%= subInfo.label %></em></span><a href="<%= syzoj.utils.makeUrl(['ticket', 'new']) %>">重新选择</a></aside>
      <form class="app-form app-ticket-create-form" method="post" data-ticket-v2="create">
        <input type="hidden" name="category" value="<%= category %>"><input type="hidden" name="subtype" value="<%= subtype %>">
        <% if (cat.relation_required) { %><label class="app-field app-field-full"><span class="app-label">关联<%= relationLabel %><span class="app-required">*</span></span><span class="app-search-picker"><span class="app-input-wrap"><i data-lucide="search"></i><input class="app-input" type="text" id="relation_search_input" placeholder="按 ID 或<%= cat.relation === 'user' ? '用户名' : '标题' %>搜索" autocomplete="off"></span><input type="hidden" name="relation_id" id="relation_id_value" value="<%= prefilledRelation %>"><span class="app-search-results" id="relation_results" hidden></span><span class="app-search-selection" id="relation_selected" hidden><i data-lucide="circle-check"></i><span></span></span></span></label><% } else if (cat.relation === 'user' && category === 'user') { %><div class="app-notice"><i data-lucide="user-round"></i><span>此工单将自动关联当前账号 <strong><%= res.locals.user.username %></strong></span></div><% } %>
        <% if (category === 'report') { %><label class="app-field app-field-full"><span class="app-label">举报原因<span class="app-required">*</span></span><textarea class="app-textarea app-textarea-short" name="report_reason" rows="2" placeholder="简要说明举报理由" required></textarea></label><% } %>
        <label class="app-field app-field-full"><span class="app-label">工单标题<span class="app-required">*</span></span><input class="app-input" type="text" name="title" maxlength="200" minlength="5" placeholder="用一句话描述问题（5 - 200 字符）" required></label>
        <label class="app-field app-field-full"><span class="app-label">详细描述</span><textarea class="app-textarea" name="description" rows="8" placeholder="补充问题表现、复现步骤、相关链接等。支持 Markdown。"></textarea><span class="app-help">提交后无法编辑正文，请在提交前确认信息完整。</span></label>
        <div class="app-form-actions"><a class="app-button app-button-quiet" href="<%= syzoj.utils.makeUrl(['ticket', 'new']) %>">上一步</a><button class="app-button app-button-primary" type="submit"><i data-lucide="send"></i>提交工单</button></div>
      </form>
    </section>
    <% if (cat.relation_required) { %><script>
    (function () {
      var input = document.getElementById('relation_search_input'); var results = document.getElementById('relation_results'); var hidden = document.getElementById('relation_id_value'); var selected = document.getElementById('relation_selected'); var timer; var type = <%- JSON.stringify(cat.relation) %>;
      function showSelected(item) { input.value = item.name; hidden.value = item.id; selected.querySelector('span').textContent = '已选择：' + item.name; selected.hidden = false; results.hidden = true; }
      function render(items) { results.innerHTML = ''; if (!items.length) { var empty = document.createElement('span'); empty.className = 'app-search-empty'; empty.textContent = '没有找到匹配项'; results.appendChild(empty); } else { items.forEach(function (item) { var button = document.createElement('button'); button.type = 'button'; button.innerHTML = '<span></span><i data-lucide="arrow-up-right"></i>'; button.querySelector('span').textContent = item.name; button.addEventListener('click', function () { showSelected(item); }); results.appendChild(button); }); } results.hidden = false; if (window.NWPUOJApp) window.NWPUOJApp.refreshIcons(results); }
      async function search(query) { try { var response = await fetch('/api/v2/tickets/relation-search?type=' + encodeURIComponent(type) + '&q=' + encodeURIComponent(query), { credentials: 'same-origin' }); var payload = await response.json(); var items = payload && Array.isArray(payload.data) ? payload.data : []; render(items); return items; } catch (error) { results.hidden = true; return []; } }
      if (hidden.value) { var prefilledId = String(hidden.value); search(prefilledId).then(function (items) { var exact = items.find(function (item) { return String(item.id) === prefilledId; }); if (exact) showSelected(exact); }); }
      input.addEventListener('input', function () { clearTimeout(timer); var query = input.value.trim(); hidden.value = ''; selected.hidden = true; if (!query) { results.hidden = true; return; } timer = setTimeout(function () { search(query); }, 250); });
      document.addEventListener('click', function (event) { if (!event.target.closest('.app-search-picker')) results.hidden = true; });
    })();
    </script><% } %>
  <% } %>
</div>

<% include ticket_v2_script %>
<% include app_footer %>
