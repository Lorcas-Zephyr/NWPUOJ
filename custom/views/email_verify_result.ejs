<% this.title = success ? '邮箱验证成功' : '邮箱验证失败' %>
<% include app_header %>

<div class="app-result-page"><section class="app-result-state <%= success ? 'is-success' : 'is-danger' %>"><span class="app-result-icon"><i data-lucide="<%= success ? 'badge-check' : 'circle-x' %>"></i></span><span class="app-kicker">EMAIL VERIFICATION</span><h1><%= success ? '邮箱验证成功' : '邮箱验证失败' %></h1><p><%= message %></p><div class="app-result-actions"><a class="app-button app-button-primary" href="/">返回首页</a><% if (!success && user) { %><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['user', user.id, 'edit']) %>">重新发送验证邮件</a><% } else if (!success) { %><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['login']) %>">登录后重新发送</a><% } %></div></section></div>

<% include app_footer %>
