<% this.adminPage = 'solutions'; %>
<% include admin_header %>
<% const appSolutionStates = { pending: '待审核', accepted: '已通过', rejected: '已拒绝', withdrawn: '已撤回', all: '全部' }; %>
<% const appSolutionStateClasses = { pending: 'app-status-pending', accepted: 'app-status-accepted', rejected: 'app-status-rejected', withdrawn: 'app-status-muted' }; %>

<div class="app-admin-toolbar"><div><h3>题解审核队列</h3><p>查看投稿状态并进入题解页面完成审核。</p></div><div class="app-segmented app-admin-filter-tabs"><% for (const state of ['pending','accepted','rejected','withdrawn','all']) { %><a class="<%= currentStatus === state ? 'is-active' : '' %>" href="<%= syzoj.utils.makeUrl(['admin', 'solutions'], { status: state }) %>"><%= appSolutionStates[state] %><span><%= counts[state] %></span></a><% } %></div></div>
<% if (solutions.length) { %><div class="app-table-region"><table class="app-table app-admin-solutions-table"><thead><tr><th>标题</th><th>所属题目</th><th>作者</th><th>状态</th><th>处理人</th><th>提交时间</th><th aria-label="操作"></th></tr></thead><tbody><% for (const solution of solutions) { %><tr><td class="app-cell-primary"><a href="<%= syzoj.utils.makeUrl(['solution', solution.id]) %>" target="_blank" rel="noopener"><%= solution.title || '(无标题)' %></a></td><td><% if (solution.problem) { %><a href="<%= syzoj.utils.makeUrl(['problem', solution.problem.id]) %>" target="_blank" rel="noopener"><%= solution.problem.getDisplayId() %>. <%= solution.problem.title %></a><% } else { %><span class="app-text-muted">题目已删除</span><% } %></td><td><% if (solution.user) { %><%- syzoj.utils.renderUsername(solution.user) %><% } else { %>已删除<% } %></td><td><span class="app-status <%= appSolutionStateClasses[solution.status] || 'app-status-muted' %>"><%= appSolutionStates[solution.status] || solution.status %></span></td><td><% if (solution.reviewer) { %><%- syzoj.utils.renderUsername(solution.reviewer) %><% if (solution.reviewed_at) { %><small class="app-row-description"><%= syzoj.utils.formatDate(solution.reviewed_at) %></small><% } %><% } else { %>-<% } %></td><td class="app-cell-number"><%= syzoj.utils.formatDate(solution.public_time) %></td><td class="app-cell-actions"><a class="app-button app-button-secondary app-button-small" href="<%= syzoj.utils.makeUrl(['solution', solution.id]) %>" target="_blank" rel="noopener"><i data-lucide="scan-eye"></i>查看审核</a></td></tr><% } %></tbody></table></div><% include app_pagination %><% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="file-check-2"></i><strong><%= currentStatus === 'pending' ? '没有待审核题解' : '此分类暂无题解' %></strong><p>新的投稿会显示在对应状态中。</p></div></div><% } %>
<% include admin_footer %>
