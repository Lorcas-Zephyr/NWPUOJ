<% const appSubtaskTypes = { sum: '测试点分数按百分比相加', min: '取各测试点最低分', mul: '测试点分数按百分比相乘' }; %>
<% if (testcases && testcases.error) { %><div class="app-notice app-notice-warning"><i data-lucide="triangle-alert"></i><span>数据包错误：<%= testcases.error %></span></div>
<% } else if (testcases) { %>
<div class="app-testcase-summary"><span class="app-status <%= testcases.spj ? 'app-status-info' : 'app-status-muted' %>"><%= testcases.spj ? 'Special Judge' : problem.type === 'interaction' ? '交互评测' : '文本比较' %></span><small><%= testcases.reduce(function (count, subtask) { return count + subtask.cases.length; }, 0) %> 个测试点</small></div>
<div class="app-admin-testcases"><% let appSubtaskIndex = 0; for (const subtask of testcases) { appSubtaskIndex += 1; %><section><header><span><strong><%= testcases.length === 1 ? '单个子任务' : '子任务 ' + appSubtaskIndex %></strong><small><%= appSubtaskTypes[subtask.type] || subtask.type %><%= testcases.length !== 1 ? ' · ' + subtask.score + ' 分' : '' %></small></span><em><%= subtask.cases.length %></em></header><div><% for (const testcase of subtask.cases) { %><span><code><%= testcase.input || '-' %></code><i data-lucide="arrow-right"></i><code><%= testcase.output || '-' %></code><% if (problem.type === 'submit-answer') { %><i data-lucide="arrow-right"></i><code><%= testcase.answer || '-' %></code><% } %></span><% } %></div></section><% } %></div>
<% } else { %><div class="app-empty app-empty-compact"><div class="app-empty-inner"><i data-lucide="database"></i><strong>无测试数据</strong></div></div><% } %>
