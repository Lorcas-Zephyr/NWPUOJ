<% this.title = '批量导入题目'; this.active = 'problems'; %>
<% include app_header %>
<main class="app-page app-problem-bulk-import-page">
  <header class="app-page-header">
    <div class="app-page-heading">
      <a class="app-back-link" href="<%= syzoj.utils.makeUrl(['problems']) %>"><i data-lucide="arrow-left"></i>返回题库</a>
      <span class="app-kicker">PROBLEM LIBRARY</span><h1 class="app-page-title">批量导入题目</h1>
      <p class="app-page-description">上传 ZIP 题目包，一次创建多道题目；每个题目文件夹可包含 Markdown 题面和测试数据。</p>
    </div>
    <div class="app-page-actions"><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['problems', 'import', 'template']) %>" download><i data-lucide="download"></i>下载 ZIP 格式示例</a></div>
  </header>
  <section class="app-section">
    <div class="app-notice app-notice-info"><i data-lucide="info"></i><span>ZIP 根目录下每个文件夹代表一道题目：放置 <code>statement.md</code>（或 <code>problem.md</code>）、可选的 <code>problem.json</code> 和 <code>testdata/</code> 目录（或 <code>testdata.zip</code>）。最多 100 个文件夹。</span></div>
    <form class="app-form" id="problem-bulk-import-form" data-problem-bulk-import>
      <label class="app-file-field"><input type="file" name="problems_zip" accept=".zip,application/zip" required><span><i data-lucide="file-archive"></i><strong>选择题目 ZIP</strong><small>每个题目文件夹包含题面与可选测试数据</small></span></label>
      <div class="app-form-actions">
        <span class="app-form-status" data-bulk-import-status role="status" aria-live="polite"></span>
        <a class="app-button app-button-secondary" data-bulk-import-report hidden download>下载失败报告</a>
        <button class="app-button app-button-primary" type="submit"><i data-lucide="upload"></i><span>开始导入</span></button>
        <button class="app-button app-button-secondary" type="button" data-bulk-import-retry hidden>仅重试失败项</button>
      </div>
    </form>
    <div class="app-bulk-import-preview" data-bulk-import-preview hidden><div class="app-section-header"><div><h2 class="app-section-title">导入预览</h2><p class="app-section-description" data-bulk-import-count></p></div></div><p class="app-bulk-import-names" data-bulk-import-names></p></div>
  </section>
  <section class="app-section">
    <div class="app-section-header"><div><h2 class="app-section-title">文件夹格式</h2><p class="app-section-description">每个题目目录至少包含一个 Markdown 题面文件；测试数据可直接放入同目录下的 <code>testdata/</code>，也可打包为 <code>testdata.zip</code>。</p></div></div>
    <div class="app-table-region"><table class="app-table">
      <thead><tr><th>文件</th><th>作用</th><th>说明</th></tr></thead>
      <tbody>
        <tr><td><code>statement.md</code></td><td>题面</td><td>必填，也可使用 <code>problem.md</code>。</td></tr>
        <tr><td><code>problem.json</code></td><td>题目属性</td><td>可选，填写 title、type、时间与内存限制等字段。当前批量导入尚不应用 tag_ids，标签请在导入后批量添加。</td></tr>
        <tr><td><code>testdata/</code> 或 <code>testdata.zip</code></td><td>测试数据</td><td>可选，格式与题目测试数据上传一致；两者同时存在时优先使用 testdata.zip。</td></tr>
      </tbody>
    </table></div>
    <p class="app-help">普通传统题可以不写 data.yml，系统自动配对同名 .in 与 .out（或 .ans）。需要子任务、自定义配对或交互器时，请在测试数据内提供 data.yml。</p>
  </section>
  <section class="app-section" data-bulk-import-order-help>
    <div class="app-section-header"><div><h2 class="app-section-title">导入顺序</h2><p class="app-section-description">按题目文件夹名自然排序后逐题导入，数字按数值比较：1、2、10，而不是 1、10、2。</p></div></div>
    <p class="app-help">推荐使用唯一数字前缀：<code>01_A加B</code>、<code>02_排序</code>、<code>03_最短路</code>。不依赖 ZIP 中的文件排列或压缩时的选择顺序。</p>
    <p class="app-help">在每题 problem.json 的 title 中填写实际标题，避免文件夹数字前缀出现在标题里；title 留空时使用完整文件夹名。无需填写 order 字段。</p>
    <p class="app-help">导入顺序只决定创建先后，不设置比赛或题单内的题目顺序，也不保证题号连续；失败项稍后重试不会补回原来的题号位置。</p>
  </section>
</main>
<script>
(function () {
  var form = document.querySelector('[data-problem-bulk-import]');
  if (!form) return;
  var input = form.elements.problems_zip;
  var status = form.querySelector('[data-bulk-import-status]');
  var button = form.querySelector('button[type="submit"]');
  var report = form.querySelector('[data-bulk-import-report]');
  var retry = form.querySelector('[data-bulk-import-retry]');
  var failedFolders = [];
  function setStatus(message, kind) { status.textContent = message || ''; status.className = 'app-form-status' + (kind ? ' app-form-status-' + kind : ''); }
  function failuresFrom(data) { return data && data.data && Array.isArray(data.data.failures) ? data.data.failures : []; }
  function failureMessage(data) { var failures = failuresFrom(data); return failures.length ? failures.map(function (item) { return item.folder + '：' + item.message; }).join('；') : data && data.error && data.error.message || 'ZIP 导入失败。'; }
  function publishReport(failures) {
    if (!report) return;
    if (report.href) URL.revokeObjectURL(report.href);
    var blob = new Blob([JSON.stringify({ generated_at: new Date().toISOString(), failures: failures }, null, 2)], { type: 'application/json' });
    report.href = URL.createObjectURL(blob); report.hidden = !failures.length;
  }
  async function submitImport(retryOnly) {
    var file = input.files && input.files[0];
    if (!file) { setStatus('请选择 ZIP 文件。', 'error'); return; }
    button.disabled = true; if (retry) retry.hidden = true; setStatus(retryOnly ? '正在重试失败项…' : '正在上传并导入 ZIP…');
    try {
      var body = new FormData(); body.append('problems_zip', file);
      if (retryOnly) body.append('retry_folders', JSON.stringify(failedFolders));
      var response = await fetch('<%= syzoj.utils.makeUrl(['api', 'v2', 'problems', 'import']) %>', { method: 'POST', credentials: 'same-origin', body: body });
      var data = await response.json().catch(function () { return null; });
      if (!response.ok) throw new Error(failureMessage(data));
      var created = Number(data.data && data.data.created || 0), failures = failuresFrom(data);
      failedFolders = failures.map(function (item) { return item.folder; }); publishReport(failures);
      if (failures.length) {
        setStatus('本次创建 ' + created + ' 道，失败 ' + failures.length + ' 道：' + failureMessage(data), 'error');
        if (retry) retry.hidden = false; button.disabled = false; return;
      }
      setStatus('已创建 ' + created + ' 道题目。', 'success');
      window.setTimeout(function () { window.location.assign('<%= syzoj.utils.makeUrl(['problems']) %>?bulk_imported=' + created); }, 500);
    } catch (error) { setStatus(error.message || 'ZIP 导入失败。', 'error'); button.disabled = false; }
  }
  input.addEventListener('change', function () { var file = input.files && input.files[0]; failedFolders = []; if (retry) retry.hidden = true; if (report) report.hidden = true; setStatus(file ? '已选择 ' + file.name + '，提交后服务器会逐个校验题目文件夹。' : ''); });
  form.addEventListener('submit', function (event) { event.preventDefault(); submitImport(false); });
  if (retry) retry.addEventListener('click', function () { submitImport(true); });
})();
</script>
<% include app_footer %>
