<% this.title = item.title || '剪贴板' %>
<% include app_header %>
<% const appViewVisibility = { private: ['私有', 'lock-keyhole', 'app-status-muted'], public: ['公开', 'globe-2', 'app-status-accepted'], link: ['分享链接', 'link', 'app-status-info'] }[item.visibility] || ['私有', 'lock-keyhole', 'app-status-muted']; %>

<div class="app-page app-clipboard-view-page">
  <header class="app-page-header"><div class="app-page-heading"><a class="app-back-link" href="<%= typeof viaShareLink !== 'undefined' && viaShareLink ? '/' : isOwn ? syzoj.utils.makeUrl(['clipboard']) : syzoj.utils.makeUrl(['clipboard', 'user', owner.id]) %>"><i data-lucide="arrow-left"></i><%= typeof viaShareLink !== 'undefined' && viaShareLink ? '首页' : isOwn ? '我的剪贴板' : owner.username + ' 的剪贴板' %></a><span class="app-kicker"><%= typeof viaShareLink !== 'undefined' && viaShareLink ? 'SHARED CLIPBOARD' : 'CLIPBOARD' %></span><h1 class="app-page-title"><%= item.title || '(无标题)' %></h1><p class="app-page-description">作者：<% if (owner) { %><%- syzoj.utils.renderUsername(owner) %><% } else { %>账户已删除<% } %> · 更新于 <%= syzoj.utils.formatDate(item.update_time || item.public_time) %></p></div><div class="app-page-actions"><span class="app-status <%= appViewVisibility[2] %>"><%= appViewVisibility[0] %></span><% if (isOwn) { %><a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['clipboard', item.id, 'edit']) %>"><i data-lucide="square-pen"></i>编辑</a><form class="app-inline-form" method="post" data-clipboard-v2="delete" data-clipboard-id="<%= item.id %>" data-confirm="确定删除此剪贴板吗？此操作不可恢复。"><button class="app-button app-button-danger-outline" type="submit"><i data-lucide="trash"></i>删除</button></form><% } %></div></header>
  <% if (isOwn && item.visibility === 'link' && shareUrl) { %><section class="app-share-strip"><i data-lucide="link"></i><span><strong>分享链接</strong><small><% if (item.share_expires) { %>有效期至 <%= syzoj.utils.formatDate(item.share_expires) %><% } else { %>此链接永不过期<% } %></small></span><input class="app-input" id="share-url-input" value="<%= shareUrl %>" readonly><button class="app-button app-button-secondary" type="button" data-copy="#share-url-input"><i data-lucide="copy"></i>复制</button><form class="app-inline-form" method="post" data-clipboard-v2="share" data-clipboard-id="<%= item.id %>" data-confirm="重新生成后旧链接将立即失效，确定继续吗？"><button class="app-button app-button-quiet" type="submit">重新生成</button></form></section><% } %>
  <article class="app-markdown app-clipboard-rendered" id="clipboard-rendered-content"><%- item.contentRendered || '' %></article>
</div>

<% if (isOwn) { %><% include clipboard_v2_script %><% } %>
<% include app_footer %>
