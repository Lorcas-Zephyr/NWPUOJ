<% this.title = '工单' %>
<% include app_header %>
<%
function appTicketQuery(next) {
  const query = {};
  if (isAdmin && filter) query.filter = filter;
  if (categoryFilter) query.category = categoryFilter;
  if (statusFilter) query.status = statusFilter;
  Object.assign(query, next || {});
  Object.keys(query).forEach(function (key) { if (!query[key]) delete query[key]; });
  return syzoj.utils.makeUrl(['tickets'], query);
}
const appCategoryIcons = { problem: 'file-question', contest: 'trophy', article: 'newspaper', user: 'user-round', report: 'flag', other: 'message-square' };
const appStatusClasses = { pending: 'app-status-pending', in_progress: 'app-status-running', resolved: 'app-status-accepted', rejected: 'app-status-rejected', closed: 'app-status-muted' };
%>

<div class="app-page app-tickets-page">
  <header class="app-page-header">
    <div class="app-page-heading"><span class="app-kicker">SUPPORT DESK</span><h1 class="app-page-title">工单</h1><p class="app-page-description"><%= isAdmin ? '集中处理问题反馈、内容举报与账号请求。' : '提交问题并跟踪处理进度。' %></p></div>
    <div class="app-page-actions"><a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['ticket', 'new']) %>"><i data-lucide="plus"></i>新建工单</a></div>
  </header>

  <section class="app-ticket-filters" aria-label="筛选工单">
    <% if (isAdmin) { %><div class="app-filter-row"><span>视角</span><div class="app-segmented"><a class="<%= filter === 'all' ? 'is-active' : '' %>" href="<%= appTicketQuery({ filter: 'all' }) %>">全部</a><a class="<%= filter === 'mine' ? 'is-active' : '' %>" href="<%= appTicketQuery({ filter: 'mine' }) %>">我创建的</a><a class="<%= filter === 'assigned' ? 'is-active' : '' %>" href="<%= appTicketQuery({ filter: 'assigned' }) %>">我处理的</a><a class="<%= filter === 'unassigned' ? 'is-active' : '' %>" href="<%= appTicketQuery({ filter: 'unassigned' }) %>">待认领</a></div></div><% } %>
    <div class="app-filter-row"><span>类别</span><div class="app-filter-links"><a class="<%= !categoryFilter ? 'is-active' : '' %>" href="<%= appTicketQuery({ category: null }) %>">全部</a><% Object.keys(categories).forEach(function (key) { %><a class="<%= categoryFilter === key ? 'is-active' : '' %>" href="<%= appTicketQuery({ category: key }) %>"><%= categories[key].label %></a><% }); %></div></div>
    <div class="app-filter-row"><span>状态</span><div class="app-filter-links"><a class="<%= !statusFilter ? 'is-active' : '' %>" href="<%= appTicketQuery({ status: null }) %>">全部</a><% Object.keys(statusMeta).forEach(function (key) { %><a class="<%= statusFilter === key ? 'is-active' : '' %>" href="<%= appTicketQuery({ status: key }) %>"><%= statusMeta[key].label %></a><% }); %></div></div>
  </section>

  <% if (!tickets.length) { %>
    <div class="app-empty"><div class="app-empty-inner"><i data-lucide="ticket"></i><strong>当前条件下没有工单</strong><p>调整筛选条件，或创建一个新工单。</p><a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['ticket', 'new']) %>">创建工单</a></div></div>
  <% } else { %>
    <div class="app-ticket-list">
      <% for (const ticket of tickets) { const cat = categories[ticket.category]; const state = statusMeta[ticket.status]; const creator = creatorMap[ticket.creator_id]; const assignee = ticket.assignee_id ? assigneeMap[ticket.assignee_id] : null; const subtype = cat ? (cat.subtypes.find(function (item) { return item.value === ticket.subtype; }) || {}).label : ticket.subtype; %>
        <a class="app-ticket-row" href="<%= syzoj.utils.makeUrl(['ticket', ticket.id]) %>">
          <span class="app-ticket-icon"><i data-lucide="<%= appCategoryIcons[ticket.category] || 'message-square' %>"></i></span>
          <span class="app-ticket-main"><span class="app-ticket-title"><strong><%= ticket.title %></strong><small>#<%= ticket.id %></small></span><span class="app-ticket-meta"><span><%= cat ? cat.label : ticket.category %><% if (subtype) { %> · <%= subtype %><% } %></span><% if (creator) { %><span>由 <%- syzoj.utils.renderUsername(creator) %> 创建</span><% } %><span><%= assignee ? '处理人：' : '尚未分配' %><% if (assignee) { %><%- syzoj.utils.renderUsername(assignee) %><% } %></span></span></span>
          <span class="app-ticket-state"><span class="app-status <%= appStatusClasses[ticket.status] || 'app-status-muted' %>"><%= state ? state.label : ticket.status %></span><time><%= syzoj.utils.formatDate(ticket.updated_at) %></time></span>
          <i class="app-ticket-arrow" data-lucide="chevron-right"></i>
        </a>
      <% } %>
    </div>
    <% include app_pagination %>
  <% } %>
  <% if (!isAdmin) { %><p class="app-page-note"><i data-lucide="info"></i>每位用户每 24 小时最多创建 5 个工单。</p><% } %>
</div>

<% include app_footer %>
