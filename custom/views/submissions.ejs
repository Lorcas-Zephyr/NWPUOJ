<% this.title = (typeof displayConfig !== 'undefined' && displayConfig.inContest && typeof contest !== 'undefined' && contest) ? '提交记录 - ' + contest.title : '提交记录' %>
<% include util %>
<%
function submissionStatus(item) {
  if (item.info.adminActionType === 'cheated') return '作弊';
  if (item.info.adminActionType === 'cancelled') return '已取消';
  if (item.result) return item.result.result;
  if (item.running) return 'Judging';
  return 'Waiting';
}
function submissionStatusClass(status) {
  const value = String(status || '').toLowerCase();
  if (value === 'accepted') return 'app-verdict app-verdict-accepted';
  if (value === 'waiting') return 'app-status-waiting';
  if (value === 'judging' || value === 'running' || value === 'compiling') return 'app-status-judging';
  if (value === 'partially correct') return 'app-status-partial';
  if (value === '作弊' || value === 'cheated' || value === 'wrong answer') return 'app-verdict app-verdict-wrong';
  if (value === 'runtime error' || value === 'invalid interaction') return 'app-verdict app-verdict-runtime';
  if (value === 'time limit exceeded') return 'app-verdict app-verdict-time';
  if (value === 'memory limit exceeded' || value === 'output limit exceeded') return 'app-verdict app-verdict-memory';
  if (value.includes('error') || value === 'judgement failed') return 'app-verdict app-verdict-compile';
  return '';
}
function submissionFormatSize(bytes) {
  let value = Number(bytes || 0);
  const units = ['B', 'K', 'M', 'G'];
  let unit = 0;
  while (value >= 1024 && unit < units.length - 1) { value /= 1024; unit += 1; }
  return (value === Math.round(value) ? value : value.toFixed(1)) + ' ' + units[unit];
}
function submissionUserTier(userId) {
  if (syzoj.adminUserIds && syzoj.adminUserIds.has(userId)) return 'admin';
  if (syzoj.cheaterUserIds && syzoj.cheaterUserIds.has(userId)) return 'cheater';
  if (syzoj.userHitScores && syzoj.userHitScores.has(userId)) {
    const hit = syzoj.userHitScores.get(userId).total || 0;
    if (hit >= 350) return 'red';
    if (hit >= 280) return 'orange';
    if (hit >= 200) return 'green';
    if (hit >= 100) return 'blue';
  }
  return 'default';
}
function submissionUserTag(userId) {
  if (syzoj.cheaterUserIds && syzoj.cheaterUserIds.has(userId) && !(syzoj.adminUserIds && syzoj.adminUserIds.has(userId))) return { text: '作弊者', tier: 'cheater' };
  if (syzoj.userTagsEnabled !== false && syzoj.userTags && syzoj.userTags.has(userId)) return syzoj.userTags.get(userId);
  return null;
}
function submissionLink(item) {
  return displayConfig.inContest ? syzoj.utils.makeUrl(['contest', 'submission', item.info.submissionId]) : syzoj.utils.makeUrl(['submission', item.info.submissionId]);
}
function submissionProblemLink(item) {
  return displayConfig.inContest ? syzoj.utils.makeUrl(['contest', contest.id, 'problem', item.info.problemId]) : syzoj.utils.makeUrl(['problem', item.info.sourceProblemId || item.info.problemId]);
}
%>
<% include app_header %>
<% if (typeof problemContext !== 'undefined' && problemContext) { %><% include problem_context %><% } else if (typeof contestHeader !== 'undefined' && contestHeader) { %><% include contest_context %><% } %>

<div class="app-page app-submissions-page">
  <% if ((typeof problemContext === 'undefined' || !problemContext) && !displayConfig.inContest) { %><header class="app-page-header">
    <div class="app-page-heading">
      <span class="app-kicker">JUDGE ACTIVITY</span>
      <h1 class="app-page-title">评测记录</h1>
      <p class="app-page-description">跟踪评测状态，并按题目、用户、语言或结果定位提交。</p>
    </div>
  </header><% } else if (typeof problemContext !== 'undefined' && problemContext) { %><div class="app-section-header app-context-section-header"><div><h2 class="app-section-title">提交记录</h2><p class="app-section-description">跟踪当前题目的评测状态。</p></div></div><% } %>

  <details class="app-filter-section"<%= isFiltered ? ' open' : '' %>>
    <summary><span><i data-lucide="list-filter"></i>筛选评测</span><span><%= isFiltered ? '已启用筛选' : '展开筛选条件' %><i data-lucide="chevron-down"></i></span></summary>
    <form action="<%= syzoj.utils.makeUrl(displayConfig.inContest ? ['contest', contest.id, 'submissions'] : ['submissions']) %>" class="app-form app-submission-filter" method="get" id="submission-filter-form">
      <% if (!displayConfig.inContest && form.contest) { %><input type="hidden" name="contest" value="<%= form.contest %>"><% } %>
      <div class="app-form-grid">
        <label class="app-field app-field-third"><span class="app-label">题目编号</span><input class="app-input" name="problem_id" inputmode="numeric" value="<%= form.problem_id || '' %>"></label>
        <% if (displayConfig.showOthers) { %><label class="app-field app-field-third"><span class="app-label">提交者</span><input class="app-input" name="submitter" value="<%= form.submitter || '' %>"></label><% } %>
        <label class="app-field app-field-third"><span class="app-label">语言</span><select class="app-select" name="language"><option value="">不限</option><option value="submit-answer"<%= form.language === 'submit-answer' ? ' selected' : '' %>>提交答案</option><option value="non-submit-answer"<%= form.language === 'non-submit-answer' ? ' selected' : '' %>>非提交答案</option><optgroup label="本地语言"><% for (const lang of syzoj.config.filter_enabled_languages) { %><option value="<%= lang %>"<%= form.language === lang ? ' selected' : '' %>><%= syzoj.languages[lang].show %></option><% } %></optgroup><% for (const provider of Object.keys(vjudge.languages)) { %><optgroup label="<%= provider %>"><% for (const lang of Object.keys(vjudge.languages[provider]).sort((a, b) => vjudge.languages[provider][a].index - vjudge.languages[provider][b].index)) { %><option value="<%= lang %>"<%= form.language === lang ? ' selected' : '' %>><%= vjudge.languages[provider][lang].show %></option><% } %></optgroup><% } %></select></label>
        <% if (displayConfig.showScore) { %><label class="app-field app-field-quarter"><span class="app-label">最低分</span><input class="app-input" name="min_score" type="number" min="0" max="100" placeholder="0" value="<%= form.min_score || '' %>"></label><label class="app-field app-field-quarter"><span class="app-label">最高分</span><input class="app-input" name="max_score" type="number" min="0" max="100" placeholder="100" value="<%= form.max_score || '' %>"></label><% } %>
        <% if (displayConfig.showResult) { %><label class="app-field app-field-quarter"><span class="app-label">状态</span><select class="app-select" name="status"><option value="">不限</option><% for (const status of ['Accepted', 'Wrong Answer', 'Partially Correct', 'Compile Error', 'Runtime Error', 'Time Limit Exceeded', 'Memory Limit Exceeded', 'Output Limit Exceeded', 'System Error', 'Cancelled', 'Cheated']) { %><option value="<%= status %>"<%= form.status === status ? ' selected' : '' %>><%= status %></option><% } %></select></label><% } %>
      </div>
      <div class="app-form-actions">
        <% if (user && displayConfig.showOthers) { %><div class="app-segmented" aria-label="提交范围"><button type="button" aria-pressed="<%= !form.submitter ? 'true' : 'false' %>" data-submission-scope="all">全部</button><button type="button" aria-pressed="<%= form.submitter === user.username ? 'true' : 'false' %>" data-submission-scope="mine">我的</button></div><% } %>
        <span class="app-inline-actions"><% if (isFiltered) { %><a class="app-button app-button-quiet" href="<%= syzoj.utils.makeUrl(displayConfig.inContest ? ['contest', contest.id, 'submissions'] : ['submissions'], displayConfig.inContest ? {} : (form.contest ? { contest: form.contest } : {})) %>">清除</a><% } %><button class="app-button app-button-primary" type="submit"><i data-lucide="search"></i>应用筛选</button></span>
      </div>
    </form>
  </details>

  <% if (items.length) { %>
    <div class="app-table-region" role="region" aria-label="评测记录" tabindex="0">
      <table class="app-table app-submissions-table">
        <thead><tr><th>编号</th><th class="app-cell-primary">题目</th><th>状态</th><% if (displayConfig.showScore) { %><th>分数</th><% } %><% if (displayConfig.showUsage) { %><th>时间</th><th>内存</th><% } %><% if (displayConfig.showCode) { %><th>代码</th><% } %><th>提交者</th><th>提交时间</th></tr></thead>
        <tbody>
          <% for (const item of items) { const status = submissionStatus(item); const tag = submissionUserTag(item.info.userId); const canView = item.info.canViewDetail !== false; %>
            <tr data-submission-id="<%= item.info.submissionId %>">
              <td class="app-cell-number"><% if (canView) { %><a href="<%= submissionLink(item) %>">#<%= item.info.submissionId %></a><% } else { %><strong>#<%= item.info.submissionId %></strong><% } %></td>
              <td class="app-cell-primary"><a href="<%= submissionProblemLink(item) %>"><strong><%= displayConfig.inContest ? this.alpha(item.info.problemId) : item.info.problemDisplayId %>.</strong> <%= item.info.problemName %></a></td>
              <td><% if (canView) { %><a href="<%= submissionLink(item) %>" class="app-status <%= submissionStatusClass(status) %>" data-submission-status><%= status %></a><% } else { %><span class="app-status <%= submissionStatusClass(status) %>" data-submission-status><%= status %></span><% } %></td>
              <% if (displayConfig.showScore) { const score = item.info.adminActionType ? 0 : (item.result ? Math.floor(item.result.score || 0) : 0); %><td class="app-cell-number"><span class="app-score <%= score === 100 ? 'app-score-perfect' : score === 0 ? 'app-score-zero' : '' %>" data-submission-score><%= score %></span></td><% } %>
              <% if (displayConfig.showUsage) { %><td class="app-cell-number" data-submission-time><%= item.result ? (item.result.time || 0) + ' ms' : '0 ms' %></td><td class="app-cell-number" data-submission-memory><%= item.result ? submissionFormatSize((item.result.memory || 0) * 1024) : '0 B' %></td><% } %>
              <% if (displayConfig.showCode) { %><td><% if (item.info.language) { %><strong><%= item.info.language %></strong> · <% } %><%= submissionFormatSize(item.info.codeSize) %></td><% } %>
              <td><a href="<%= syzoj.utils.makeUrl(['user', item.info.userId]) %>" class="username-tier-<%= submissionUserTier(item.info.userId) %>"><%= item.info.user %></a><% if (tag && tag.text) { %><span class="user-name-tag tag-tier-<%= tag.tier || 'default' %>"><%= tag.text %></span><% } %></td>
              <td class="app-cell-number"><%= item.info.submitTime %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% include app_pagination %>
  <% } else { %>
    <div class="app-empty"><div class="app-empty-inner"><i data-lucide="<%= isFiltered ? 'search-x' : 'file-clock' %>"></i><strong><%= isFiltered ? '没有匹配的提交' : '暂无提交' %></strong><p><%= isFiltered ? '调整筛选条件后再试。' : '新的提交会显示在这里。' %></p></div></div>
  <% } %>
</div>

<script>
(function () {
  var form = document.getElementById('submission-filter-form');
  document.querySelectorAll('[data-submission-scope]').forEach(function (button) {
    button.addEventListener('click', function () {
      var field = form.querySelector('[name="submitter"]');
      if (field) field.value = button.getAttribute('data-submission-scope') === 'mine' ? <%- serializejs(user ? user.username : '') %> : '';
      form.submit();
    });
  });
})();
</script>

<script>
(function () {
  var itemList = <%- serializejs(items) %>;
  var pendingTasks = new Set(itemList.filter(function (item) { return item.token; }).map(function (item) { return item.info.taskId; }));
  if (!pendingTasks.size) return;
  var retryDelay = 1000;

  function statusClass(status) {
    var value = String(status || '').toLowerCase();
    if (value === 'accepted') return 'app-verdict app-verdict-accepted';
    if (value === 'waiting') return 'app-status-waiting';
    if (value === 'judging' || value === 'running' || value === 'compiling') return 'app-status-judging';
    if (value === 'partially correct') return 'app-status-partial';
    if (value === '作弊' || value === 'cheated' || value === 'wrong answer') return 'app-verdict app-verdict-wrong';
    if (value === 'runtime error' || value === 'invalid interaction') return 'app-verdict app-verdict-runtime';
    if (value === 'time limit exceeded') return 'app-verdict app-verdict-time';
    if (value === 'memory limit exceeded' || value === 'output limit exceeded') return 'app-verdict app-verdict-memory';
    if (value.includes('error') || value === 'judgement failed') return 'app-verdict app-verdict-compile';
    return '';
  }
  function size(bytes) {
    var value = Number(bytes || 0); var units = ['B', 'K', 'M', 'G']; var unit = 0;
    while (value >= 1024 && unit < units.length - 1) { value /= 1024; unit += 1; }
    return (value === Math.round(value) ? value : value.toFixed(1)) + ' ' + units[unit];
  }
  function applyStatus(update) {
    var item = itemList.find(function (entry) { return entry.info.submissionId === update.submissionId; });
    var row = document.querySelector('[data-submission-id="' + update.submissionId + '"]');
    if (!item || !row) return;
    item.result = update.result;
    item.running = !!update.pending;
    var label = update.result ? update.result.result : (update.pending ? 'Judging' : 'Waiting');
    var status = row.querySelector('[data-submission-status]');
    status.textContent = label;
    status.className = 'app-status ' + statusClass(label);
    var score = row.querySelector('[data-submission-score]');
    if (score) { var value = update.result ? Math.floor(update.result.score || 0) : 0; score.textContent = value; score.className = 'app-score ' + (value === 100 ? 'app-score-perfect' : value === 0 ? 'app-score-zero' : ''); }
    var time = row.querySelector('[data-submission-time]');
    if (time) time.textContent = (update.result ? update.result.time || 0 : 0) + ' ms';
    var memory = row.querySelector('[data-submission-memory]');
    if (memory) memory.textContent = size((update.result ? update.result.memory || 0 : 0) * 1024);
    if (!update.pending) pendingTasks.delete(item.info.taskId);
  }
  async function connect() {
    var pendingItems = itemList.filter(function (item) { return pendingTasks.has(item.info.taskId) && item.token; });
    if (!pendingItems.length) return;
    var body = new URLSearchParams({ tokens: JSON.stringify(pendingItems.map(function (item) { return item.token; })) });
    var received = false;
    try {
      var response = await fetch('/api/v2/submissions/events', { method: 'POST', credentials: 'same-origin', cache: 'no-store', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body });
      if (response.status === 403) return window.location.reload();
      if (!response.ok || !response.body) throw new Error('stream unavailable');
      var reader = response.body.getReader(); var decoder = new TextDecoder(); var buffer = '';
      while (true) {
        var chunk = await reader.read(); if (chunk.done) break;
        buffer += decoder.decode(chunk.value, { stream: true }).replace(/\r\n/g, '\n');
        var boundary;
        while ((boundary = buffer.indexOf('\n\n')) !== -1) {
          var message = buffer.slice(0, boundary); buffer = buffer.slice(boundary + 2); var event = 'message'; var data = '';
          message.split('\n').forEach(function (line) { if (line.startsWith('event:')) event = line.slice(6).trim(); if (line.startsWith('data:')) data += line.slice(5).trim(); });
          if (event === 'refresh-required') return window.location.reload();
          if (event === 'status' && data) { received = true; applyStatus(JSON.parse(data)); }
        }
      }
    } catch (error) {}
    if (pendingTasks.size) { var delay = retryDelay; retryDelay = received ? 1000 : Math.min(retryDelay * 2, 30000); window.setTimeout(connect, delay); }
  }
  connect();
})();
</script>

<% include app_footer %>
