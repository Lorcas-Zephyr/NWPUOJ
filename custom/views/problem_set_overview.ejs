<% this.title = problemSet.title + ' - 题单'; const problemSetActiveSection='problems'; function itemAlpha(value){let number=Number(value),result='';while(number>0){number--;result=String.fromCharCode(65+number%26)+result;number=Math.floor(number/26);}return result;} %>
<% include app_header %><% include problem_set_context %>
<div class="app-page app-problem-set-page">
  <% if(problemSetDescription){%><section class="app-section app-markdown"><%- problemSetDescription %></section><%}%>
  <% if(!problemSetAccess.participant&&!problemSetAccess.manager){%><div class="app-notice"><i data-lucide="user-plus"></i><span><strong><%= problemSet.allow_registration?'报名后开始题单':'题单不开放自行报名' %></strong><small><%= problemSet.allow_registration?'报名后可提交并进入榜单。':'请联系题单管理员加入报名名单。' %></small></span><% if(problemSet.allow_registration&&problemSetAccess.open&&user){%><button class="app-button app-button-primary" type="button" data-set-register>报名</button><%}%></div><%}%>
  <section class="app-section"><div class="app-section-header"><div><h2 class="app-section-title">题目列表</h2><p class="app-section-description"><%= problemSetItems.length %> 道题 · <%= ({acm:'ACM',ioi:'IOI',noi:'NOI'})[problemSet.ranking_mode] %> 榜单</p></div></div><% if(problemSetItems.length){%><div class="app-table-region"><table class="app-table"><thead><tr><th>序号</th><th class="app-cell-primary">题目</th><th>尝试</th><th>状态</th></tr></thead><tbody><% problemSetItems.forEach(function(item){const state=problemSetProgress.get(item.problem_id);%><tr><td class="app-cell-number"><%= itemAlpha(item.ordinal) %></td><td class="app-cell-primary"><a href="/problem-set/<%= problemSet.id %>/problem/<%= item.ordinal %>"><strong><%= item.title %></strong></a><small>#<%= item.problem_id %></small></td><td><%= state?state.attempts:0 %></td><td><% if(state&&Number(state.accepted)){%><span class="app-status app-status-accepted">已通过</span><%}else if(state){%><span class="app-status app-status-running"><%= Math.round(Number(state.best_score||0)) %> 分</span><%}else{%><span class="app-status app-status-muted">未尝试</span><%}%></td></tr><%});%></tbody></table></div><%}else{%><div class="app-empty app-empty-compact"><div class="app-empty-inner"><i data-lucide="list-x"></i><strong>题单尚未添加题目</strong></div></div><%}%></section>
</div>
<script>(function(){var button=document.querySelector('[data-set-register]');if(!button)return;button.addEventListener('click',async function(){button.disabled=true;var response=await fetch('/api/v2/problem-sets/<%= problemSet.id %>/registration',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:'{}'});var body=await response.json().catch(function(){return null;});if(!response.ok){button.disabled=false;if(window.NWPUOJApp)window.NWPUOJApp.showToast(body&&body.error&&body.error.message||'报名失败。','danger');return;}location.reload();});})();</script>
<% include app_footer %>
