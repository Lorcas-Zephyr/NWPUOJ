<% this.title = '站内信' %>
<% include app_header %>

<div class="app-page app-messages-page">
  <header class="app-page-header"><div class="app-page-heading"><span class="app-kicker">MESSAGES</span><h1 class="app-page-title">站内信</h1><p class="app-page-description">与平台用户进行一对一沟通。</p></div><div class="app-page-actions"><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['messages', 'settings']) %>"><i data-lucide="settings"></i>设置</a><a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['messages', 'new']) %>"><i data-lucide="square-pen"></i>新对话</a></div></header>
  <% if (conversations.length) { %><div class="app-conversation-list"><% for (const conversation of conversations) { const appPreview = conversation.last_message ? String(conversation.last_message.content || '').replace(/\n/g, ' ').substring(0, 80) : ''; %><a href="<%= syzoj.utils.makeUrl(['messages', 'with', conversation.partner.id]) %>" class="<%= conversation.unread > 0 ? 'is-unread' : '' %>"><img src="<%= syzoj.utils.avatar(conversation.partner, 80) %>" alt=""><span class="app-conversation-main"><span><strong><%= conversation.partner.username %></strong><% if (conversation.unread > 0) { %><em><%= conversation.unread > 99 ? '99+' : conversation.unread %></em><% } %></span><small><% if (conversation.last_message && conversation.last_message.sender_id === user.id) { %>我：<% } %><%= appPreview %><%= conversation.last_message && String(conversation.last_message.content || '').length > 80 ? '...' : '' %></small></span><time><%= syzoj.utils.formatDate(conversation.last_time) %></time><i data-lucide="chevron-right"></i></a><% } %></div><% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="inbox"></i><strong>暂无对话</strong><p>向其他用户发送消息后，对话会显示在这里。</p><a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['messages', 'new']) %>">发起新对话</a></div></div><% } %>
</div>

<% include app_footer %>
