<% this.title = '通知中心' %>
<% include app_header %>

<div class="app-page app-notifications-page">
  <header class="app-page-header"><div class="app-page-heading"><span class="app-kicker">NOTIFICATIONS</span><h1 class="app-page-title">通知中心</h1><p class="app-page-description"><%= unreadCount > 0 ? unreadCount + ' 条通知尚未阅读。' : '所有通知均已阅读。' %></p></div><% if (totalCount > 0 && unreadCount > 0) { %><form method="post" data-notification-v2="read-all" data-confirm="确认将所有通知标记为已读吗？"><button class="app-button app-button-secondary" type="submit"><i data-lucide="check-check"></i>全部已读</button></form><% } %></header>
  <nav class="app-tabs" aria-label="通知筛选"><a class="app-tab<%= filter === 'all' ? ' is-active' : '' %>" href="<%= syzoj.utils.makeUrl(['notifications']) %>">全部 <span class="app-tab-count"><%= totalCount %></span></a><a class="app-tab<%= filter === 'unread' ? ' is-active' : '' %>" href="<%= syzoj.utils.makeUrl(['notifications'], { filter: 'unread' }) %>">未读 <span class="app-tab-count"><%= unreadCount %></span></a></nav>
  <% if (notifications.length) { %><div class="app-notification-list"><% for (const notification of notifications) { %><article class="<%= notification.is_read ? '' : 'is-unread' %>"><span class="app-notification-marker"></span><div class="app-notification-main"><header><strong><%= notification.title %></strong><time><%= syzoj.utils.formatDate(notification.created_at) %></time></header><% if (notification.content) { %><p><%= notification.content %></p><% } %><small><% if (notification.actor) { %>来自 <a href="<%= syzoj.utils.makeUrl(['user', notification.actor.id]) %>"><%= notification.actor.username %></a><% } else { %>系统通知<% } %></small></div><div class="app-notification-actions"><% if (notification.source_url) { %><form method="post" data-notification-v2="read" data-notification-id="<%= notification.id %>"><button class="app-icon-button" type="submit" aria-label="查看通知" title="查看通知"><i data-lucide="arrow-right"></i></button></form><% } %><form method="post" data-notification-v2="delete" data-notification-id="<%= notification.id %>" data-confirm="确认删除此通知吗？"><button class="app-icon-button" type="submit" aria-label="删除通知" title="删除通知"><i data-lucide="trash"></i></button></form></div></article><% } %></div><% include app_pagination %><% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="bell-off"></i><strong><%= filter === 'unread' ? '没有未读通知' : '暂无通知' %></strong><p>新的账号、社区和比赛通知会显示在这里。</p></div></div><% } %>
</div>

<script>
(function () {
  function operationKey() { return window.crypto && window.crypto.randomUUID ? window.crypto.randomUUID() : String(Date.now()) + Math.random(); }
document.addEventListener('submit', async function (event) {
    var form = event.target.closest('[data-notification-v2]'); if (!form || event.defaultPrevented) return;
    event.preventDefault(); var action = form.dataset.notificationV2; var id = form.dataset.notificationId; var button = form.querySelector('button[type="submit"]'); if (button) button.disabled = true;
    var endpoint = action === 'read-all' ? '/api/v2/notifications/read-all' : '/api/v2/notifications/' + encodeURIComponent(id) + (action === 'read' ? '/read' : '');
    try {
      var response = await fetch(endpoint, { method: action === 'delete' ? 'DELETE' : 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Idempotency-Key': operationKey() }, body: action === 'delete' ? undefined : '{}' });
      var body = await response.json();
      if (!response.ok) throw new Error(body.error && body.error.message || '通知操作失败');
      if (action === 'read' && body.data && body.data.source_url) window.location.assign(body.data.source_url); else window.location.reload();
    } catch (error) {
      if (button) button.disabled = false;
      if (window.NWPUOJApp) window.NWPUOJApp.showToast(error.message || '通知操作失败。', 'danger');
    }
  });
})();
</script>

<% include app_footer %>
