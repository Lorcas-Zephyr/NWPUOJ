<% this.title = '登录'; %>
<% include header %>
<div class="nwpuoj-auth-page nwpuoj-auth-page--compact">
  <div class="ui message" id="login-message" hidden>
    <p id="login-message-content"></p>
  </div>
  <div class="ui middle aligned center aligned grid">
    <div class="row">
      <div class="column">
        <h2 class="ui image header"><div class="content">登录</div></h2>
        <form class="ui large form" id="login-form">
          <div class="ui existing segment">
            <div class="field">
              <div class="ui left icon input">
                <i class="user icon"></i>
                <input name="username" placeholder="用户名" type="text" id="username" autocomplete="username" required autofocus>
              </div>
            </div>
            <div class="field">
              <div class="ui left icon input">
                <i class="lock icon"></i>
                <input name="password" placeholder="密码" type="password" id="password" maxlength="128" autocomplete="current-password" required>
              </div>
            </div>
            <button type="submit" class="ui fluid large submit button" id="login-button">登录</button>
            <div style="margin-top: 1rem"><a href="<%= syzoj.utils.makeUrl(['forget']) %>">忘记密码</a></div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
(function () {
  var form = document.getElementById('login-form');
  var button = document.getElementById('login-button');
  var message = document.getElementById('login-message');
  var content = document.getElementById('login-message-content');
  var redirectUrl = <%- serializejs(syzoj.utils.safeLocalUrl(req.query.url, '/')) %>;

  function showError(text) {
    message.className = 'ui error message';
    content.textContent = text;
    message.hidden = false;
  }

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    button.classList.add('loading');
    var params = new URLSearchParams();
    params.append('username', document.getElementById('username').value);
    params.append('password', document.getElementById('password').value);
    fetch('/api/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: params.toString()
    }).then(function (response) {
      return response.json().then(function (data) { return { status: response.status, data: data }; });
    }).then(function (result) {
      if (result.data.error_code === 1) return window.location.assign(redirectUrl);
      if (result.status === 429) showError('登录尝试过于频繁，请稍后再试。');
      else showError('用户名或密码错误。');
      button.classList.remove('loading');
    }).catch(function () {
      showError('登录服务暂时不可用。');
      button.classList.remove('loading');
    });
  });
})();
</script>
<% include footer %>
