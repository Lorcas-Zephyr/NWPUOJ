<% this.title = '与 ' + partner.username + ' 的对话' %>
<% include app_header %>

<div class="app-page app-message-thread-page">
  <nav class="app-breadcrumb" aria-label="面包屑"><a href="<%= syzoj.utils.makeUrl(['messages']) %>">站内信</a><i data-lucide="chevron-right"></i><span><%= partner.username %></span></nav>
  <header class="app-message-thread-header"><a href="<%= syzoj.utils.makeUrl(['user', partner.id]) %>"><img src="<%= syzoj.utils.avatar(partner, 80) %>" alt=""><span><strong><%= partner.username %></strong><small>UID #<%= partner.id %></small></span></a><button class="app-button app-button-danger-outline" type="button" data-message-v2-delete-conversation="<%= partner.id %>" data-confirm="确定删除整个对话历史吗？对方仍能看到自己的副本。"><i data-lucide="trash"></i>清空对话</button></header>
  <% if (messages.length) { %><div class="app-message-stream" data-message-stream><% for (const message of messages) { %><article class="app-message-bubble<%= message.is_self ? ' is-self' : '' %>"><img src="<%= syzoj.utils.avatar(message.is_self ? user : partner, 72) %>" alt=""><div><div class="app-markdown"><%- message.contentRendered %></div><footer><time><%= syzoj.utils.formatDate(message.public_time) %></time><% if (message.is_self) { %><a href="#" data-message-v2-delete="<%= message.id %>" data-confirm="确定删除这条消息吗？">删除</a><% } %></footer></div></article><% } %></div><% } else { %><div class="app-empty app-empty-compact"><div class="app-empty-inner"><i data-lucide="message-circle"></i><strong>还没有消息</strong><p>在下方发送第一条消息。</p></div></div><% } %>
  <% if (canReply) { %><form class="app-form app-message-reply" method="post" data-message-v2="reply" data-message-recipient-id="<%= partner.id %>"><label class="app-field"><span class="app-label">回复 <%= partner.username %></span><textarea class="app-textarea" name="content" rows="4" maxlength="5000" required></textarea></label><div class="app-form-actions app-form-actions-end"><button class="app-button app-button-primary" type="submit"><i data-lucide="send"></i>发送</button></div></form><% } else { %><div class="app-notice app-notice-warning"><i data-lucide="ban"></i><span><%= cannotReplyReason || '无法回复对方。' %></span></div><% } %>
</div>

<script>var stream = document.querySelector('[data-message-stream]'); if (stream) stream.scrollTop = stream.scrollHeight;</script>
<% include messages_v2_script %>
<% include app_footer %>
