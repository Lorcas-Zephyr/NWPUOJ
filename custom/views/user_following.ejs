<% this.title = (listType === 'following' ? '关注列表' : '粉丝列表') + ' - ' + show_user.username %>
<% include app_header %>

<div class="app-page app-follow-page">
  <nav class="app-breadcrumb" aria-label="面包屑"><a href="<%= syzoj.utils.makeUrl(['user', show_user.id]) %>"><%= show_user.username %></a><i data-lucide="chevron-right"></i><span><%= listType === 'following' ? '关注' : '粉丝' %></span></nav>
  <header class="app-page-header"><div class="app-page-heading"><span class="app-kicker">CONNECTIONS</span><h1 class="app-page-title"><%= listType === 'following' ? show_user.username + ' 关注的人' : show_user.username + ' 的粉丝' %></h1><p class="app-page-description">共 <%= total %> 人</p></div></header>
  <nav class="app-tabs" aria-label="关注列表类型"><a class="app-tab<%= listType === 'following' ? ' is-active' : '' %>" href="<%= syzoj.utils.makeUrl(['user', show_user.id, 'following']) %>"><i data-lucide="user-check"></i>关注</a><a class="app-tab<%= listType === 'followers' ? ' is-active' : '' %>" href="<%= syzoj.utils.makeUrl(['user', show_user.id, 'followers']) %>"><i data-lucide="users"></i>粉丝</a></nav>
  <% if (users.length) { %><div class="app-user-list"><% for (const listedUser of users) { %><a href="<%= syzoj.utils.makeUrl(['user', listedUser.id]) %>"><img src="<%= syzoj.utils.avatar(listedUser, 80) %>" alt=""><span><strong><%= listedUser.username %></strong><small><%= listedUser.information ? listedUser.information.substring(0, 100).replace(/[<>]/g, '') : '暂无个性签名' %></small></span><time><%= listType === 'following' ? '关注于 ' : '关注我于 ' %><%= syzoj.utils.formatDate(listedUser.followedAt) %></time><i data-lucide="chevron-right"></i></a><% } %></div><% include app_pagination %><% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="user-round-x"></i><strong><%= listType === 'following' ? '还没有关注任何人' : '还没有粉丝' %></strong><p>新的关系会显示在这里。</p></div></div><% } %>
</div>

<% include app_footer %>
