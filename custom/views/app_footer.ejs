  <script>
    (function () {
      function renderPageIcons() {
        return typeof window.__NWPUOJ_RENDER_ICONS === 'function' && window.__NWPUOJ_RENDER_ICONS(document);
      }
      function scheduleIconRender() {
        renderPageIcons();
        window.setTimeout(renderPageIcons, 0);
        window.setTimeout(renderPageIcons, 120);
        window.setTimeout(renderPageIcons, 600);
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', scheduleIconRender);
      else scheduleIconRender();
      window.addEventListener('load', scheduleIconRender);
    })();
  </script>
