        try { return new URL(typeof input === 'string' ? input : input.url, window.location.href).origin === window.location.origin; } catch (_) { return false; }
      }
      window.fetch = function (input, options) {
        var next = Object.assign({}, options || {});
        var method = String(next.method || (typeof input !== 'string' && input.method) || 'GET').toUpperCase();
