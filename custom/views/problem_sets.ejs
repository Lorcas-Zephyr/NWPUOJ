<% this.title = '题单' %>
<%
const listFilters = typeof problemSetListFilters !== 'undefined' ? problemSetListFilters : { state: 'all', mine: false, participating: false };
const listTotal = typeof problemSetListTotal !== 'undefined' ? problemSetListTotal : problemSets.length;
const listCount = typeof problemSetListCounts !== 'undefined' ? problemSetListCounts.all : problemSets.length;
%>
<% include app_header %>
<div class="app-page app-problem-sets-page">
  <header class="app-page-header"><div class="app-page-heading"><span class="app-kicker">PROBLEM SETS</span><h1 class="app-page-title">题单</h1><p class="app-page-description">按计划完成训练，查看进度与榜单。</p></div><% if (canCreateProblemSet) { %><div class="app-page-actions"><a class="app-button app-button-primary" href="/problem-set/new"><i data-lucide="plus"></i>创建题单</a></div><% } %></header>
    <div class="app-contest-toolbar">
      <div class="app-segmented" role="group" aria-label="题单筛选"><button type="button" data-set-filter="all" aria-pressed="<%= listFilters.state === 'all' %>">全部 <span><%= listCount %></span></button><button type="button" data-set-filter="open" aria-pressed="<%= listFilters.state === 'open' %>">进行中</button><button type="button" data-set-filter="ended" aria-pressed="<%= listFilters.state === 'ended' %>">已截止</button></div>
      <% if (user) { %>
      <div class="app-contest-personal-filters" role="group" aria-label="与我相关的题单">
        <button class="app-button app-button-secondary app-filter-toggle" type="button" data-set-mine aria-pressed="<%= listFilters.mine %>"><i data-lucide="user-round"></i>我创建的</button>
        <button class="app-button app-button-secondary app-filter-toggle" type="button" data-set-participating aria-pressed="<%= listFilters.participating %>"><i data-lucide="check-circle-2"></i>我参加的</button>
      </div>
      <% } %>
      <span class="app-contest-result-count" aria-live="polite">共 <strong data-set-count><%= listTotal %></strong> 个</span>
    </div>
  <% if (problemSets.length) { %>
    <section class="app-contest-list" data-set-list>
      <% const now = Math.floor(Date.now() / 1000); problemSets.forEach(function (set) { const ended = !!(set.deadline_at && Number(set.deadline_at) <= now); %>
      <article class="app-contest-list-row" data-set-state="<%= ended ? 'ended' : 'open' %>" data-set-owner="<%= set.owner_id %>" data-set-registered="<%= Number(set.registered) > 0 ? '1' : '0' %>">
        <div class="app-contest-list-main"><span class="app-contest-state-marker is-<%= ended ? 'ended' : 'running' %>"></span><span><span class="app-row-title"><a href="/problem-set/<%= set.id %>"><%= set.title %></a></span><span class="app-list-meta"><span><%= ({acm:'ACM',ioi:'IOI',noi:'NOI'})[set.ranking_mode] %></span><span><%= set.problem_count %> 题</span><span><%= set.visibility === 'public' ? '公开' : '隐藏' %></span><% if (set.status !== 'published') { %><span>草稿</span><% } %></span></span></div>
        <div class="app-contest-list-schedule"><strong><%= set.deadline_at ? syzoj.utils.formatDate(set.deadline_at) : '无限期' %></strong><span>创建者 <%= set.owner_username %></span></div>
        <div class="app-contest-list-attendance"><span><i data-lucide="users-round"></i><%= set.participant_count %></span><span class="app-status <%= ended ? 'app-status-muted' : 'app-status-running' %>"><%= ended ? '已截止' : '进行中' %></span></div>
        <div class="app-contest-list-action"><% if (Number(set.owner_id) === Number(user && user.id) || user && user.is_admin) { %><a class="app-button app-button-secondary" href="/problem-set/<%= set.id %>/edit"><i data-lucide="settings"></i>管理</a><% } else { %><a class="app-button app-button-secondary" href="/problem-set/<%= set.id %>">查看</a><% } %></div>
      </article>
      <% }); %>
    </section>
  <% } else { %>
    <div class="app-empty" data-set-empty><div class="app-empty-inner"><i data-lucide="list-checks"></i><strong>当前条件没有题单</strong><p>切换筛选条件查看其他题单。</p></div></div>
  <% } %>
  <% include app_pagination %>
</div>
<script>
(function () {
  function select(key, value) {
    var url = new URL(window.location.href);
    url.searchParams.delete('page');
    if (value) url.searchParams.set(key, value);
    else url.searchParams.delete(key);
    window.location.assign(url.pathname + url.search);
  }
  document.querySelectorAll('[data-set-filter]').forEach(function (button) {
    button.addEventListener('click', function () { select('state', button.dataset.setFilter === 'all' ? '' : button.dataset.setFilter); });
  });
  var mine = document.querySelector('[data-set-mine]');
  var participating = document.querySelector('[data-set-participating]');
  if (mine) mine.addEventListener('click', function () { select('mine', mine.getAttribute('aria-pressed') === 'true' ? '' : '1'); });
  if (participating) participating.addEventListener('click', function () { select('participating', participating.getAttribute('aria-pressed') === 'true' ? '' : '1'); });
})();
</script>
<% include app_footer %>
