<% this.title = '题单' %>
<% include app_header %>
<div class="app-page app-problem-sets-page">
  <header class="app-page-header"><div class="app-page-heading"><span class="app-kicker">PROBLEM SETS</span><h1 class="app-page-title">题单</h1><p class="app-page-description">按计划完成训练，查看进度与榜单。</p></div><% if (canCreateProblemSet) { %><div class="app-page-actions"><a class="app-button app-button-primary" href="/problem-set/new"><i data-lucide="plus"></i>创建题单</a></div><% } %></header>
  <% if (problemSets.length) { %><div class="app-contest-toolbar"><div class="app-segmented" role="group" aria-label="题单筛选"><button type="button" data-set-filter="all" aria-pressed="true">全部 <span><%= problemSets.length %></span></button><button type="button" data-set-filter="open" aria-pressed="false">进行中</button><button type="button" data-set-filter="ended" aria-pressed="false">已截止</button></div><% if(user){%><button class="app-button app-button-secondary" type="button" data-set-mine aria-pressed="false"><i data-lucide="user-round"></i>我创建的</button><button class="app-button app-button-secondary" type="button" data-set-participating aria-pressed="false"><i data-lucide="check-circle-2"></i>我参加的</button><%}%><span class="app-contest-result-count">显示 <strong data-set-count><%= problemSets.length %></strong> 个</span></div><section class="app-contest-list" data-set-list><% const now=Math.floor(Date.now()/1000); problemSets.forEach(function(set){ const ended=!!(set.deadline_at&&Number(set.deadline_at)<=now); %><article class="app-contest-list-row" data-set-state="<%= ended?'ended':'open' %>" data-set-owner="<%= set.owner_id %>" data-set-registered="<%= Number(set.registered) > 0 ? '1' : '0' %>"><div class="app-contest-list-main"><span class="app-contest-state-marker is-<%= ended?'ended':'running' %>"></span><span><span class="app-row-title"><a href="/problem-set/<%= set.id %>"><%= set.title %></a></span><span class="app-list-meta"><span><%= ({acm:'ACM',ioi:'IOI',noi:'NOI'})[set.ranking_mode] %></span><span><%= set.problem_count %> 题</span><span><%= set.visibility==='public'?'公开':'隐藏' %></span><% if(set.status!=='published'){%><span>草稿</span><%}%></span></span></div><div class="app-contest-list-schedule"><strong><%= set.deadline_at?syzoj.utils.formatDate(set.deadline_at):'无限期' %></strong><span>创建者 <%= set.owner_username %></span></div><div class="app-contest-list-attendance"><span><i data-lucide="users-round"></i><%= set.participant_count %></span><span class="app-status <%= ended?'app-status-muted':'app-status-running' %>"><%= ended?'已截止':'进行中' %></span></div><div class="app-contest-list-action"><% if(Number(set.owner_id)===Number(user&&user.id)||user&&user.is_admin){%><a class="app-button app-button-secondary" href="/problem-set/<%= set.id %>/edit"><i data-lucide="settings"></i>管理</a><%}else{%><a class="app-button app-button-secondary" href="/problem-set/<%= set.id %>">查看</a><%}%></div></article><% }); %></section><div class="app-empty app-empty-compact" data-set-empty hidden><div class="app-empty-inner"><i data-lucide="list-x"></i><strong>当前条件没有题单</strong></div></div><% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="list-checks"></i><strong>暂无题单</strong><p>题单发布后会显示在这里。</p></div></div><% } %>
</div>
<script>(function(){var list=document.querySelector('[data-set-list]');if(!list)return;var rows=Array.prototype.slice.call(list.querySelectorAll('[data-set-state]'));var buttons=Array.prototype.slice.call(document.querySelectorAll('[data-set-filter]'));var mine=document.querySelector('[data-set-mine]');var participating=document.querySelector('[data-set-participating]');var active='all',mineOnly=false,participatingOnly=false,userId=<%= user?Number(user.id):0 %>;function apply(filter){active=filter;var count=0;rows.forEach(function(row){var show=(filter==='all'||row.dataset.setState===filter)&&(!mineOnly||Number(row.dataset.setOwner)===userId)&&(!participatingOnly||row.dataset.setRegistered==='1');row.hidden=!show;if(show)count++;});buttons.forEach(function(button){button.setAttribute('aria-pressed',button.dataset.setFilter===filter?'true':'false');});document.querySelector('[data-set-count]').textContent=count;document.querySelector('[data-set-empty]').hidden=count!==0;}buttons.forEach(function(button){button.addEventListener('click',function(){apply(button.dataset.setFilter);});});if(mine)mine.addEventListener('click',function(){mineOnly=!mineOnly;mine.setAttribute('aria-pressed',mineOnly?'true':'false');mine.classList.toggle('is-active',mineOnly);apply(active);});if(participating)participating.addEventListener('click',function(){participatingOnly=!participatingOnly;participating.setAttribute('aria-pressed',participatingOnly?'true':'false');participating.classList.toggle('is-active',participatingOnly);apply(active);});})();</script>
<% include app_footer %>
