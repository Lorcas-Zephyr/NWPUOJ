<% this.adminPage = 'users' %>
<% include admin_header %>

<% if (req.query && req.query.deleted) { %><div class="app-notice app-notice-success"><i data-lucide="circle-check"></i><span>用户“<%= req.query.deleted %>”已删除。</span></div><% } %>
<div class="app-admin-toolbar"><div><h3>用户目录</h3><p>共 <%= total %> 名用户<%= keyword ? '，筛选“' + keyword + '”' : '' %>。</p></div><form class="app-admin-search" method="get" action="<%= syzoj.utils.makeUrl(['admin', 'users']) %>" role="search"><span class="app-input-wrap"><i data-lucide="search"></i><input class="app-input" type="search" name="q" value="<%= keyword %>" placeholder="用户名、邮箱或 UID"></span><button class="app-button app-button-primary" type="submit">搜索</button></form></div>
<% if (users.length) { %><div class="app-table-region"><table class="app-table app-admin-users-table"><thead><tr><th>UID</th><th>用户</th><th>Email</th><th>账户状态</th><th>Rating</th><th>权限</th><th>注册时间</th><th aria-label="操作"></th></tr></thead><tbody><% users.forEach(function (item) { const expired = item.temporaryAccount && Number(item.temporaryAccount.expires_at) <= Math.floor(Date.now() / 1000); %><tr><td class="app-cell-number">#<%= item.id %></td><td><span class="app-user-cell"><img src="<%= syzoj.utils.avatar(item, 56) %>" alt=""><a href="<%= syzoj.utils.makeUrl(['user', item.id]) %>"><%= item.username %></a></span></td><td><%= item.email || '-' %><small class="app-row-description"><%= item.is_email_verified ? '已验证' : '未验证' %></small></td><td><div class="app-status-list"><% if (item.is_admin) { %><span class="app-status app-status-info">管理员</span><% } else { %><span class="app-status app-status-muted">普通用户</span><% } %><% if (item.id === deletedAccountUserId) { %><span class="app-status app-status-muted">系统账户</span><% } %><% if (!item.is_show) { %><span class="app-status app-status-pending">隐藏</span><% } %><% if (item.is_cheater) { %><span class="app-status app-status-rejected">作弊者</span><% } %><% if (item.temporaryAccount) { %><span class="app-status <%= expired ? 'app-status-rejected' : 'app-status-pending' %>"><%= expired ? '已禁止登录' : '临时账户' %></span><% } %></div></td><td class="app-cell-number"><%= item.rating == null ? '-' : item.rating %></td><td><%= item.privilegeList.length ? item.privilegeList.join('、') : '-' %></td><td class="app-cell-number"><%= syzoj.utils.formatDate(item.register_time) %></td><td class="app-cell-actions"><div class="app-inline-actions"><a class="app-icon-button" href="<%= syzoj.utils.makeUrl(['user', item.id]) %>" title="查看主页" aria-label="查看主页"><i data-lucide="user-round"></i></a><% if (item.id !== deletedAccountUserId) { %><a class="app-icon-button" href="<%= syzoj.utils.makeUrl(['user', item.id, 'edit']) %>" title="编辑资料" aria-label="编辑资料"><i data-lucide="square-pen"></i></a><% } %><% if (item.id !== user.id && item.id !== syzoj.siteOwnerUserId && item.id !== deletedAccountUserId && (!item.is_admin || (typeof isSiteOwner !== 'undefined' && isSiteOwner))) { %><form method="post" data-admin-user-delete-v2 data-user-id="<%= item.id %>" data-confirm="确定删除用户“<%= item.username %>”吗？公开内容将转移到系统删除账户，实名、头像、消息、权限和个人设置会被清理。此操作不可撤销。"><input type="hidden" name="user_management_csrf_token" value="<%= userManagementCsrfToken %>"><button class="app-icon-button app-icon-danger" type="submit" title="删除用户" aria-label="删除用户"><i data-lucide="trash"></i></button></form><% } %></div></td></tr><% }); %></tbody></table></div><% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="user-round-x"></i><strong>没有找到用户</strong><p>尝试更换关键词。</p></div></div><% } %>
<% if (totalPages > 1) { %><nav class="app-pagination" aria-label="用户分页"><span>第 <%= currentPage %> / <%= totalPages %> 页</span><span class="app-pagination-pages"><% if (currentPage > 1) { %><a href="<%= usersPageUrl(currentPage - 1) %>" aria-label="上一页"><i data-lucide="chevron-left"></i></a><% } else { %><span aria-disabled="true"><i data-lucide="chevron-left"></i></span><% } %><span class="is-current"><%= currentPage %></span><% if (currentPage < totalPages) { %><a href="<%= usersPageUrl(currentPage + 1) %>" aria-label="下一页"><i data-lucide="chevron-right"></i></a><% } else { %><span aria-disabled="true"><i data-lucide="chevron-right"></i></span><% } %></span></nav><% } %>

<script>
(function () {
  document.addEventListener('submit', async function (event) {
    var form = event.target.closest && event.target.closest('[data-admin-user-delete-v2]');
    if (!form) return;
    event.preventDefault();
    event.stopImmediatePropagation();
    if (!window.confirm(form.dataset.confirm || '确定删除此用户吗？')) return;
    var button = form.querySelector('button[type="submit"]');
    if (button) button.disabled = true;
    try {
      var response = await fetch('/api/v2/admin/users/' + encodeURIComponent(form.dataset.userId), {
        method: 'DELETE',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'Idempotency-Key': window.crypto && window.crypto.randomUUID ? window.crypto.randomUUID() : String(Date.now()) },
        body: '{}'
      });
      var body = await response.json();
      if (!response.ok) {
        throw new Error(body && body.error && body.error.message || '用户删除失败');
      }
      window.location.assign('<%= syzoj.utils.makeUrl(['admin', 'users']) %>?deleted=' + encodeURIComponent(body.data.username));
    } catch (error) {
      if (button) button.disabled = false;
      if (window.NWPUOJApp) window.NWPUOJApp.showToast(error.message || '用户删除失败', 'error');
    }
  }, true);
})();
</script>

<% include admin_footer %>
