<%
this.title = '题目 - ' + contest.title;
const appRegistration = typeof contestRegistration !== 'undefined' && contestRegistration ? contestRegistration : null;
const appContestUnveiled = appRegistration ? appRegistration.canViewProblems : (isSupervisior || contest.ended);
function appProblemStatus(problem) {
  if (typeof problem.status === 'string') return { text: problem.feedback || problem.status, className: problem.status === 'Accepted' ? 'app-status-accepted' : 'app-status-error' };
  if (problem.status && problem.status.accepted) return { text: problem.status.unacceptedCount ? '+' + problem.status.unacceptedCount : '通过', className: 'app-status-accepted' };
  if (problem.status && problem.status.unacceptedCount) return { text: '-' + problem.status.unacceptedCount, className: 'app-status-error' };
  return null;
}
const appProblemProgress = problems.reduce(function (progress, problem) {
  const state = appProblemStatus(problem);
  if (state) progress.attempted += 1;
  if (state && state.className === 'app-status-accepted') progress.solved += 1;
  return progress;
}, { solved: 0, attempted: 0 });
const appContestCompletion = problems.length ? Math.round(appProblemProgress.solved / problems.length * 100) : 0;
let appNextProblemIndex = 0;
for (let index = 0; index < problems.length; index += 1) {
  const state = appProblemStatus(problems[index]);
  if (!state || state.className !== 'app-status-accepted') { appNextProblemIndex = index + 1; break; }
}
if (!appNextProblemIndex && problems.length) appNextProblemIndex = 1;
%>
<% include app_header %>
<% if (typeof contestHeader !== 'undefined' && contestHeader) { %><% include contest_context %><% } %>

<div class="app-page app-contest-page">
  <% if (appContestUnveiled) { %>
    <% if (problems.length) { %>
      <div class="app-contest-workspace">
        <div class="app-contest-problem-list" role="list" aria-label="比赛题目">
          <% let appIndex = 0; for (const problem of problems) { appIndex += 1; const appState = appProblemStatus(problem); const appProblemClass = appState && appState.className === 'app-status-accepted' ? 'is-solved' : (appState ? 'is-attempted' : 'is-unattempted'); %>
            <article class="app-contest-problem-row <%= appProblemClass %>" role="listitem" data-reveal>
              <a class="app-contest-problem-letter" href="<%= syzoj.utils.makeUrl(['contest', contest.id, 'problem', appIndex]) %>" aria-label="打开题目 <%= this.alpha(appIndex) %>"><%= this.alpha(appIndex) %></a>
              <div class="app-contest-problem-copy">
                <a href="<%= syzoj.utils.makeUrl(['contest', contest.id, 'problem', appIndex]) %>"><%= syzoj.utils.removeTitleTag(problem.problem.title) %></a>
                <span><% if (appState) { %><% if (problem.judge_id) { %><a class="app-status <%= appState.className %>" href="<%= syzoj.utils.makeUrl(['contest', 'submission', problem.judge_id]) %>"><%= appState.text %></a><% } else { %><span class="app-status <%= appState.className %>"><%= appState.text %></span><% } %><% } else { %><span class="app-status">未作答</span><% } %></span>
              </div>
              <% if (hasStatistics) { %><div class="app-contest-problem-stats"><span>通过</span><strong><%= problem.statistics.accepted %></strong><span>尝试</span><strong><%= problem.statistics.attempt %></strong></div><% } %>
              <a class="app-icon-button app-contest-problem-open" href="<%= syzoj.utils.makeUrl(['contest', contest.id, 'problem', appIndex]) %>" aria-label="打开题目 <%= this.alpha(appIndex) %>" title="打开题目"><i data-lucide="arrow-right"></i></a>
            </article>
          <% } %>
        </div>
        <aside class="app-contest-progress-panel" aria-label="比赛做题进度">
          <span class="app-kicker"><%= user ? 'YOUR PROGRESS' : 'CONTEST OVERVIEW' %></span>
          <div class="app-contest-progress-value"><strong><%= appProblemProgress.solved %></strong><span>/ <%= problems.length %></span></div>
          <div class="app-progress" role="progressbar" aria-label="已通过题目比例" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= appContestCompletion %>"><span style="width:<%= appContestCompletion %>%"></span></div>
          <dl><div><dt>已通过</dt><dd><%= appProblemProgress.solved %></dd></div><div><dt>已尝试</dt><dd><%= appProblemProgress.attempted %></dd></div><div><dt>未作答</dt><dd><%= Math.max(0, problems.length - appProblemProgress.attempted) %></dd></div></dl>
          <% if (appNextProblemIndex) { %><a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['contest', contest.id, 'problem', appNextProblemIndex]) %>"><i data-lucide="play"></i><%= appProblemProgress.attempted ? '继续比赛' : '开始答题' %></a><% } %>
        </aside>
      </div>
    <% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="list-x"></i><strong>暂无题目</strong><p>比赛题目尚未发布。</p></div></div><% } %>
  <% } else { %>
    <div class="app-empty app-empty-compact"><div class="app-empty-inner"><i data-lucide="lock-keyhole"></i><strong>题目暂未开放</strong><p><%= contest.running ? '完成报名后可以查看比赛题目。' : '比赛开始后将开放题目。' %></p></div></div>
  <% } %>
</div>

<% include app_footer %>
