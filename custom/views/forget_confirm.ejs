<% this.title = '重设密码'; %>
<% include app_header %>

<div class="app-auth">
  <section class="app-auth-intro">
    <img src="/self/logo.png?v=<%= encodeURIComponent(syzoj.config.nwpuoj_version || '2.0.0') %>" alt="" width="52" height="52">
    <h1>设置新密码</h1>
    <p>使用与旧密码不同的强密码保护你的账户。</p>
  </section>
  <section class="app-auth-panel">
    <h2>重设密码</h2>
    <p>新密码至少需要 10 个字符。</p>
    <div class="app-notice" id="reset-message" role="status" hidden><i data-lucide="info"></i><span id="reset-message-content"></span></div>
    <form class="app-form" id="reset-form">
      <label class="app-field app-field-full"><span class="app-label">新密码</span><span class="app-input-wrap app-password-wrap"><i data-lucide="lock-keyhole"></i><input class="app-input" type="password" id="password1" minlength="10" maxlength="128" autocomplete="new-password" required><button class="app-password-toggle" type="button" data-password-toggle="password1" aria-label="显示密码"><i data-lucide="eye"></i></button></span></label>
      <label class="app-field app-field-full"><span class="app-label">确认密码</span><span class="app-input-wrap app-password-wrap"><i data-lucide="lock-keyhole"></i><input class="app-input" type="password" id="password2" minlength="10" maxlength="128" autocomplete="new-password" required><button class="app-password-toggle" type="button" data-password-toggle="password2" aria-label="显示密码"><i data-lucide="eye"></i></button></span></label>
      <button type="submit" class="app-button app-button-primary app-auth-submit" id="reset-button">更新密码</button>
    </form>
  </section>
</div>

<script>
(function () {
  var form = document.getElementById('reset-form');
  var button = document.getElementById('reset-button');
  var message = document.getElementById('reset-message');
  var content = document.getElementById('reset-message-content');
  var token = <%- serializejs(token) %>;
  function show(type, text) { message.className = 'app-notice ' + (type === 'success' ? 'app-notice-success' : 'app-notice-danger'); content.textContent = text; message.hidden = false; }
  form.addEventListener('submit', function (event) {
    event.preventDefault();
    var password = document.getElementById('password1').value;
    if (password !== document.getElementById('password2').value) return show('error', '两次输入的密码不一致。');
    button.disabled = true; button.textContent = '正在更新…';
    var params = new URLSearchParams({ token: token, password: password });
    fetch('/api/v2/auth/password/reset', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() })
      .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
      .then(function (result) { if (result.ok && result.data && result.data.data && result.data.data.reset) { form.hidden = true; show('success', '密码重置成功，请重新登录。'); } else show('error', result.data && result.data.error ? result.data.error.message : '密码重置链接无效或已过期。'); button.disabled = false; button.textContent = '更新密码'; })
      .catch(function () { show('error', '密码重置服务暂时不可用。'); button.disabled = false; button.textContent = '更新密码'; });
  });
})();
</script>

<% include app_footer %>
