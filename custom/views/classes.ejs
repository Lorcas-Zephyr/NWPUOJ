<% this.title = '班级管理' %>
<% include app_header %>
<div class="app-page app-classes-page">
  <header class="app-page-header"><div class="app-page-heading"><span class="app-kicker">CLASSES</span><h1 class="app-page-title">班级管理</h1><p class="app-page-description">按学号维护班级成员，并用于比赛与题单报名。</p></div><div class="app-page-actions"><button class="app-button app-button-primary" type="button" data-dialog-open="class-create-dialog"><i data-lucide="plus"></i>创建班级</button></div></header>
  <% if (classes.length) { %><div class="app-table-region"><table class="app-table"><thead><tr><th>班级</th><th>标签</th><th>创建者</th><th>成员</th><th>活动导入</th><th aria-label="操作"></th></tr></thead><tbody><% classes.forEach(function (group) { %><tr><td class="app-cell-primary"><a href="/class/<%= group.id %>"><strong><%= group.name %></strong></a></td><td><span class="user-name-tag tag-tier-blue"><%= group.tag_text %></span></td><td><%= group.owner_username %></td><td><%= group.member_count %></td><td><span class="app-status <%= group.allow_activity_import ? 'app-status-accepted' : 'app-status-muted' %>"><%= group.allow_activity_import ? '允许' : '关闭' %></span></td><td class="app-cell-actions"><a class="app-icon-button" href="/class/<%= group.id %>" title="管理班级" aria-label="管理班级"><i data-lucide="settings"></i></a></td></tr><% }); %></tbody></table></div><% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="users-round"></i><strong>还没有班级</strong><p>创建班级后可按学号添加成员。</p></div></div><% } %>
</div>
<dialog class="app-dialog" id="class-create-dialog"><form class="app-form" data-class-create><div class="app-dialog-header"><h2>创建班级</h2><button class="app-icon-button" type="button" data-dialog-close aria-label="关闭"><i data-lucide="x"></i></button></div><div class="app-dialog-body"><label class="app-field"><span class="app-label">班级名称</span><input class="app-input" name="name" maxlength="80" required></label><label class="app-field"><span class="app-label">用户名标签</span><input class="app-input" name="tag_text" maxlength="12" required></label><label class="app-setting-row"><span><strong>允许用于活动报名</strong><small>比赛或题单管理员可以按本班导入参赛者。</small></span><input class="app-switch" type="checkbox" name="allow_activity_import" checked></label></div><div class="app-dialog-actions"><button class="app-button app-button-secondary" type="button" data-dialog-close>取消</button><button class="app-button app-button-primary" type="submit"><i data-lucide="plus"></i>创建</button></div></form></dialog>
<script>(function(){var form=document.querySelector('[data-class-create]');if(!form)return;form.addEventListener('submit',async function(event){event.preventDefault();var data=new FormData(form);var response=await fetch('/api/v2/classes',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:data.get('name'),tag_text:data.get('tag_text'),allow_activity_import:data.get('allow_activity_import')==='on'})});var body=await response.json().catch(function(){return null;});if(!response.ok){if(window.NWPUOJApp)window.NWPUOJApp.showToast(body&&body.error&&body.error.message||'创建失败。','danger');return;}window.location.assign('/class/'+body.data.id);});})();</script>
<% include app_footer %>
