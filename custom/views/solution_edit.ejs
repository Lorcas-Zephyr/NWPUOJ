<% this.title = solution.id ? '编辑题解' : '投稿题解' %>
<% include header %>

<div class="padding">
  <div class="ui breadcrumb nwpuoj-meta" style="margin-bottom:15px;">
    <a class="section" href="<%= syzoj.utils.makeUrl(['problem', problem.id]) %>"><%= problem.getDisplayId() %>. <%= problem.title %></a>
    <i class="right angle icon divider"></i>
    <a class="section" href="<%= syzoj.utils.makeUrl(['problem', problem.id, 'solutions']) %>">题解</a>
    <i class="right angle icon divider"></i>
    <div class="active section"><%= solution.id ? '编辑' : '投稿' %></div>
  </div>

  <div class="nwpuoj-page-header">
    <h2 class="nwpuoj-page-title"><%= solution.id ? '编辑题解' : '投稿题解' %></h2>
    <span class="nwpuoj-meta"><%= problem.getDisplayId() %> · <%= problem.title %></span>
  </div>

  <% if (!solution.id && !user.is_admin) { %>
    <div class="ui info message">
      <i class="info circle icon"></i> 投稿后将进入审核状态，管理员通过后才会公开。审核期间仅你自己和管理员可见。
    </div>
  <% } %>

  <form class="ui form" action="<%= syzoj.utils.makeUrl(['solution', solution.id, 'edit']) %>" method="post"
        data-markdown-editor data-draft-key="content-draft:solution:<%= user.id %>:<%= solution.id %>:<%= problem.id %>">
    <input type="hidden" name="_content_token" value="<%= contentFormTokens.solutionEdit %>">
    <input type="hidden" name="problem_id" value="<%= problem.id %>">

    <div class="ui top attached tabular menu nwpuoj-editor-mode" role="tablist">
      <a class="active item" role="tab" aria-selected="true" data-tab="edit"><i class="edit icon"></i>编辑</a>
      <a class="item" role="tab" aria-selected="false" data-tab="preview" data-preview-tab><i class="eye icon"></i>预览</a>
    </div>
    <div class="ui bottom attached active tab segment" data-tab="edit">
      <div class="field">
        <label>标题</label>
        <input type="text" name="title" value="<%= solution.title || '' %>" maxlength="80" placeholder="例如：思路分析 + 完整代码" required>
      </div>
      <div class="field">
        <label>内容（支持 Markdown）</label>
        <textarea name="content" class="markdown-edit" rows="20" required><%= solution.content || '' %></textarea>
      </div>
      <div class="field">
        <div class="ui toggle checkbox">
          <input type="checkbox" name="allow_comment" <% if (solution.id === 0 || solution.allow_comment) { %>checked<% } %>>
          <label>允许其他用户对本题解发表评论</label>
        </div>
      </div>
    </div>
    <div class="ui bottom attached tab segment" data-tab="preview">
      <h3 class="ui header" data-preview-title></h3>
      <div class="font-content" data-preview-content></div>
    </div>
    <div class="nwpuoj-editor-actions">
      <button type="button" class="ui basic labeled icon button" data-save-draft>
        <i class="save icon"></i>保存草稿
      </button>
      <button type="submit" class="ui primary labeled icon button">
        <i class="checkmark icon"></i> 提交
      </button>
      <a class="ui button" href="<%= syzoj.utils.makeUrl(['problem', problem.id, 'solutions']) %>">取消</a>
      <span class="nwpuoj-draft-status" data-draft-status aria-live="polite"></span>
    </div>
  </form>
</div>

<% include markdown_editor_script %>
<% include footer %>
