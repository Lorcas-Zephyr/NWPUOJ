<% this.adminPage = 'announcements'; %>
<% include admin_header %>

<div class="app-admin-toolbar"><div><h3>公告列表</h3><p>管理首页弹窗公告的时间、级别和启用状态。</p></div><a class="app-button app-button-primary" href="<%= syzoj.utils.makeUrl(['admin', 'announcement', 0, 'edit']) %>"><i data-lucide="plus"></i>新建公告</a></div>
<% if (announcements.length) { %>
<div class="app-table-region"><table class="app-table app-admin-announcements-table"><thead><tr><th>标题</th><th>级别</th><th>生效时段</th><th>状态</th><th aria-label="操作"></th></tr></thead><tbody>
<% for (const announcement of announcements) { const appLevel = announcement.level === 'important' ? ['重要', 'app-status-rejected'] : announcement.level === 'warning' ? ['警告', 'app-status-pending'] : ['信息', 'app-status-info']; const appState = !announcement.is_active ? ['已停用', 'app-status-muted'] : announcement.isLive ? ['生效中', 'app-status-accepted'] : now < announcement.start_time ? ['未开始', 'app-status-info'] : ['已过期', 'app-status-muted']; %>
<tr><td class="app-cell-primary"><strong><%= announcement.title %></strong></td><td><span class="app-status <%= appLevel[1] %>"><%= appLevel[0] %></span></td><td><%= syzoj.utils.formatDate(announcement.start_time) %><small class="app-row-description">至 <%= syzoj.utils.formatDate(announcement.end_time) %></small></td><td><span class="app-status <%= appState[1] %>"><%= appState[0] %></span></td><td class="app-cell-actions"><div class="app-inline-actions"><a class="app-icon-button" href="<%= syzoj.utils.makeUrl(['admin', 'announcement', announcement.id, 'edit']) %>" title="编辑公告" aria-label="编辑公告"><i data-lucide="square-pen"></i></a><form method="post" data-announcement-v2="toggle" data-announcement-id="<%= announcement.id %>" data-announcement-active="<%= announcement.is_active ? 'true' : 'false' %>"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><button class="app-icon-button" type="submit" title="<%= announcement.is_active ? '停用公告' : '启用公告' %>" aria-label="<%= announcement.is_active ? '停用公告' : '启用公告' %>"><i data-lucide="<%= announcement.is_active ? 'pause' : 'play' %>"></i></button></form><form method="post" data-announcement-v2="delete" data-announcement-id="<%= announcement.id %>" data-confirm="确定删除公告“<%= announcement.title %>”吗？此操作不可恢复。"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><button class="app-icon-button app-icon-danger" type="submit" title="删除公告" aria-label="删除公告"><i data-lucide="trash"></i></button></form></div></td></tr>
<% } %>
</tbody></table></div>
<% include app_pagination %>
<% } else { %><div class="app-empty"><div class="app-empty-inner"><i data-lucide="megaphone-off"></i><strong>暂无公告</strong><p>创建公告后会显示在这里。</p></div></div><% } %>
<script>
(function () {
  function requestKey() { return window.crypto && window.crypto.randomUUID ? window.crypto.randomUUID() : String(Date.now()) + Math.random(); }
  function message(body, fallback) { return body && body.error && body.error.message || fallback; }
async function detail(id) {
    var response = await fetch('/api/v2/admin/announcements/' + encodeURIComponent(id), { credentials: 'same-origin', cache: 'no-store' });
    var body = await response.json();
    if (!response.ok) throw Object.assign(new Error(message(body, '公告读取失败。')), { code: body && body.error && body.error.code });
    return { etag: response.headers.get('ETag'), data: body.data };
  }
  document.querySelectorAll('form[data-announcement-v2]').forEach(function (form) {
    form.addEventListener('submit', async function (event) {
      if (event.defaultPrevented) return;
      event.preventDefault();
      var button = form.querySelector('button[type="submit"]');
      if (button) button.disabled = true;
      try {
        var id = form.dataset.announcementId;
        var current = await detail(id);
        var action = form.dataset.announcementV2;
        var options = {
          method: action === 'delete' ? 'DELETE' : 'PATCH',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'Idempotency-Key': requestKey(), 'If-Match': current.etag || '' }
        };
        if (action === 'toggle') options.body = JSON.stringify({ active: form.dataset.announcementActive !== 'true' });
        var response = await fetch('/api/v2/admin/announcements/' + encodeURIComponent(id), options);
        var body = await response.json();
        if (!response.ok) throw new Error(message(body, '公告操作失败。'));
        window.location.reload();
      } catch (error) {
        if (window.NWPUOJApp) window.NWPUOJApp.showToast(error.message || '公告操作失败。', 'danger');
        if (button) button.disabled = false;
      }
    });
  });
})();
</script>
<% include admin_footer %>
