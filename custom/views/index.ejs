<% this.title = '首页'; %>
<% include header %>

<div class="padding" style="padding: 16px 20px;">

  <!-- ============ 顶部状态提示 ============ -->
  <% if (typeof pendingSolutionsCount !== 'undefined' && pendingSolutionsCount > 0) { %>
    <div class="ui yellow message" style="margin-bottom: 15px;">
      <i class="bell icon"></i>
      你有 <b><%= pendingSolutionsCount %></b> 篇题解待审核。
      <a href="<%= syzoj.utils.makeUrl(['admin', 'solutions']) %>" style="margin-left: 8px;">前往审核 →</a>
    </div>
  <% } %>

  <!-- ============ 公告弹窗(保留原逻辑) ============ -->
  <div id="announcement-modal-container"></div>
  <script>
  (function () {
    'use strict';
    var STORAGE_KEY = 'nwpuoj_dismissed_announcements';
    function getDismissed() {
      try { var raw = localStorage.getItem(STORAGE_KEY); return raw ? JSON.parse(raw) : {}; }
      catch (e) { return {}; }
    }
    function setDismissed(dict) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(dict)); } catch (e) {}
    }
    function cleanExpiredDismissed(announcements) {
      var dict = getDismissed(), liveIds = {};
      announcements.forEach(function (a) { liveIds[a.id] = true; });
      var changed = false;
      Object.keys(dict).forEach(function (id) {
        if (!liveIds[id]) { delete dict[id]; changed = true; }
      });
      if (changed) setDismissed(dict);
    }
    function levelToColor(level) {
      if (level === 'important') return 'red';
      if (level === 'warning') return 'yellow';
      return 'blue';
    }
    function levelToIcon(level) {
      if (level === 'important') return 'exclamation circle';
      if (level === 'warning') return 'warning sign';
      return 'info circle';
    }
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (m) {
        return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];
      });
    }
    function formatAnnouncementTime(timestamp) {
      if (!timestamp) return '-';
      var date = new Date(timestamp * 1000);
      var pad = function (value) { return value < 10 ? '0' + value : String(value); };
      return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate()) +
        ' ' + pad(date.getHours()) + ':' + pad(date.getMinutes());
    }
    function renderAnnouncementList(announcements) {
      var $list = $('#active-announcement-list');
      if (!$list.length) return;
      $list.empty();

      if (announcements.length === 0) {
        $list.append('<tr><td colspan="2" class="center aligned" style="color: #999;">暂无生效中的公告</td></tr>');
        return;
      }

      announcements.forEach(function (a) {
        var color = levelToColor(a.level);
        var levelText = a.level === 'important' ? '重要' : (a.level === 'warning' ? '警告' : '公告');
        var $chevron = $('<i class="angle right icon" style="margin-right: 4px;"></i>');
        var $details = $('<tr class="announcement-detail-row" style="display: none;"></tr>')
          .append($('<td colspan="2" style="padding: 14px 18px; background: #fafafa;"></td>')
            .append($('<div class="font-content"></div>').html(a.contentRendered)));
        var $title = $('<a href="#" aria-expanded="false"></a>')
          .append($chevron)
          .append($('<span></span>').text(a.title))
          .on('click', function (event) {
            event.preventDefault();
            var expanded = !$details.is(':visible');
            $details.toggle(expanded);
            $title.attr('aria-expanded', expanded ? 'true' : 'false');
            $chevron.toggleClass('right', !expanded).toggleClass('down', expanded);
          });
        var $titleCell = $('<td></td>')
          .append($('<span class="ui mini label"></span>').addClass(color).text(levelText))
          .append(' ')
          .append($title);
        var $timeCell = $('<td></td>').text(formatAnnouncementTime(a.public_time));
        $list.append($('<tr></tr>').append($titleCell, $timeCell));
        $list.append($details);
      });
    }
    function showAnnouncement(a, onClose) {
      var color = levelToColor(a.level);
      var icon = levelToIcon(a.level);
      var html = '<div class="ui ' + color + ' modal announcement-modal" style="margin-top: 0 !important;">' +
        '  <div class="header" style="display: flex; align-items: center; gap: 10px;">' +
        '    <i class="' + icon + ' icon"></i>' +
        '    <span>' + escapeHtml(a.title) + '</span>' +
        '  </div>' +
        '  <div class="content scrolling">' +
        '    <div class="font-content">' + a.contentRendered + '</div>' +
        '  </div>' +
        '  <div class="actions" style="display: flex; justify-content: space-between; align-items: center;">' +
        '    <div class="ui checkbox" style="margin-right: auto;">' +
        '      <input type="checkbox" id="dontshow-' + a.id + '">' +
        '      <label for="dontshow-' + a.id + '" style="cursor: pointer;">不再弹出</label>' +
        '    </div>' +
        '    <div class="ui ' + color + ' ok button">我已知晓</div>' +
        '  </div>' +
        '</div>';
      var $m = $(html);
      $('#announcement-modal-container').append($m);
      $m.modal({
        closable: true,
        onHidden: function () {
          var dontShow = $m.find('input#dontshow-' + a.id).is(':checked');
          if (dontShow) {
            var dict = getDismissed();
            dict[a.id] = parseInt(new Date().getTime() / 1000);
            setDismissed(dict);
          }
          $m.remove();
          if (typeof onClose === 'function') onClose();
        }
      }).modal('show');
    }
    function showQueue(list) {
      if (list.length === 0) return;
      var head = list.shift();
      showAnnouncement(head, function () { showQueue(list); });
    }
    $(function () {
      $.getJSON('/api/active-announcements', function (data) {
        var all = data && data.announcements ? data.announcements : [];
        renderAnnouncementList(all);
        cleanExpiredDismissed(all);
        var dict = getDismissed();
        var toShow = all.filter(function (a) {
          return (a.level === 'important' || a.level === 'warning') && !dict[a.id];
        });
        if (toShow.length === 0) return;
        showQueue(toShow);
      }).fail(function () {
        $('#active-announcement-list').html('<tr><td colspan="2" class="center aligned" style="color: #db2828;">公告加载失败</td></tr>');
      });
    });
  })();
  </script>

  <!-- ============ 公告 + 右侧栏 ============ -->
  <div class="ui grid" style="margin-top: 0;">
    <div class="eleven wide column">
      <h4 class="ui top attached block header"><i class="ui info icon"></i>公告</h4>
      <div class="ui bottom attached segment">
        <table class="ui very basic table">
          <thead>
            <tr>
              <th>标题</th>
              <th style="width: 180px;">时间</th>
            </tr>
          </thead>
          <tbody id="active-announcement-list">
            <tr>
              <td colspan="2" class="center aligned" style="color: #999;">公告加载中...</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h4 class="ui top attached block header" style="margin-top: 14px;"><i class="ui calendar icon"></i>近期比赛</h4>
      <div class="ui bottom attached segment" style="padding: 10px 12px;">
        <% if (!contests || !contests.length) { %>
          <div style="text-align: center; color: #999; padding: 8px 0;">暂无比赛</div>
        <% } else { %>
          <% for (let contest of contests) {
            let now = syzoj.utils.getCurrentDate();
            let statusLabel, statusColor;
            if (now < contest.start_time) { statusLabel = '未开始'; statusColor = 'red'; }
            else if (now < contest.end_time) { statusLabel = '进行中'; statusColor = 'green'; }
            else { statusLabel = '已结束'; statusColor = 'grey'; }
            let typeLabel = '', typeColor = '';
            if (contest.type === 'noi') { typeLabel = 'NOI'; typeColor = 'orange'; }
            else if (contest.type === 'ioi') { typeLabel = 'IOI'; typeColor = 'teal'; }
            else if (contest.type === 'acm') { typeLabel = 'ICPC'; typeColor = 'blue'; }
          %>
            <a class="nwpuoj-contest-mini" href="<%= syzoj.utils.makeUrl(['contest', contest.id]) %>">
              <div class="nwpuoj-contest-mini-title"><%= contest.title %></div>
              <div class="nwpuoj-contest-mini-meta">
                <% if (typeLabel) { %><span class="ui mini <%= typeColor %> label"><%= typeLabel %></span><% } %>
                <span class="ui mini <%= statusColor %> label"><%= statusLabel %></span>
                <span class="nwpuoj-contest-mini-time"><%= syzoj.utils.formatDate(contest.start_time) %></span>
              </div>
            </a>
          <% } %>
        <% } %>
      </div>
    </div>

    <div class="five wide column">
      <h4 class="ui top attached block header"><i class="ui search icon"></i>搜索题目</h4>
      <div class="ui bottom attached segment">
        <form action="<%= syzoj.utils.makeUrl(['problems', 'search']) %>" method="get" id="home-problem-search-form">
          <input type="hidden" name="repository" value="all">
          <div class="ui search" style="width: 100%;">
            <div class="ui left icon input" style="width: 100%;">
              <input class="prompt" style="width: 100%;" type="text" placeholder="ID / 题目名 …" name="keyword">
              <i class="search icon"></i>
            </div>
            <div class="results" style="width: 100%;"></div>
          </div>
        </form>
      </div>

      <% if (typeof links !== 'undefined' && links && links.length) { %>
        <h4 class="ui top attached block header font-content" style="margin-top: 14px;"><i class="ui linkify icon"></i>友情链接</h4>
        <div class="ui bottom attached segment">
          <ul style="margin: 0; padding-left: 20px;">
            <% for (let link of links) { %>
              <li><a href="<%= link.url %>"><%= link.title %></a></li>
            <% } %>
          </ul>
        </div>
      <% } %>
    </div>
  </div>

</div>

<!-- ============ 搜索框初始化 ============ -->
<script>
$(function () {
  $('.ui.search').search({
    debug: true,
    saveRemoteData: false,
    apiSettings: { url: '/api/v2/search/problems/{query}', cache: false },
    fields: { title: 'name' }
  });
  document.querySelector('#home-problem-search-form .prompt').addEventListener('keydown', function (event) {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    event.stopImmediatePropagation();
    document.getElementById('home-problem-search-form').submit();
  }, true);
});
</script>

<% include footer %>
