<% this.title = '首页'; %>
<% include app_header %>
<%
const homeNow = syzoj.utils.getCurrentDate();
function contestState(contest) {
  if (homeNow < contest.start_time) return { label: '未开始', className: 'app-status-waiting' };
  if (homeNow < contest.end_time) return { label: '进行中', className: 'app-status-running' };
  return { label: '已结束', className: '' };
}
function contestType(contest) {
  return { noi: 'NOI', ioi: 'IOI', acm: 'ACM' }[contest.type] || String(contest.type || '').toUpperCase();
}
%>

<div class="app-page app-home">
  <header class="app-page-header">
    <div class="app-page-heading">
      <span class="app-kicker"><% if (user) { %>欢迎回来，<%- syzoj.utils.renderUsername(user, { noLink: true, noTag: true }) %><% } else { %>NWPU ONLINE JUDGE<% } %></span>
      <h1 class="app-page-title"><%= syzoj.config.title %></h1>
      <p class="app-page-description">查看近期比赛、站点公告并快速进入题库。</p>
    </div>
    <div class="app-page-actions">
      <a class="app-button app-button-primary" href="/problems"><i data-lucide="play"></i>开始做题</a>
      <a class="app-button app-button-secondary" href="/contests"><i data-lucide="trophy"></i>查看比赛</a>
    </div>
  </header>

  <% if (typeof pendingSolutionsCount !== 'undefined' && pendingSolutionsCount > 0) { %>
    <div class="app-notice app-notice-warning" role="status">
      <i data-lucide="clock-alert"></i>
      <span>有 <strong><%= pendingSolutionsCount %></strong> 篇题解等待审核。<a href="<%= syzoj.utils.makeUrl(['admin', 'solutions']) %>">前往审核</a></span>
    </div>
  <% } %>

  <section class="app-banner" data-home-banner aria-label="站点轮播" aria-roledescription="轮播" hidden>
    <div class="app-banner-track" data-banner-track></div>
    <div class="app-banner-controls" data-banner-controls hidden>
      <button type="button" data-banner-previous aria-label="上一张" title="上一张"><i data-lucide="arrow-left"></i></button>
      <button type="button" data-banner-next aria-label="下一张" title="下一张"><i data-lucide="arrow-right"></i></button>
    </div>
  </section>

  <div class="app-dashboard-grid">
    <div class="app-dashboard-primary">
      <section class="app-section" data-reveal>
        <div class="app-section-header">
          <div>
            <h2 class="app-section-title">公告</h2>
            <p class="app-section-description">站点变更、比赛通知和重要提醒。</p>
          </div>
          <a class="app-button app-button-quiet" href="<%= syzoj.utils.makeUrl(['announcements']) %>">公告归档<i data-lucide="arrow-right"></i></a>
        </div>
        <div class="app-list app-announcement-list" data-announcement-list aria-live="polite">
          <div class="app-list-row"><span class="app-list-content"><span class="app-list-title">正在读取公告</span><span class="app-list-meta"><span>请稍候</span></span></span></div>
        </div>
      </section>

      <section class="app-section" data-reveal>
        <div class="app-section-header">
          <div>
            <h2 class="app-section-title">近期比赛</h2>
            <p class="app-section-description">正在进行和即将开始的赛程。</p>
          </div>
          <a class="app-button app-button-quiet" href="/contests">全部比赛<i data-lucide="arrow-right"></i></a>
        </div>
        <% if (contests && contests.length) { %>
          <div class="app-list">
            <% for (const contest of contests) { const state = contestState(contest); %>
              <a class="app-list-row" href="<%= syzoj.utils.makeUrl(['contest', contest.id]) %>">
                <span class="app-list-content">
                  <span class="app-list-title"><%= contest.title %></span>
                  <span class="app-list-meta">
                    <% if (contestType(contest)) { %><span><%= contestType(contest) %></span><% } %>
                    <span><%= syzoj.utils.formatDate(contest.start_time) %></span>
                  </span>
                </span>
                <span class="app-status <%= state.className %>"><%= state.label %></span>
              </a>
            <% } %>
          </div>
        <% } else { %>
          <div class="app-empty">
            <div class="app-empty-inner"><i data-lucide="calendar-x"></i><strong>暂无近期比赛</strong><p>新的赛程发布后会显示在这里。</p></div>
          </div>
        <% } %>
      </section>
    </div>

    <aside class="app-dashboard-aside">
      <section class="app-section" data-reveal>
        <div class="app-section-header">
          <div>
            <h2 class="app-section-title">查找题目</h2>
            <p class="app-section-description">输入题号或标题关键词。</p>
          </div>
        </div>
        <form class="app-form" action="<%= syzoj.utils.makeUrl(['problems', 'search']) %>" method="get">
          <input type="hidden" name="repository" value="all">
          <label class="app-field app-field-full">
            <span class="app-label">题目</span>
            <span class="app-input-wrap">
              <i data-lucide="search"></i>
              <input class="app-input" type="search" name="keyword" list="home-problem-suggestions" placeholder="例如：1001 或 最短路" autocomplete="off" data-home-problem-search>
              <datalist id="home-problem-suggestions"></datalist>
            </span>
          </label>
          <button class="app-button app-button-primary" type="submit"><i data-lucide="search"></i>搜索</button>
        </form>
      </section>

      <% if (typeof links !== 'undefined' && links && links.length) { %>
        <section class="app-section" data-reveal>
          <div class="app-section-header"><div><h2 class="app-section-title">常用链接</h2></div></div>
          <div class="app-list">
            <% for (const link of links) { %>
              <a class="app-list-row" href="<%= link.url %>"><span class="app-list-title"><%= link.title %></span><i data-lucide="arrow-up-right"></i></a>
            <% } %>
          </div>
        </section>
      <% } %>
    </aside>
  </div>
</div>

<div data-announcement-dialogs></div>

<script>
(function () {
  'use strict';
  var dismissedKey = 'nwpuoj_dismissed_announcements';
  var list = document.querySelector('[data-announcement-list]');
  var dialogHost = document.querySelector('[data-announcement-dialogs]');

  function dismissedItems() {
    try { return JSON.parse(localStorage.getItem(dismissedKey) || '{}'); }
    catch (error) { return {}; }
  }

  function saveDismissed(items) {
    try { localStorage.setItem(dismissedKey, JSON.stringify(items)); } catch (error) {}
  }

  function formatTime(timestamp) {
    if (!timestamp) return '时间未设置';
    var value = typeof timestamp === 'number' ? timestamp * 1000 : timestamp;
    return new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
  }

  function announcementState(level) {
    if (level === 'important') return { label: '重要', className: 'app-status-danger' };
    if (level === 'warning') return { label: '提醒', className: 'app-status-warning' };
    return { label: '公告', className: 'app-status-info' };
  }

  function renderAnnouncements(items) {
    list.replaceChildren();
    if (!items.length) {
      var empty = document.createElement('div');
      empty.className = 'app-empty';
      empty.innerHTML = '<div class="app-empty-inner"><i data-lucide="inbox"></i><strong>暂无公告</strong><p>当前没有正在生效的公告。</p></div>';
      list.appendChild(empty);
      window.NWPUOJApp.refreshIcons(empty);
      return;
    }
    items.forEach(function (item) {
      var state = announcementState(item.level);
      var details = document.createElement('details');
      details.className = 'app-announcement';
      var summary = document.createElement('summary');
      summary.className = 'app-list-row';
      var content = document.createElement('span');
      content.className = 'app-list-content';
      var title = document.createElement('span');
      title.className = 'app-list-title';
      title.textContent = item.title;
      var meta = document.createElement('span');
      meta.className = 'app-list-meta';
      var time = document.createElement('span');
      time.textContent = formatTime(item.published_at);
      meta.appendChild(time);
      content.appendChild(title);
      content.appendChild(meta);
      var badge = document.createElement('span');
      badge.className = 'app-status ' + state.className;
      badge.textContent = state.label;
      summary.appendChild(content);
      summary.appendChild(badge);
      var body = document.createElement('div');
      body.className = 'app-announcement-body app-markdown';
      body.innerHTML = item.content_rendered || '';
      details.appendChild(summary);
      details.appendChild(body);
      list.appendChild(details);
    });
  }

  function showImportant(items) {
    var dismissed = dismissedItems();
    var queue = items.filter(function (item) {
      return (item.level === 'important' || item.level === 'warning') && !dismissed[item.id];
    });
    function next() {
      var item = queue.shift();
      if (!item) return;
      var dialog = document.createElement('dialog');
      dialog.className = 'app-dialog';
      dialog.innerHTML = '<div class="app-dialog-header"><h2></h2><button class="app-icon-button" type="button" data-dialog-close aria-label="关闭"><i data-lucide="x"></i></button></div><div class="app-dialog-body app-markdown"></div><div class="app-dialog-actions"><label class="app-check"><input type="checkbox">不再弹出</label><button class="app-button app-button-primary" type="button" data-dialog-close>我已知晓</button></div>';
      dialog.querySelector('h2').textContent = item.title;
      dialog.querySelector('.app-dialog-body').innerHTML = item.content_rendered || '';
      dialog.addEventListener('close', function () {
        if (dialog.querySelector('input').checked) {
          dismissed[item.id] = Math.floor(Date.now() / 1000);
          saveDismissed(dismissed);
        }
        dialog.remove();
        next();
      });
      dialogHost.appendChild(dialog);
      window.NWPUOJApp.refreshIcons(dialog);
      dialog.showModal();
    }
    next();
  }

  fetch('/api/v2/announcements', { credentials: 'same-origin', cache: 'no-store' })
    .then(function (response) { if (!response.ok) throw new Error('request failed'); return response.json(); })
    .then(function (payload) {
      var items = payload && Array.isArray(payload.data) ? payload.data : [];
      renderAnnouncements(items);
      var live = new Set(items.map(function (item) { return String(item.id); }));
      var dismissed = dismissedItems();
      Object.keys(dismissed).forEach(function (id) { if (!live.has(String(id))) delete dismissed[id]; });
      saveDismissed(dismissed);
      showImportant(items);
    })
    .catch(function () {
      list.innerHTML = '<div class="app-notice app-notice-danger"><i data-lucide="cloud-off"></i><span>公告暂时无法加载，请稍后重试。</span></div>';
      window.NWPUOJApp.refreshIcons(list);
    });
})();
</script>

<script>
(function () {
  var root = document.querySelector('[data-home-banner]');
  var track = root && root.querySelector('[data-banner-track]');
  var controls = root && root.querySelector('[data-banner-controls]');
  if (!root || !track || !controls) return;
  var slides = [];
  var index = 0;
  var timer = null;
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function show(nextIndex) {
    index = (nextIndex + slides.length) % slides.length;
    slides.forEach(function (slide, slideIndex) {
      var active = slideIndex === index;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      if (slide.tagName === 'A') slide.tabIndex = active ? 0 : -1;
    });
  }
  function stop() { if (timer) clearInterval(timer); timer = null; }
  function start() { stop(); if (slides.length > 1 && !reduced && !document.hidden) timer = setInterval(function () { show(index + 1); }, 6500); }

  fetch('/api/v2/banners/active', { credentials: 'same-origin', cache: 'no-store' })
    .then(function (response) { if (!response.ok) throw new Error('request failed'); return response.json(); })
    .then(function (payload) {
      var banners = payload && Array.isArray(payload.data) ? payload.data : [];
      if (!banners.length) return;
      banners.forEach(function (banner, bannerIndex) {
        var slide = document.createElement(banner.link_url ? 'a' : 'div');
        slide.className = 'app-banner-slide';
        slide.setAttribute('role', 'group');
        slide.setAttribute('aria-label', (bannerIndex + 1) + ' / ' + banners.length);
        if (banner.link_url) slide.href = banner.link_url;
        var image = document.createElement('img');
        image.src = banner.image_url;
        image.alt = banner.title || '';
        image.loading = bannerIndex === 0 ? 'eager' : 'lazy';
        image.decoding = 'async';
        slide.appendChild(image);
        if (banner.title) {
          var caption = document.createElement('span');
          caption.className = 'app-banner-caption';
          caption.textContent = banner.title;
          slide.appendChild(caption);
        }
        track.appendChild(slide);
        slides.push(slide);
      });
      root.hidden = false;
      controls.hidden = slides.length < 2;
      show(0);
      start();
    })
    .catch(function () { root.hidden = true; });

  controls.querySelector('[data-banner-previous]').addEventListener('click', function () { show(index - 1); start(); });
  controls.querySelector('[data-banner-next]').addEventListener('click', function () { show(index + 1); start(); });
  root.addEventListener('mouseenter', stop);
  root.addEventListener('mouseleave', start);
  root.addEventListener('focusin', stop);
  root.addEventListener('focusout', start);
  document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); else start(); });
})();
</script>

<script>
(function () {
  var input = document.querySelector('[data-home-problem-search]');
  var list = document.getElementById('home-problem-suggestions');
  if (!input || !list) return;
  var controller = null;
  input.addEventListener('input', function () {
    var query = input.value.trim();
    list.replaceChildren();
    if (query.length < 2) return;
    if (controller) controller.abort();
    controller = new AbortController();
    fetch('/api/v2/search/problems/' + encodeURIComponent(query), { signal: controller.signal, cache: 'no-store' })
      .then(function (response) { return response.ok ? response.json() : null; })
      .then(function (payload) {
        var items = payload && payload.data ? payload.data : payload;
        if (!Array.isArray(items)) return;
        items.slice(0, 8).forEach(function (item) {
          var option = document.createElement('option');
          option.value = item.name || item.title || item.id || '';
          list.appendChild(option);
        });
      })
      .catch(function () {});
  });
})();
</script>

<% include app_footer %>
