<% include util %>
<%
if (typeof contest === 'undefined') contest = null;
if (!contest && typeof problemV2View !== 'undefined' && problemV2View && problemV2View.content) {
  Object.assign(problem, problemV2View.content);
}
if (contest) this.title = this.alpha(pid) + '. ' + syzoj.utils.removeTitleTag(problem.title) + ' - ' + contest.title + ' - 比赛';
else this.title = problem.title + ' - 题目';
const isVJudge = typeof problem.type === 'string' && problem.type.startsWith('vjudge:');
const problemRepository = { 'vjudge:uoj': 'uoj', 'vjudge:hdu': 'hdu', 'vjudge:poj': 'poj' }[problem.type] || 'main';
if (isVJudge) testcases = [];
const problemContext = {
  problem: problem,
  section: 'statement',
  testcases: testcases,
  discussionCount: typeof discussionCount !== 'undefined' ? discussionCount : 0,
  contest: contest,
  contestProblemId: contest ? pid : null
};
%>
<% include app_header %>
<% include problem_context %>

<div class="app-page app-problem-page">
  <% if (!contest && typeof problemV2View !== 'undefined' && problemV2View && problemV2View.isDraft && problem.is_public) { %><div class="app-notice app-notice-warning"><i data-lucide="file-clock"></i><span>当前显示刚保存的题面草稿；其他用户仍看到已发布版本。</span></div><% } %>
  <% if (problem.allowedEdit && !problem.is_public) { %><div class="app-notice app-notice-warning"><i data-lucide="eye-off"></i><span>此题目尚未公开，只有具备权限的用户可以访问。</span></div><% } %>

  <article class="app-problem-content app-problem-content-wide">
      <% if (!contest && typeof problemV2View !== 'undefined' && problemV2View) { %><span hidden data-problem-version="<%= problemV2View.versionId %>"></span><% } %>
      <% const hasStatement = !!(problem.description || problem.input_format || problem.output_format || problem.example || problem.limit_and_hint); %>
      <% if (hasStatement) { %>
        <section class="app-section app-problem-statement" data-reveal>
          <div class="app-markdown">
            <% const appSplitStatement = !!(problem.input_format || problem.output_format || problem.example || problem.limit_and_hint); %>
            <% if (!appSplitStatement) { %><%- problem.description %>
            <% } else { %>
              <% if (problem.description) { %><h2>题目描述</h2><div><%- problem.description %></div><% } %>
              <% if (problem.input_format) { %><h2>输入格式</h2><div><%- problem.input_format %></div><% } %>
              <% if (problem.output_format) { %><h2>输出格式</h2><div><%- problem.output_format %></div><% } %>
              <% if (problem.example) { %><h2>样例</h2><div><%- problem.example %></div><% } %>
              <% if (problem.limit_and_hint) { %><h2>数据范围与提示</h2><div><%- problem.limit_and_hint %></div><% } %>
            <% } %>
          </div>
        </section>
      <% } else { %>
        <div class="app-empty"><div class="app-empty-inner"><i data-lucide="file-question"></i><strong>题面尚未完善</strong><p>当前没有可显示的题面内容。</p></div></div>
      <% } %>
    <% if (!contest && problem.tags && problem.tags.length) { %><footer class="app-problem-tag-footer"><span>分类标签</span><div class="app-tag-list app-problem-tags"><% for (const tag of problem.tags) { %><a class="app-tag" href="<%= syzoj.utils.makeUrl(['problems', 'tag', tag.id], { repository: problemRepository }) %>"><%= tag.name %></a><% } %></div></footer><% } %>
  </article>
</div>

<% if (!contest && problem.allowedManage) { %>
  <dialog class="app-dialog" id="problem-delete-dialog">
    <div class="app-dialog-header"><h2>归档题目</h2><button class="app-icon-button" type="button" data-dialog-close aria-label="关闭"><i data-lucide="x"></i></button></div>
    <div class="app-dialog-body"><div class="app-notice app-notice-warning"><i data-lucide="archive"></i><span>题目将从公开题库中隐藏，已有提交、讨论、题解和测试数据会保留。</span></div></div>
    <div class="app-dialog-actions"><button class="app-button app-button-secondary" type="button" data-dialog-close>取消</button><button class="app-button app-button-danger" type="button" data-problem-v2-archive><i data-lucide="archive"></i>确认归档</button></div>
  </dialog>
<% } %>

<% include app_footer %>
