<% this.title = show_user.username + ' - 用户' %>
<%
const appCanViewEmailActivation = !!(user && (
  Number(user.id) === Number(show_user.id) ||
  (typeof appHasCapability === 'function' && appHasCapability('admin:user.manage')) ||
  (typeof isSiteOwner !== 'undefined' && isSiteOwner)
));
const appEmailActivated = Number(user && user.id) === Number(show_user.id)
  ? !!(user.is_email_verified || (syzoj.verifiedUserIds && syzoj.verifiedUserIds.has(Number(show_user.id))))
  : !!(syzoj.verifiedUserIds && syzoj.verifiedUserIds.has(Number(show_user.id)));
const appRatingTier = syzoj.utils.ratingTier(syzoj.utils.userRating(show_user));
const appSubmissionStats = [
  ['Accepted', statistics['Accepted'] || 0, 'app-verdict-accepted'], ['Wrong Answer', statistics['Wrong Answer'] || 0, 'app-verdict-wrong'],
  ['Runtime Error', statistics['Runtime Error'] || 0, 'app-verdict-runtime'], ['Time Limit', statistics['Time Limit Exceeded'] || 0, 'app-verdict-time'],
  ['Memory Limit', statistics['Memory Limit Exceeded'] || 0, 'app-verdict-memory'], ['Compile Error', statistics['Compile Error'] || 0, 'app-verdict-compile']
];
const appSubmissionTotal = appSubmissionStats.reduce((sum, item) => sum + item[1], 0);
const appRatingSeries = (typeof ratingHistories !== 'undefined' && Array.isArray(ratingHistories)) ? ratingHistories : [];
const appParticipatedContests = (typeof participatedContests !== 'undefined' && Array.isArray(participatedContests)) ? participatedContests : [];
const appRatingPeak = Math.max(0, ...appRatingSeries.map(item => Number(item.value)));
const appRatingSeriesJson = JSON.stringify(appRatingSeries.map(item => ({ name: item.contestName, contestId: item.contestId, value: item.value, before: item.before, delta: item.delta, rank: item.rank, participants: item.participants, time: Number(item.endedAt || (item.contestId == null ? show_user.register_time : 0)) }))).replace(/</g, '\\u003c');
%>
<% include app_header %>

<div class="app-page app-user-page">
  <header class="app-profile-header">
    <img class="app-profile-avatar" src="<%= syzoj.utils.avatar(show_user, 240) %>" alt="<%= show_user.username %> 的头像">
    <div class="app-profile-identity"><span class="app-kicker">USER <%= show_user.id %></span><h1><%- syzoj.utils.renderUsername(show_user) %></h1><p><%= syzoj.siteOwnerUserId === show_user.id ? '站长' : (show_user.is_admin ? '管理员' : '普通用户') %><% if (show_user.information) { %><span>·</span><span class="app-profile-signature"><%= show_user.information %></span><% } %></p></div>
    <div class="app-profile-actions"><% if (res.locals.user && res.locals.user.id === show_user.id) { %><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['user', show_user.id, 'edit']) %>"><i data-lucide="square-pen"></i>编辑资料</a><% } else if (res.locals.user) { %><% if (typeof followRelation !== 'undefined' && followRelation && followRelation.iFollow) { %><form method="post" data-user-follow-v2="unfollow" data-user-id="<%= show_user.id %>" data-confirm="确认取消关注？"><button class="app-button app-button-secondary" type="submit"><i data-lucide="<%= followRelation.mutual ? 'arrow-left-right' : 'check' %>"></i><%= followRelation.mutual ? '互相关注' : '已关注' %></button></form><% } else { %><form method="post" data-user-follow-v2="follow" data-user-id="<%= show_user.id %>"><button class="app-button app-button-primary" type="submit"><i data-lucide="user-plus"></i>关注</button></form><% } %><% if (res.locals.user.is_admin && show_user.id !== syzoj.siteOwnerUserId) { %><a class="app-button app-button-secondary" href="<%= syzoj.utils.makeUrl(['user', show_user.id, 'edit']) %>"><i data-lucide="settings"></i>管理资料</a><% } %><% } %><% if (res.locals.user && Number(res.locals.user.id) !== Number(show_user.id) && Number(show_user.id) !== Number(syzoj.siteOwnerUserId || 0) && (res.locals.user.is_admin || Number(res.locals.user.id) === Number(syzoj.siteOwnerUserId || 0))) { %><button class="app-button app-button-danger-outline" type="button" data-open-user-ban data-user-id="<%= show_user.id %>" data-username="<%= show_user.username %>"><i data-lucide="shield-ban"></i><span data-ban-button-label>封禁</span></button><% } %></div>
  </header>

  <section class="app-profile-stats" aria-label="用户统计"><div><span>通过题目</span><strong><%= show_user.ac_problems.length %></strong></div><div><span><a href="/help/rating">Rating</a></span><strong class="username-tier-<%= appRatingTier %>" title="<%= syzoj.utils.ratingTitle(show_user) %>"><%= show_user.rating %></strong></div><% if (typeof followStats !== 'undefined' && followStats) { %><a href="<%= syzoj.utils.makeUrl(['user', show_user.id, 'following']) %>"><span>关注</span><strong><%= followStats.following %></strong></a><a href="<%= syzoj.utils.makeUrl(['user', show_user.id, 'followers']) %>"><span>粉丝</span><strong><%= followStats.followers %></strong></a><% } %><div><span>注册时间</span><strong><%= syzoj.utils.formatDate(show_user.register_time).split(' ')[0] %></strong></div></section>

  <div class="app-profile-grid">
    <section class="app-profile-section"><div class="app-section-heading"><div><span class="app-kicker">OVERVIEW</span><h2>提交构成</h2></div><span class="app-section-count"><%= appSubmissionTotal %> 次</span></div><div class="app-distribution"><% for (const item of appSubmissionStats) { const appPercent = appSubmissionTotal ? Math.round(item[1] / appSubmissionTotal * 100) : 0; %><div><span><i class="<%= item[2] %>"></i><%= item[0] %></span><strong><%= item[1] %></strong><div><span class="<%= item[2] %>" style="width:<%= appPercent %>%"></span></div></div><% } %></div></section>

    <section class="app-profile-section"><div class="app-section-heading"><div><span class="app-kicker">PROFILE</span><h2>公开资料</h2></div></div><dl class="app-profile-data"><div><dt>用户名</dt><dd><%- syzoj.utils.renderUsername(show_user) %></dd></div><% if (show_user.emailVisible) { %><div><dt>Email</dt><dd><a href="mailto:<%= show_user.email %>"><%= show_user.email %></a></dd></div><% } %><% if (appCanViewEmailActivation) { %><div><dt>邮箱状态</dt><dd><span class="app-status <%= appEmailActivated ? 'app-status-accepted' : 'app-status-pending' %>"><%= appEmailActivated ? '已激活' : '未激活' %></span></dd></div><% } %><div><dt>身份</dt><dd><%= syzoj.siteOwnerUserId === show_user.id ? '站长' : (show_user.is_admin ? '管理员' : '普通用户') %></dd></div><div><dt>注册时间</dt><dd><%= syzoj.utils.formatDate(show_user.register_time) %></dd></div></dl></section>
  </div>

  <section class="app-profile-section app-rating-history-section">
    <div class="app-section-heading"><div><span class="app-kicker">RATING</span><h2>Rating 变化</h2></div><% if (appRatingSeries.length > 1) { %><div class="app-rating-chart-summary"><span>当前 <strong class="username-tier-<%= appRatingTier %>"><%= show_user.rating %></strong></span><span>最高 <strong class="username-tier-<%= syzoj.utils.ratingTier(appRatingPeak) %>"><%= appRatingPeak %></strong></span></div><% } %></div>
    <% if (appRatingSeries.length > 1) { %>
      <div class="app-rating-chart">
        <canvas id="user-rating-chart" tabindex="0" aria-label="Rating 变化折线图，使用左右方向键查看比赛" aria-describedby="user-rating-tooltip"></canvas>
        <div class="app-rating-chart-tooltip" id="user-rating-tooltip" role="status" aria-live="polite" aria-atomic="true" hidden>
          <strong><a data-rating-name></a></strong><time data-rating-date></time>
          <div class="app-rating-chart-result"><span>Rating <b data-rating-value></b></span><b data-rating-delta></b></div>
          <span data-rating-rank></span>
        </div>
      </div>
      <script id="user-rating-series" type="application/json"><%- appRatingSeriesJson %></script>
    <% } else { %>
      <p class="app-profile-placeholder">暂无 Rating 变化记录。</p>
    <% } %>
  </section>


  <section class="app-profile-section"><div class="app-section-heading"><div><span class="app-kicker">SOLVED</span><h2>通过的题目</h2></div><span class="app-section-count"><%= show_user.ac_problems.length %> 题</span></div><% if (show_user.ac_problems.length) { %><div class="app-solved-list"><% for (const problem of show_user.ac_problems) { %><a href="<%= syzoj.utils.makeUrl(['problem', problem.id]) %>"><%= problem.displayId %></a><% } %></div><% } else { %><p class="app-profile-placeholder">尚未通过公开题目。</p><% } %></section>

  <div class="app-profile-grid app-profile-activity">
    <section class="app-profile-section"><div class="app-section-heading"><div><span class="app-kicker">CONTESTS</span><h2>比赛记录</h2></div></div><% if (appParticipatedContests.length) { %><div class="app-contest-link-list"><% for (const contest of appParticipatedContests) { %><a href="<%= syzoj.utils.makeUrl(['contest', contest.id]) %>"><%= contest.title %></a><% } %></div><% } else { %><p class="app-profile-placeholder">暂无参赛记录。</p><% } %></section>
  </div>
</div>

<% if (res.locals.user && Number(res.locals.user.id) !== Number(show_user.id) && Number(show_user.id) !== Number(syzoj.siteOwnerUserId || 0) && (res.locals.user.is_admin || Number(res.locals.user.id) === Number(syzoj.siteOwnerUserId || 0))) { %>
<% include ban_editor %>
<% } %>

<script>
(function () {
  function operationKey() { return window.crypto && window.crypto.randomUUID ? window.crypto.randomUUID() : String(Date.now()) + Math.random(); }
document.querySelectorAll('form[data-user-follow-v2]').forEach(function (form) {
    form.addEventListener('submit', async function (event) {
      if (event.defaultPrevented) return;
      event.preventDefault();
      var action = form.dataset.userFollowV2;
      var button = form.querySelector('[type="submit"]');
      if (button) button.disabled = true;
      try {
        var response = await fetch('/api/v2/users/' + encodeURIComponent(form.dataset.userId) + '/follow', {
          method: action === 'unfollow' ? 'DELETE' : 'POST',
          credentials: 'same-origin',
          headers: { 'Idempotency-Key': operationKey() }
        });
        var body = null;
        try { body = await response.json(); } catch (error) {}
        if (!response.ok) throw new Error(body && body.error && body.error.message || (action === 'unfollow' ? '取消关注失败。' : '关注失败。'));
        window.location.reload();
      } catch (error) {
        if (window.NWPUOJApp) window.NWPUOJApp.showToast(error.message || '操作失败。', 'danger');
        else window.alert(error.message || '操作失败。');
        if (button) button.disabled = false;
      }
    });
  });
})();
</script>

<% if (appRatingSeries.length > 1) { %><script>
(function () {
  var canvas = document.getElementById('user-rating-chart');
  var source = document.getElementById('user-rating-series');
  var tooltip = document.getElementById('user-rating-tooltip');
  if (!canvas || !source || !tooltip) return;
  var points;
  try { points = JSON.parse(source.textContent); } catch (error) { canvas.hidden = true; return; }
  if (!Array.isArray(points) || points.length < 2) { canvas.hidden = true; return; }
  points = points.filter(function (point) { return Number.isFinite(Number(point.value)); });
  if (points.length < 2) { canvas.hidden = true; return; }
  var chart = canvas.parentElement;
  var activeIndex = null;
  var coordinates = [];
  var frame;
  var hideTimer = null;
  var pointerFocus = false;
  var bands = [
    { from: -Infinity, to: 1200, light: '#e4e4e4', dark: '#30343c' },
    { from: 1200, to: 1400, light: '#c2edb7', dark: '#284332' },
    { from: 1400, to: 1600, light: '#b5e6dc', dark: '#234749' },
    { from: 1600, to: 1900, light: '#becff0', dark: '#2c3c62' },
    { from: 1900, to: 2100, light: '#e8c0e9', dark: '#4b3154' },
    { from: 2100, to: 2400, light: '#f6d4a6', dark: '#54412b' },
    { from: 2400, to: 3000, light: '#efb2b2', dark: '#572e36' },
    { from: 3000, to: Infinity, light: '#de898f', dark: '#672c39' }
  ];
  var dateFormat = new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' });
  function dateLabel(time) { return time > 0 ? dateFormat.format(new Date(time * 1000)) : ''; }
  function color(name, fallback) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback; }
  function schedule() { window.cancelAnimationFrame(frame); frame = window.requestAnimationFrame(draw); }
  function cancelHide() { window.clearTimeout(hideTimer); hideTimer = null; }
  function hideTooltip() { cancelHide(); activeIndex = null; canvas.style.cursor = ''; schedule(); }
  function hideSoon() {
    if (hideTimer !== null || activeIndex === null) return;
    hideTimer = window.setTimeout(function () {
      hideTimer = null;
      if (!tooltip.matches(':hover') && !tooltip.contains(document.activeElement)) hideTooltip();
    }, 300);
  }
  function describe(point) {
    var delta = point.delta == null ? '' : (point.delta > 0 ? '+' : '') + point.delta;
    return point.name + '，' + dateLabel(point.time) + '，Rating ' + point.value + (delta ? '，变化 ' + delta : '') + (point.rank ? '，名次 ' + point.rank : '');
  }
  function updateTooltip(width) {
    if (activeIndex === null) {
      tooltip.hidden = true;
      canvas.setAttribute('aria-label', 'Rating 变化折线图，使用左右方向键查看比赛');
      return;
    }
    var point = points[activeIndex];
    var position = coordinates[activeIndex];
    var name = tooltip.querySelector('[data-rating-name]');
    name.textContent = point.name;
    var contestId = Number(point.contestId);
    if (Number.isSafeInteger(contestId) && contestId > 0) name.setAttribute('href', '/contest/' + contestId + '/details');
    else name.removeAttribute('href');
    tooltip.querySelector('[data-rating-date]').textContent = dateLabel(point.time);
    tooltip.querySelector('[data-rating-value]').textContent = point.value;
    var delta = tooltip.querySelector('[data-rating-delta]');
    delta.textContent = point.delta == null ? '' : (point.delta > 0 ? '+' : '') + point.delta;
    delta.className = point.delta > 0 ? 'app-rating-up' : point.delta < 0 ? 'app-rating-down' : '';
    var rank = tooltip.querySelector('[data-rating-rank]');
    rank.textContent = point.rank ? '名次 ' + point.rank + (point.participants ? ' / ' + point.participants : '') : '';
    rank.hidden = !point.rank;
    tooltip.hidden = false;
    var left = position.x + 14;
    if (left + tooltip.offsetWidth > width - 8) left = position.x - tooltip.offsetWidth - 14;
    tooltip.style.left = Math.max(8, Math.min(width - tooltip.offsetWidth - 8, left)) + 'px';
    tooltip.style.top = Math.max(4, Math.min(canvas.clientHeight - tooltip.offsetHeight - 8, position.y - tooltip.offsetHeight - 14)) + 'px';
    canvas.setAttribute('aria-label', describe(point) + '。使用左右方向键查看其他比赛');
  }
  function draw() {
    var ratio = window.devicePixelRatio || 1;
    var width = canvas.clientWidth;
    var height = canvas.clientHeight;
    if (!width || !height) return;
    canvas.width = Math.round(width * ratio);
    canvas.height = Math.round(height * ratio);
    var context = canvas.getContext('2d');
    context.setTransform(ratio, 0, 0, ratio, 0, 0);
    var dark = document.documentElement.getAttribute('data-theme') === 'dark';
    var padding = { top: 14, right: 14, bottom: 34, left: width < 500 ? 42 : 48 };
    var chartWidth = width - padding.left - padding.right;
    var chartHeight = height - padding.top - padding.bottom;
    var values = points.map(function (point) { return Number(point.value); });
    var low = Math.min.apply(Math, values);
    var high = Math.max.apply(Math, values);
    var minimum = low >= 0 ? Math.max(0, Math.floor((low - 150) / 100) * 100) : Math.floor((low - 150) / 100) * 100;
    var maximum = Math.max(1400, Math.ceil((high + 200) / 100) * 100);
    function y(value) { return padding.top + (maximum - value) / (maximum - minimum) * chartHeight; }
    bands.forEach(function (band) {
      var top = Math.min(maximum, band.to);
      var bottom = Math.max(minimum, band.from);
      if (top <= bottom) return;
      context.fillStyle = dark ? band.dark : band.light;
      context.fillRect(padding.left, y(top), chartWidth, y(bottom) - y(top));
    });
    var span = maximum - minimum;
    var step = [100, 200, 400, 500, 1000, 2000, 5000].find(function (value) { return span / value <= 6; }) || Math.ceil(span / 6000) * 1000;
    context.font = '11px system-ui, sans-serif';
    context.textBaseline = 'middle';
    context.lineWidth = 1;
    for (var tick = Math.ceil(minimum / step) * step; tick <= maximum; tick += step) {
      context.strokeStyle = dark ? 'rgba(255,255,255,0.10)' : 'rgba(255,255,255,0.55)';
      context.beginPath(); context.moveTo(padding.left, y(tick)); context.lineTo(width - padding.right, y(tick)); context.stroke();
      context.fillStyle = color('--app-text-secondary', '#5d6470');
      context.textAlign = 'right'; context.fillText(String(tick), padding.left - 9, y(tick));
    }
    var dates = points.map(function (point) { return Number(point.time); });
    var useDates = dates.every(function (time) { return Number.isFinite(time) && time > 0; });
    var firstTime = useDates ? Math.min.apply(Math, dates) : 0;
    var lastTime = useDates ? Math.max.apply(Math, dates) : points.length - 1;
    var timeSpan = Math.max(1, lastTime - firstTime);
    var inset = 9;
    function x(time) { return padding.left + inset + (chartWidth - inset * 2) * (time - firstTime) / timeSpan; }
    coordinates = points.map(function (point, index) {
      return { x: firstTime === lastTime ? padding.left + chartWidth / 2 : x(useDates ? dates[index] : index), y: y(Number(point.value)) };
    });
    var tickCount = firstTime === lastTime ? 1 : Math.min(5, Math.max(2, Math.floor(chartWidth / 125)));
    var previousLabel = '';
    for (var index = 0; index < tickCount; index += 1) {
      var tickTime = firstTime + timeSpan * (tickCount === 1 ? 0 : index / (tickCount - 1));
      var label = useDates ? dateLabel(tickTime) : String(Math.round(tickTime));
      if (label === previousLabel) continue;
      previousLabel = label;
      var tickX = tickCount === 1 ? padding.left + chartWidth / 2 : x(tickTime);
      context.strokeStyle = dark ? 'rgba(255,255,255,0.07)' : 'rgba(255,255,255,0.4)';
      context.beginPath(); context.moveTo(tickX, padding.top); context.lineTo(tickX, height - padding.bottom); context.stroke();
      context.fillStyle = color('--app-text-secondary', '#5d6470');
      context.textAlign = tickCount === 1 ? 'center' : index === 0 ? 'left' : index === tickCount - 1 ? 'right' : 'center';
      context.fillText(label, index === 0 && tickCount > 1 ? padding.left : index === tickCount - 1 && tickCount > 1 ? width - padding.right : tickX, height - 12);
    }
    context.strokeStyle = color('--app-line-strong', '#d5d9e0');
    context.strokeRect(padding.left, padding.top, chartWidth, chartHeight);
    if (activeIndex !== null) {
      context.strokeStyle = dark ? 'rgba(255,255,255,0.5)' : 'rgba(30,35,42,0.35)';
      context.setLineDash([3, 4]);
      context.beginPath(); context.moveTo(coordinates[activeIndex].x, padding.top); context.lineTo(coordinates[activeIndex].x, height - padding.bottom); context.stroke();
      context.setLineDash([]);
    }
    context.strokeStyle = dark ? '#f3c65c' : '#b88a18';
    context.lineWidth = 2;
    context.lineJoin = 'round';
    context.lineCap = 'round';
    context.beginPath();
    coordinates.forEach(function (point, index) { if (index) context.lineTo(point.x, point.y); else context.moveTo(point.x, point.y); });
    context.stroke();
    coordinates.forEach(function (point, index) {
      context.beginPath(); context.arc(point.x, point.y, activeIndex === index ? 5.5 : 3.5, 0, Math.PI * 2);
      context.fillStyle = activeIndex === index ? (dark ? '#fff3ca' : '#fff8df') : (dark ? '#f3c65c' : '#e4bd51'); context.fill();
      context.strokeStyle = dark ? '#17191d' : '#675221'; context.lineWidth = 1.5; context.stroke();
    });
    updateTooltip(width);
  }
  function selectPoint(event) {
    if (!coordinates.length) return;
    var rect = canvas.getBoundingClientRect();
    var localX = event.clientX - rect.left;
    var localY = event.clientY - rect.top;
    var nearest = 0;
    function distance(point) { return Math.pow(point.x - localX, 2) + Math.pow(point.y - localY, 2); }
    for (var index = 1; index < coordinates.length; index += 1) if (distance(coordinates[index]) < distance(coordinates[nearest])) nearest = index;
    var radius = event.pointerType === 'touch' ? 20 : 8;
    if (distance(coordinates[nearest]) > radius * radius) {
      canvas.style.cursor = '';
      if (event.type === 'pointerdown') hideTooltip();
      else hideSoon();
      return;
    }
    cancelHide();
    canvas.style.cursor = 'pointer';
    if (activeIndex !== nearest) { activeIndex = nearest; schedule(); }
  }
  canvas.addEventListener('pointermove', function (event) { if (event.pointerType !== 'touch') selectPoint(event); });
  canvas.addEventListener('pointerdown', function (event) {
    pointerFocus = true; canvas.focus({ preventScroll: true }); pointerFocus = false;
    selectPoint(event);
  });
  canvas.addEventListener('pointerleave', function (event) { if (event.pointerType !== 'touch') hideSoon(); });
  canvas.addEventListener('focus', function () {
    if (!pointerFocus && activeIndex === null) { cancelHide(); activeIndex = points.length - 1; schedule(); }
  });
  tooltip.addEventListener('pointerenter', cancelHide);
  tooltip.addEventListener('pointerleave', hideSoon);
  tooltip.addEventListener('focusin', cancelHide);
  chart.addEventListener('focusout', function (event) { if (!chart.contains(event.relatedTarget)) hideTooltip(); });
  document.addEventListener('pointerdown', function (event) { if (!chart.contains(event.target)) hideTooltip(); });
  chart.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') { event.preventDefault(); hideTooltip(); return; }
    if (event.target !== canvas) return;
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault();
    cancelHide();
    if (event.key === 'Home') activeIndex = 0;
    else if (event.key === 'End') activeIndex = points.length - 1;
    else activeIndex = Math.max(0, Math.min(points.length - 1, (activeIndex === null ? points.length - 1 : activeIndex) + (event.key === 'ArrowLeft' ? -1 : 1)));
    schedule();
  });
  if (window.ResizeObserver) new ResizeObserver(schedule).observe(chart);
  else window.addEventListener('resize', schedule);
  new MutationObserver(schedule).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
  draw();
})();
</script><% } %>

<% include app_footer %>
